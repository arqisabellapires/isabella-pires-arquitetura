---
import Base from '~/layouts/Base.astro';
import Cabecalho from '~/components/Cabecalho.astro';
import Rodape from '~/components/Rodape.astro';
import Migalhas from '~/components/Migalhas.astro';
import Botao from '~/components/Botao.astro';
import { servicos } from '~/lib/conteudo';

const pilares = [
  { titulo: 'Transparência e clareza', texto: 'Planejamento e custos sem surpresas.' },
  { titulo: 'Presença nacional', texto: 'Projetos em qualquer região do Brasil.' },
  { titulo: 'Atendimento humano', texto: 'Soluções sob medida para cada cliente.' },
];

const valores = [
  {
    titulo: 'Modernidade',
    texto: 'Priorizamos soluções inovadoras e atuais, integrando tecnologia e tendências para criar projetos funcionais e cheios de estilo.',
  },
  {
    titulo: 'Empatia',
    texto: 'Entendemos profundamente cada cliente, suas necessidades e preferências, para criar ambientes que refletem essência e proporcionam conforto.',
  },
  {
    titulo: 'Constância',
    texto: 'Agimos com disciplina e comprometimento, acompanhando cada detalhe do projeto para garantir qualidade e resultados consistentes.',
  },
];

const metodo = [
  {
    titulo: 'Briefing e levantamento',
    texto: 'Conversamos com você para entender estilo de vida, necessidades e expectativas, e realizamos medições e registro completo do espaço.',
  },
  {
    titulo: 'Desenvolvimento do conceito',
    texto: 'Criamos o conceito do projeto, definindo paleta de cores, materiais, mobiliário e disposição dos ambientes.',
  },
  {
    titulo: 'Detalhamentos técnicos e planejamento',
    texto: 'Elaboramos plantas, projetos de marcenaria, iluminação e revestimentos, além de lista de compras e fornecedores para garantir precisão.',
  },
  {
    titulo: 'Execução e ambientação',
    texto: 'Acompanhamos a implementação, garantindo que cada detalhe seja fiel ao projeto e que o resultado final seja funcional e harmonioso.',
  },
];
---

<Base
  titulo="Sobre nós"
  descricao="Conduzido por Isabella Cito Pires, o escritório transforma ideias em projetos de arquitetura e interiores que unem estética, funcionalidade e personalidade."
>
  <Cabecalho slot="cabecalho" />
  <Migalhas atual="Quem somos" />

  <section class="secao container">
    <p class="rotulo">Quem somos</p>
    <h1 class="historia__titulo">Nossa História</h1>

    <div class="historia__texto">
      <p>
        No nosso escritório, conduzido por <strong>Isabella Cito Pires</strong>, transformamos
        ideias em projetos arquitetônicos e de interiores que unem estética, funcionalidade
        e personalidade.
      </p>
      <p>
        Oferecemos também consultorias e ambientações personalizadas, garantindo soluções
        práticas e duradouras, sempre com atenção aos desejos e necessidades de cada cliente.
      </p>
    </div>

    <blockquote class="citacao">
      Arquitetura é a arte de transformar espaços em experiências inesquecíveis.
    </blockquote>

    <ul class="pilares">
      {
        pilares.map(({ titulo, texto }) => (
          <li class="pilar">
            <h2 class="pilar__titulo">{titulo}</h2>
            <p class="pilar__texto">{texto}</p>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="valores">
    <div class="container">
      <header class="secao__cabecalho">
        <p class="rotulo">Princípios que nos movem</p>
        <h2>Nossos valores</h2>
      </header>
      <ul class="valores__grade">
        {
          valores.map(({ titulo, texto }) => (
            <li class="valor">
              <h3 class="valor__titulo">{titulo}</h3>
              <p class="valor__texto">{texto}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="secao container">
    <header class="secao__cabecalho">
      <p class="rotulo">Nossos Serviços</p>
      <h2>Nós entregamos apenas o nosso melhor</h2>
    </header>
    <ul class="lista-servicos">
      {servicos.map(({ tituloCompleto, slug }) => (
        <li><a href={`/servicos#${slug}`}>{tituloCompleto}</a></li>
      ))}
    </ul>
  </section>

  <section class="secao container">
    <header class="secao__cabecalho">
      <p class="rotulo">Passo a passo</p>
      <h2>Nós temos um método simples,<br />rápido e efetivo</h2>
    </header>

    <ol class="metodo">
      {
        metodo.map(({ titulo, texto }, i) => (
          <li class="etapa">
            <p class="etapa__indice">{String(i + 1).padStart(2, '0')}</p>
            <div>
              <h3 class="etapa__titulo">{titulo}</h3>
              <p class="etapa__texto">{texto}</p>
            </div>
          </li>
        ))
      }
    </ol>

    <div class="acao">
      <Botao href="/contato" variante="solido">Quero agendar uma reunião</Botao>
    </div>

    <p class="instagram">Siga-nos no instagram!</p>
  </section>

  <Rodape slot="rodape" />
</Base>

<style>
  .historia__titulo { margin-block-start: var(--esp-2xs); max-width: 16ch; }
  .historia__texto {
    max-width: var(--largura-texto);
    margin-block-start: var(--esp-md);
    display: grid;
    gap: var(--esp-sm);
    font-size: var(--texto-md);
  }

  .citacao {
    margin-block: var(--esp-xl);
    padding-inline-start: var(--esp-md);
    border-inline-start: 2px solid var(--cor-acento);
    font-family: var(--fonte-titulo);
    font-size: var(--texto-lg);
    color: var(--cor-tinta);
    max-width: 32ch;
    text-wrap: balance;
  }

  .pilares {
    list-style: none; margin: 0; padding: 0;
    display: grid; gap: var(--esp-md);
  }
  .pilar { border-top: 1px solid var(--cor-borda); padding-block-start: var(--esp-sm); }
  .pilar__titulo { font-size: var(--texto-md); }
  .pilar__texto { font-size: var(--texto-sm); color: var(--cor-texto-suave); margin-block-start: var(--esp-3xs); }

  .valores { background-color: var(--cor-fundo-alt); padding-block: var(--secao-y); }
  .secao__cabecalho { margin-block-end: var(--esp-lg); }
  .secao__cabecalho h2 { margin-block-start: var(--esp-2xs); max-width: 20ch; }
  .valores__grade { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--esp-lg); }
  .valor__titulo { font-size: var(--texto-lg); margin-block-end: var(--esp-2xs); }
  .valor__texto { font-size: var(--texto-sm); color: var(--cor-texto-suave); }

  .metodo { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--esp-lg); }
  .etapa { display: grid; grid-template-columns: auto 1fr; gap: var(--esp-md); align-items: start; }
  .etapa__indice {
    font-family: var(--fonte-mono);
    font-size: var(--texto-sm);
    color: var(--cor-acento);
    padding-block-start: 0.35em;
  }
  .etapa__titulo { font-size: var(--texto-md); margin-block-end: var(--esp-3xs); }
  .etapa__texto { font-size: var(--texto-sm); color: var(--cor-texto-suave); max-width: 60ch; }

  .acao { margin-block-start: var(--esp-xl); }

  .lista-servicos { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--esp-sm); }
  .lista-servicos a {
    display: block;
    border-top: 1px solid var(--cor-borda);
    padding-block: var(--esp-sm);
    font-family: var(--fonte-titulo);
    font-size: var(--texto-lg);
    color: var(--cor-tinta);
    text-decoration: none;
    transition: color var(--transicao-rapida), padding-inline-start var(--transicao-media);
  }
  .lista-servicos a:hover { color: var(--cor-acento-escuro); padding-inline-start: var(--esp-xs); }

  .instagram {
    margin-block-start: var(--esp-xl);
    font-family: var(--fonte-titulo);
    font-size: var(--texto-lg);
    color: var(--cor-tinta);
  }

  @media (min-width: 48rem) {
    .pilares { grid-template-columns: repeat(3, 1fr); gap: var(--esp-lg); }
    .valores__grade { grid-template-columns: repeat(3, 1fr); }
    .metodo { grid-template-columns: repeat(2, 1fr); gap: var(--esp-xl); }
  }
</style>
