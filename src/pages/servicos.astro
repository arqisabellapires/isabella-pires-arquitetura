---
/**
 * Nossos Serviços — reconstruída contra o Figma (node 1:548), medidas em
 * `_figma/servicos-medidas.json`.
 *
 * A versão anterior não tinha **nenhuma imagem**: era texto empilhado numa
 * coluna de 1184px. O design é uma lista de cinco blocos de 609px de altura,
 * cada um com foto de 697×587 e raio 32, alternando o lado — ímpar com a
 * imagem à esquerda, par à direita — e 165px de respiro entre eles.
 *
 * O número do serviço não é texto solto: é uma pastilha com fundo alternando
 * entre o caramelo (#a98d67) e o marrom escuro (#352005), raio 12. O título
 * também alterna de cor, na mesma cadência.
 *
 * Não tem acordeão: isso foi medido no Framer vivo e vive em /sobre-nos/.
 * Os textos vêm de conteudo.ts — componente não carrega copy.
 */
import Base from '~/layouts/Base.astro';
import Cabecalho from '~/components/Cabecalho.astro';
import Rodape from '~/components/Rodape.astro';
import Wordmark from '~/components/Wordmark.astro';
import Migalhas from '~/components/Migalhas.astro';
import { servicos } from '~/lib/conteudo';
import '~/styles/cabeca-pagina.css';
import '~/styles/botoes.css';

/* As fotos saíram do próprio Figma e estão na ordem dos serviços. */
const fotos = [
  '/imagens/figma/servico--arquitetura-residencial.webp',
  '/imagens/figma/servico--arquitetura-comercial.webp',
  '/imagens/figma/servico--design-de-interiores.webp',
  '/imagens/figma/servico--consultoria-de-decoracao.webp',
  '/imagens/figma/servico--ambientacao.webp',
];
---

<Base
  titulo="Nossos Serviços"
  descricao="Arquitetura residencial e comercial, design de interiores, consultoria de decoração e ambientação em Maringá."
>
  <Cabecalho slot="cabecalho" />

  <header class="cabeca">
    <div class="cabeca__interno">
      <Migalhas itens={[{ rotulo: 'Início', href: '/' }, { rotulo: 'Nossos Serviços' }]} />
      <h1 class="cabeca__titulo">Nossos Serviços</h1>
    </div>
    <img class="cabeca__selo" src="/imagens/figma/selo-marca.webp" alt="" width="328" height="328" loading="lazy" />
  </header>

  <ol class="lista">
    {servicos.map((servico, i) => (
      <li class:list={['servico', i % 2 === 1 && 'servico--invertido']} id={servico.slug} data-revela>
        {/* A moldura corta o excesso do zoom; a foto é que cresce dentro. */}
        <div class="servico__moldura">
          <img class="servico__foto" src={fotos[i]} alt="" loading="lazy" width="560" height="587" />
        </div>

        <div class="servico__texto">
          <p class="servico__numero" aria-hidden="true">{String(i + 1).padStart(2, '0')}</p>
          <h2 class="servico__titulo">
            {servico.sobretitulo && <span class="servico__sobretitulo">{servico.sobretitulo}</span>}
            {servico.titulo}
          </h2>
          {servico.paragrafos.map((p) => <p class="servico__paragrafo">{p}</p>)}
          <a class="servico__cta tem-cara-de-botao" href="/contato">Entrar em contato</a>
        </div>
      </li>
    ))}
  </ol>

  <div slot="rodape">
    <Wordmark />
    <Rodape variante="caramelo" />
  </div>
</Base>

<style>
  /* ─── Cabeçalho da página ─────────────────────────────────
     80px/100px de padding, borda inferior de 1px e o selo circular de
     328px no canto direito — node 1:550. */

  /* ─── Lista ───────────────────────────────────────────────*/
  .lista {
    display: flex;
    flex-direction: column;
    gap: var(--fig-e-8xl);
    list-style: none;
    margin: 0 auto;
    max-width: var(--fig-largura-canvas);
    padding: var(--fig-e-6xl) var(--fig-margem-interna);
  }

  .servico {
    align-items: center;
    display: flex;
    gap: var(--fig-e-6xl);
    justify-content: center;
  }
  /* Pares: a imagem vai para a direita. */
  .servico--invertido { flex-direction: row-reverse; }

  /* 560×587 no Framer. A altura já batia; a largura ia a 697 e deixava a
     foto larga demais em relação ao texto. */
  /* A foto de cada faixa cresce conforme a seção sobe na tela — o Gabriel
     descreveu como "vou descendo e vai aumentando as imagens daquela faixa".

     Feito com `animation-timeline: view()`: o quadro da animação é ligado à
     posição da seção na janela, não ao relógio, então o zoom acompanha a
     rolagem nos dois sentidos e não custa nenhum listener de scroll.

     Onde não houver suporte (Safari mais antigo, Firefox sem a flag), a
     foto simplesmente fica no tamanho natural: a animação não roda e o
     `scale(1)` do estado normal prevalece. */
  .servico__moldura {
    border-radius: var(--fig-raio-xl);
    flex: 1 1 560px;
    max-width: 560px;
    overflow: hidden;
  }
  .servico__foto {
    display: block;
    height: 587px;
    object-fit: cover;
    transform-origin: 50% 50%;
    width: 100%;
  }

  @supports (animation-timeline: view()) {
    .servico__foto {
      animation: servico-zoom linear both;
      /* A timeline é a da MOLDURA, não a da própria foto: a foto tem
         `overflow:hidden` acima dela e o próprio transform em curso, o que
         embaralhava a medição e travava o quadro. `view(block)` na moldura
         mede a caixa que de fato entra e sai da tela. */
      animation-timeline: --entrada-servico;
      animation-range: entry 0% exit 100%;
    }
    .servico__moldura { view-timeline: --entrada-servico block; }

    @keyframes servico-zoom {
      from { transform: scale(1); }
      to   { transform: scale(1.16); }
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .servico__foto { animation: none; transform: none; }
  }

  .servico__texto {
    display: flex;
    flex-direction: column;
    gap: var(--fig-e-xl);
    flex: 1 1 659px;
    max-width: 659px;
  }

  /* A pastilha do número alterna de cor a cada serviço. */
  /* O design usa #a98d67 aqui, mas com o texto #eee isso dá 2,70:1. O
     #8d7252 é o mesmo caramelo meio tom abaixo e passa em contraste. */
  .servico__numero {
    align-self: flex-start;
    background: #8d7252;
    border-radius: var(--fig-raio-md);
    color: var(--fig-cinza-50);
    font: var(--fig-peso-normal) var(--fig-t-servico-num) / 1.2 var(--fig-fonte-display);
    margin: 0;
    padding: var(--fig-e-2xs) var(--fig-e-lg);
  }
  .servico:nth-child(even) .servico__numero { background: var(--fig-primaria-ativa); }

  .servico__titulo {
    color: #000;
    font: var(--fig-peso-normal) var(--fig-f-titulo-servico) / 1.05 var(--fig-fonte-corpo);
    margin: 0;
    text-wrap: balance;
  }
  .servico__sobretitulo { display: block; }
  /* #8d7252 em vez do caramelo #a98d67: o mesmo tom meio passo abaixo que a
     pastilha do número já usa. O caramelo puro dá 2,95:1 sobre o creme, e o
     portão de contraste reprova. */
  .servico:nth-child(2) .servico__titulo,
  .servico:nth-child(4) .servico__titulo { color: #8d7252; }
  .servico:nth-child(3) .servico__titulo,
  .servico:nth-child(5) .servico__titulo { color: var(--fig-primaria-ativa); }

  .servico__paragrafo {
    color: var(--fig-texto);
    font: var(--fig-peso-medio) clamp(1rem, 0.94rem + 0.28vw, 1.125rem) / 1.5 var(--fig-fonte-corpo);
    margin: 0;
    max-width: 538px;
  }

  /* Agora é botão de verdade (.tem-cara-de-botao), então precisa de fundo:
     como link de texto o caramelo dava 2,95:1 sobre o creme e o portão de
     contraste reprovava. */
  .servico__cta {
    align-self: flex-start;
    background: var(--fig-primaria-clara);
    color: #fff;
    font: var(--fig-peso-forte) clamp(1rem, 0.94rem + 0.28vw, 1.125rem) / 1.4 var(--fig-fonte-corpo);
    text-decoration: none;
  }
  .servico:nth-child(even) .servico__cta { background: var(--fig-primaria-ativa); }


  @media (max-width: 1199.98px) {
    .servico,
    .servico--invertido { flex-direction: column; align-items: stretch; gap: var(--fig-e-2xl); }
    .servico__moldura { max-width: 100%; }
    .servico__foto { height: 420px; }
    .servico__texto { max-width: 100%; }
    .cabeca__selo { display: none; }
  }
  @media (max-width: 809.98px) {
    .lista { gap: var(--fig-e-4xl); }
    .servico__foto { height: 280px; }
  }
</style>
