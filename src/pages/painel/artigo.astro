---
/**
 * Editor de artigo, na forma do CMS do Framer: campos em linhas rotuladas,
 * tema escuro, e o corpo num editor rico de verdade.
 *
 * O editor rico é `contenteditable` com execCommand, sem biblioteca. É de
 * propósito: o corpo do artigo é gravado e servido como HTML cru, e a
 * `src/styles/artigo.css` foi medida contra a captura do Framer para essas
 * tags. Uma biblioteca (TipTap e afins) traria classes próprias e um bundle
 * grande, e quebraria esse acordo.
 */
import Base from '~/layouts/Base.astro';
import { categorias } from '~/lib/site';
import '~/styles/painel.css';
---

<Base titulo="Artigo" descricao="Escrever ou editar um artigo." noindex>
  <div class="pnl">
    <header class="pnl-topo">
      <a class="pnl-btn pnl-btn--icone" href="/painel" aria-label="Voltar para a lista">✕</a>
      <p class="pnl-topo__nome" id="cabecalho">Novo artigo</p>
      <div class="pnl-topo__acoes">
        <p class="pnl-estado" id="estado" role="status"></p>
        <button class="pnl-btn pnl-btn--azul" type="submit" form="form" id="salvar">Publicar</button>
      </div>
    </header>

    <form class="pnl-form" id="form">
      <div class="pnl-linha">
        <label class="pnl-linha__rotulo" for="c-titulo">Título</label>
        <div>
          <input class="pnl-campo" id="c-titulo" name="titulo" maxlength="120" required />
        </div>
      </div>

      <div class="pnl-linha">
        <label class="pnl-linha__rotulo" for="c-publicado">Status</label>
        <div>
          <select class="pnl-campo" id="c-publicado" name="publicado">
            <option value="sim">Live — aparece no site</option>
            <option value="nao">Rascunho — só você vê</option>
          </select>
        </div>
      </div>

      <div class="pnl-linha">
        <label class="pnl-linha__rotulo" for="c-slug">Slug</label>
        <div>
          <input class="pnl-campo" id="c-slug" name="slug" pattern="[a-z0-9]+(-[a-z0-9]+)*" required />
          <p class="pnl-dica" id="previa-url"></p>
        </div>
      </div>

      <div class="pnl-linha">
        <label class="pnl-linha__rotulo" for="c-autor">Nome</label>
        <div><input class="pnl-campo" id="c-autor" name="autor" value="Isabella Pires" required /></div>
      </div>

      <div class="pnl-linha">
        <label class="pnl-linha__rotulo" for="c-categoria">Categoria</label>
        <div>
          <select class="pnl-campo" id="c-categoria" name="categoria">
            {categorias.map((c) => <option value={c}>{c}</option>)}
          </select>
        </div>
      </div>

      <div class="pnl-linha">
        <label class="pnl-linha__rotulo" for="c-data">Data</label>
        <div><input class="pnl-campo" id="c-data" type="date" name="publicadoEm" required /></div>
      </div>

      <div class="pnl-linha">
        <label class="pnl-linha__rotulo" for="c-capa">Capa</label>
        <div>
          <div class="pnl-capa">
            <img class="pnl-capa__previa" id="previa" alt="" hidden />
            <div style="flex:1">
              <input class="pnl-campo" id="c-capa" type="file" name="capa" accept="image/jpeg,image/png,image/webp" />
              <p class="pnl-dica">JPG, PNG ou WebP. Ao editar, deixe vazio para manter a atual.</p>
            </div>
          </div>
        </div>
      </div>

      <div class="pnl-linha">
        <label class="pnl-linha__rotulo" for="c-capa-alt">Descrição da capa</label>
        <div>
          <input class="pnl-campo" id="c-capa-alt" name="capaAlt" required />
          <p class="pnl-dica">O que a foto mostra, para quem não enxerga. Obrigatório.</p>
        </div>
      </div>

      <div class="pnl-linha">
        <label class="pnl-linha__rotulo" for="c-tempo">Tempo de leitura</label>
        <div>
          <div class="pnl-duplo">
            <input class="pnl-campo" id="c-tempo" type="number" name="tempoLeitura" min="1" max="120" />
            <span class="pnl-auto">
              <input type="checkbox" id="c-tempo-auto" checked />
              <label for="c-tempo-auto">calcular sozinho</label>
            </span>
          </div>
          <p class="pnl-dica">Em minutos. Com "calcular sozinho" marcado, sai do tamanho do texto.</p>
        </div>
      </div>

      <div class="pnl-linha">
        <label class="pnl-linha__rotulo" for="c-resumo">Resumo</label>
        <div>
          <textarea class="pnl-campo" id="c-resumo" name="resumo" maxlength="300" rows="3" required></textarea>
          <p class="pnl-dica">Aparece na lista do blog, embaixo do título.</p>
        </div>
      </div>

      <div class="pnl-linha">
        <span class="pnl-linha__rotulo">Conteúdo</span>
        <div>
          <div class="ed">
            <div class="ed__barra" role="toolbar" aria-label="Formatação">
              <select class="ed__bloco" id="ed-bloco" aria-label="Tipo de bloco">
                <option value="p">Parágrafo</option>
                <option value="h2">Título</option>
                <option value="h3">Subtítulo</option>
                <option value="blockquote">Citação</option>
              </select>
              <span class="ed__risco"></span>
              <button class="ed__b" type="button" data-cmd="bold" title="Negrito"><b>B</b></button>
              <button class="ed__b" type="button" data-cmd="italic" title="Itálico"><i>I</i></button>
              <button class="ed__b" type="button" data-cmd="insertUnorderedList" title="Lista">• —</button>
              <button class="ed__b" type="button" data-cmd="insertOrderedList" title="Lista numerada">1. —</button>
              <span class="ed__risco"></span>
              <button class="ed__b" type="button" id="ed-link" title="Link">🔗</button>
              <button class="ed__b" type="button" id="ed-imagem" title="Imagem">🖼</button>
              <span class="ed__risco"></span>
              <button class="ed__b" type="button" id="ed-html" title="Ver o HTML">&lt;/&gt;</button>
            </div>
            <div class="ed__area" id="ed-area" contenteditable="true" role="textbox" aria-multiline="true" aria-label="Conteúdo do artigo"></div>
            <textarea class="ed__cru" id="ed-cru" hidden aria-label="HTML do artigo"></textarea>
          </div>
          <input type="file" id="ed-arquivo" accept="image/jpeg,image/png,image/webp" hidden />
          <p class="pnl-dica" id="ed-recado"></p>
        </div>
      </div>

      <div class="pnl-linha">
        <label class="pnl-linha__rotulo" for="c-seo-desc">Meta Description</label>
        <div>
          <textarea class="pnl-campo" id="c-seo-desc" name="seoDescricao" maxlength="160" rows="2"></textarea>
          <p class="pnl-dica"><span id="conta-seo">0</span>/160 — o texto que aparece no Google.</p>
        </div>
      </div>

      <div class="pnl-linha">
        <label class="pnl-linha__rotulo" for="c-tags">Keywords</label>
        <div>
          <input class="pnl-campo" id="c-tags" name="tags" />
          <p class="pnl-dica">Separadas por vírgula.</p>
        </div>
      </div>

      <div class="pnl-rodape">
        <button class="pnl-btn pnl-btn--azul" type="submit">Publicar</button>
        <a class="pnl-btn" href="/painel">Cancelar</a>
        <button class="pnl-btn pnl-btn--perigo" type="button" id="apagar" hidden>Apagar artigo</button>
      </div>
    </form>
  </div>
</Base>

<style is:global>
  /* O editor rico. `is:global` porque a área de escrita recebe HTML por
     innerHTML, e o CSS escopado do Astro não alcança o que entra assim. */
  .ed {
    background: var(--p-fundo-campo);
    border: 1px solid var(--p-borda);
    border-radius: var(--p-raio);
    overflow: hidden;
  }
  .ed__barra {
    align-items: center;
    background: var(--p-fundo-barra);
    border-bottom: 1px solid var(--p-borda);
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    padding: 6px 8px;
  }
  .ed__bloco {
    background: var(--p-fundo-campo);
    border: 1px solid var(--p-borda);
    border-radius: 5px;
    color: var(--p-texto);
    font: 600 12px/1 var(--p-fonte);
    padding: 6px 8px;
  }
  .ed__b {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 5px;
    color: var(--p-texto);
    cursor: pointer;
    font: 600 13px/1 var(--p-fonte);
    min-width: 30px;
    padding: 6px 8px;
  }
  .ed__b:hover { background: var(--p-fundo-hover); border-color: var(--p-borda); }
  .ed__b[aria-pressed='true'] { background: var(--p-fundo-hover); border-color: var(--p-borda-forte); }
  .ed__risco { background: var(--p-borda); height: 18px; margin: 0 4px; width: 1px; }

  .ed__area {
    color: var(--p-texto);
    font: 500 15px/1.7 var(--p-fonte);
    max-height: 60vh;
    min-height: 320px;
    overflow-y: auto;
    padding: 16px;
  }
  .ed__area:focus-visible { outline: none; }
  .ed__area:empty::before {
    color: var(--p-texto-fraco);
    content: 'Escreva o artigo aqui…';
  }
  .ed__area > :first-child { margin-top: 0; }
  /* O corpo entra por innerHTML e herda a artigo.css do site, que é clara:
     os títulos saíam marrom-escuro sobre o fundo preto, ilegíveis. A cor e a
     família são forçadas aqui — só dentro do editor. */
  .ed__area h1, .ed__area h2, .ed__area h3, .ed__area h4,
  .ed__area h5, .ed__area h6 {
    color: var(--p-texto);
    font-family: var(--p-fonte);
  }
  .ed__area h2 { font-size: 21px; font-weight: 700; margin: 26px 0 10px; }
  .ed__area h3 { font-size: 17px; font-weight: 700; margin: 22px 0 8px; }
  .ed__area h4 { font-size: 15px; font-weight: 700; margin: 18px 0 8px; }
  .ed__area strong, .ed__area b { color: var(--p-texto); }
  .ed__area p  { margin: 0 0 14px; }
  .ed__area ul, .ed__area ol { margin: 0 0 14px; padding-left: 22px; }
  .ed__area li { margin-bottom: 6px; }
  .ed__area a { color: var(--p-azul); }
  .ed__area img { border-radius: 6px; display: block; height: auto; margin: 16px 0; max-width: 100%; }
  .ed__area blockquote {
    border-left: 3px solid var(--p-borda-forte);
    color: var(--p-texto-meta);
    margin: 0 0 14px;
    padding-left: 14px;
  }
  .ed__cru {
    background: var(--p-fundo-campo);
    border: 0;
    color: var(--p-texto);
    display: block;
    font: 500 13px/1.6 ui-monospace, 'Fragment Mono', monospace;
    min-height: 320px;
    padding: 16px;
    resize: vertical;
    width: 100%;
  }
  .ed__cru:focus-visible { outline: none; }
  .ed__cru[hidden] { display: none; }
</style>

<script>
  import { supabase, exigeSessao } from '~/lib/supabase-navegador';

  const form = document.getElementById('form') as HTMLFormElement;
  const estado = document.getElementById('estado')!;
  const previa = document.getElementById('previa') as HTMLImageElement;
  const salvar = document.getElementById('salvar') as HTMLButtonElement;
  const area = document.getElementById('ed-area') as HTMLElement;
  const cru = document.getElementById('ed-cru') as HTMLTextAreaElement;
  const recado = document.getElementById('ed-recado')!;
  const campoSlug = form.slug as HTMLInputElement;
  const campoTempo = form.tempoLeitura as HTMLInputElement;
  const tempoAuto = document.getElementById('c-tempo-auto') as HTMLInputElement;

  const sessao = await exigeSessao();
  if (sessao) {
    const slugEditado = new URLSearchParams(location.search).get('slug');

    /** Título → slug: sem acento, sem pontuação, palavras ligadas por hífen. */
    const aSlug = (texto: string) =>
      texto.normalize('NFD').replace(/[̀-ͯ]/g, '')
        .toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');

    /** Minutos de leitura a 200 palavras/min, do texto sem as tags. */
    const minutos = (html: string) => {
      const palavras = html.replace(/<[^>]+>/g, ' ').replace(/\s+/g, ' ')
        .trim().split(' ').filter(Boolean).length;
      return Math.max(1, Math.round(palavras / 200));
    };

    // ── editor rico ────────────────────────────────────────────
    const bloco = document.getElementById('ed-bloco') as HTMLSelectElement;

    /** Estado dos botões, para o negrito acender quando o cursor está nele. */
    function sincroniza() {
      document.querySelectorAll<HTMLButtonElement>('.ed__b[data-cmd]').forEach((b) => {
        try {
          b.setAttribute('aria-pressed', String(document.queryCommandState(b.dataset.cmd!)));
        } catch { /* execCommand some em alguns navegadores; sem estado, tudo bem */ }
      });
    }
    area.addEventListener('keyup', sincroniza);
    area.addEventListener('mouseup', sincroniza);

    document.querySelectorAll<HTMLButtonElement>('.ed__b[data-cmd]').forEach((b) => {
      b.addEventListener('mousedown', (e) => e.preventDefault()); // não perde o cursor
      b.addEventListener('click', () => {
        document.execCommand(b.dataset.cmd!, false);
        area.focus();
        sincroniza();
      });
    });

    bloco.addEventListener('change', () => {
      document.execCommand('formatBlock', false, `<${bloco.value}>`);
      area.focus();
    });

    document.getElementById('ed-link')!.addEventListener('mousedown', (e) => e.preventDefault());
    document.getElementById('ed-link')!.addEventListener('click', () => {
      const url = prompt('Endereço do link:');
      if (url) document.execCommand('createLink', false, url);
      area.focus();
    });

    // Imagem no meio do texto: envia para o mesmo bucket das capas.
    const arquivoImagem = document.getElementById('ed-arquivo') as HTMLInputElement;
    document.getElementById('ed-imagem')!.addEventListener('mousedown', (e) => e.preventDefault());
    document.getElementById('ed-imagem')!.addEventListener('click', () => arquivoImagem.click());

    arquivoImagem.addEventListener('change', async () => {
      const arq = arquivoImagem.files?.[0];
      if (!arq) return;
      recado.textContent = 'Enviando a imagem…';
      try {
        const nome = `corpo/${Date.now()}-${aSlug(arq.name.replace(/\.[^.]+$/, ''))}.${arq.name.split('.').pop()}`;
        const { error } = await supabase.storage.from('artigos')
          .upload(nome, arq, { contentType: arq.type, upsert: true });
        if (error) throw new Error(error.message);
        const url = supabase.storage.from('artigos').getPublicUrl(nome).data.publicUrl;
        const alt = prompt('O que esta imagem mostra? (para quem não enxerga)') ?? '';
        area.focus();
        document.execCommand('insertHTML', false,
          `<img src="${url}" alt="${alt.replace(/"/g, '&quot;')}" />`);
        recado.textContent = '';
      } catch (e) {
        recado.textContent = `Não consegui enviar: ${(e as Error).message}`;
      }
      arquivoImagem.value = '';
    });

    // Alterna entre escrever e ver o HTML cru.
    document.getElementById('ed-html')!.addEventListener('click', () => {
      if (cru.hidden) {
        cru.value = area.innerHTML;
        cru.hidden = false;
        area.hidden = true;
      } else {
        area.innerHTML = cru.value;
        cru.hidden = true;
        area.hidden = false;
      }
    });

    // Colar: só o texto, senão vem a folha de estilo inteira do Word junto.
    area.addEventListener('paste', (e) => {
      e.preventDefault();
      const texto = e.clipboardData?.getData('text/plain') ?? '';
      document.execCommand('insertText', false, texto);
    });

    /** O HTML do corpo, venha da área de escrita ou do modo cru. */
    const corpoAtual = () => (cru.hidden ? area.innerHTML : cru.value);

    // ── tempo de leitura ───────────────────────────────────────
    function recalcula() {
      if (tempoAuto.checked) campoTempo.value = String(minutos(corpoAtual()));
    }
    area.addEventListener('input', recalcula);
    cru.addEventListener('input', recalcula);
    tempoAuto.addEventListener('change', () => {
      campoTempo.readOnly = tempoAuto.checked;
      recalcula();
    });
    campoTempo.readOnly = true;

    // ── slug ───────────────────────────────────────────────────
    const previaUrl = document.getElementById('previa-url')!;
    const mostraUrl = () => {
      previaUrl.textContent = campoSlug.value
        ? `www.isabellapiresarquitetura.com.br/artigos/${campoSlug.value}`
        : '';
    };
    let slugNaMao = false;
    campoSlug.addEventListener('input', () => { slugNaMao = true; mostraUrl(); });
    form.titulo.addEventListener('input', () => {
      // Ao editar, o slug não muda sozinho: mexer nele quebra o link publicado.
      if (!slugEditado && !slugNaMao) { campoSlug.value = aSlug(form.titulo.value); mostraUrl(); }
    });

    const contaSeo = document.getElementById('conta-seo')!;
    const seo = form.seoDescricao as HTMLTextAreaElement;
    seo.addEventListener('input', () => { contaSeo.textContent = String(seo.value.length); });

    // ── carrega o artigo existente ─────────────────────────────
    let capaAtual: { url: string; largura: number | null; altura: number | null } | null = null;
    if (slugEditado) {
      document.getElementById('cabecalho')!.textContent = 'Editar artigo';
      const { data } = await supabase.from('artigos').select('*').eq('slug', slugEditado).single();
      if (data) {
        form.titulo.value = data.titulo;
        campoSlug.value = data.slug;
        campoSlug.readOnly = true;
        form.autor.value = data.autor ?? 'Isabella Pires';
        form.resumo.value = data.resumo;
        form.categoria.value = data.categoria;
        form.publicadoEm.value = String(data.publicado_em).slice(0, 10);
        form.capaAlt.value = data.capa_alt;
        area.innerHTML = data.corpo ?? '';
        (form.publicado as HTMLSelectElement).value = data.publicado ? 'sim' : 'nao';
        seo.value = data.seo_descricao ?? '';
        contaSeo.textContent = String(seo.value.length);
        form.tags.value = (data.tags ?? []).join(', ');
        if (data.tempo_leitura != null) {
          campoTempo.value = String(data.tempo_leitura);
          // Já tem número gravado: respeita o que está lá em vez de recalcular.
          tempoAuto.checked = false;
          campoTempo.readOnly = false;
        } else {
          recalcula();
        }
        capaAtual = { url: data.capa, largura: data.capa_largura, altura: data.capa_altura };
        previa.src = data.capa;
        previa.hidden = false;
        mostraUrl();

        const apagar = document.getElementById('apagar') as HTMLButtonElement;
        apagar.hidden = false;
        apagar.addEventListener('click', async () => {
          if (!confirm(`Apagar "${data.titulo}"? Isso não tem volta.`)) return;
          apagar.disabled = true;
          const { error } = await supabase.from('artigos').delete().eq('slug', slugEditado);
          if (error) {
            estado.textContent = `Não consegui apagar: ${error.message}`;
            apagar.disabled = false;
            return;
          }
          // O artigo saiu do banco, mas a página dele continua no ar até o
          // próximo build — por isso o rebuild aqui também.
          await fetch('/api/publica', {
            method: 'POST',
            headers: {
              'content-type': 'application/json',
              authorization: `Bearer ${sessao.access_token}`,
            },
          }).catch(() => {});
          window.location.href = '/painel?publicado=sim';
        });
      }
    } else {
      form.publicadoEm.value = new Date().toISOString().slice(0, 10);
    }

    // ── prévia da capa escolhida ───────────────────────────────
    form.capa.addEventListener('change', () => {
      const arquivo = (form.capa as HTMLInputElement).files?.[0];
      if (arquivo) { previa.src = URL.createObjectURL(arquivo); previa.hidden = false; }
    });

    form.addEventListener('submit', async (evento) => {
      evento.preventDefault();
      salvar.disabled = true;
      estado.textContent = 'Salvando…';

      try {
        const titulo = String(form.titulo.value).trim();
        const slug = slugEditado ?? aSlug(campoSlug.value || titulo);
        const arquivo = (form.capa as HTMLInputElement).files?.[0];

        let capa = capaAtual?.url;
        let largura = capaAtual?.largura ?? null;
        let altura = capaAtual?.altura ?? null;

        if (arquivo) {
          // O <Image> exige largura e altura de imagem remota; medimos aqui,
          // no navegador, antes de enviar.
          const medida = await new Promise<{ w: number; h: number }>((ok, falha) => {
            const img = new Image();
            img.onload = () => ok({ w: img.naturalWidth, h: img.naturalHeight });
            img.onerror = () => falha(new Error('não consegui ler a imagem'));
            img.src = URL.createObjectURL(arquivo);
          });
          largura = medida.w;
          altura = medida.h;

          const nome = `${slug}-${Date.now()}.${arquivo.name.split('.').pop()}`;
          const { error: erroUp } = await supabase.storage.from('artigos')
            .upload(`capas/${nome}`, arquivo, { contentType: arquivo.type, upsert: true });
          if (erroUp) throw new Error(`envio da capa: ${erroUp.message}`);
          capa = supabase.storage.from('artigos').getPublicUrl(`capas/${nome}`).data.publicUrl;
        }

        if (!capa) throw new Error('escolha uma imagem de capa.');

        const corpo = corpoAtual();
        const etiquetas = String(form.tags.value)
          .split(',').map((t) => t.trim()).filter(Boolean);

        const linha = {
          slug,
          titulo,
          resumo: String(form.resumo.value).trim(),
          capa,
          capa_largura: largura,
          capa_altura: altura,
          capa_alt: String(form.capaAlt.value).trim(),
          corpo,
          autor: String(form.autor.value).trim() || 'Isabella Pires',
          categoria: String(form.categoria.value),
          tempo_leitura: Number(campoTempo.value) || minutos(corpo),
          seo_descricao: String(seo.value).trim() || null,
          tags: etiquetas,
          // "2026-05-12" vira meia-noite UTC, não meia-noite local: assim o
          // dia gravado é o mesmo que ela digitou, em qualquer fuso.
          publicado_em: new Date(`${String(form.publicadoEm.value)}T12:00:00Z`).toISOString(),
          atualizado_em: new Date().toISOString(),
          publicado: (form.publicado as HTMLSelectElement).value === 'sim',
          criado_por: sessao.user.id,
        };

        const { error } = await supabase.from('artigos').upsert(linha, { onConflict: 'slug' });
        if (error) throw new Error(error.message);

        // Rascunho não precisa de build: ele não aparece no site.
        if (linha.publicado) {
          estado.textContent = 'Salvo. Atualizando o site…';
          await fetch('/api/publica', {
            method: 'POST',
            headers: {
              'content-type': 'application/json',
              authorization: `Bearer ${sessao.access_token}`,
            },
          }).catch(() => {});
        }

        window.location.href = '/painel?publicado=sim';
      } catch (e) {
        estado.textContent = `Não deu certo: ${(e as Error).message}`;
        salvar.disabled = false;
      }
    });
  }
</script>
