---
/**
 * Formulário de contato. Os 5 campos e os rótulos são os medidos em
 * _capturas/contato/medidas.desktop.json (rótulos 14px/500 Inter); as opções
 * do select saem dos <option> da própria captura, não de invenção.
 *
 * Funciona sem JavaScript: é um <form method="post"> de verdade, e a API já
 * responde 303 com ?envio= quando o pedido não é fetch. O script abaixo só
 * melhora a experiência de quem tem JS — se ele falhar, o formulário continua
 * enviando.
 *
 * Os 11 campos-isca vêm de src/lib/antispam.ts, que reaproveita os mesmos
 * nomes que o Framer já usava.
 */
import { CAMPOS_ISCA } from '~/lib/antispam';
import '~/styles/botoes.css';

const servicos = [
  'Arquitetura Residencial',
  'Arquitetura Comercial',
  'Design de Interiores',
  'Consultoria de Decoração',
  'Ambientação',
];
---

<form class="form" method="post" action="/api/contato" novalidate>
  <div class="form__campo">
    <label for="nome">Qual é o seu nome?</label>
    <input id="nome" name="nome" type="text" required autocomplete="name" maxlength="120" />
  </div>

  <div class="form__campo">
    <label for="email">E-mail</label>
    <input id="email" name="email" type="email" required autocomplete="email" maxlength="254" />
  </div>

  <div class="form__campo">
    <label for="telefone">Telefone</label>
    <input id="telefone" name="telefone" type="tel" autocomplete="tel" maxlength="40" />
  </div>

  <div class="form__campo">
    <label for="servico" id="servico-rotulo">Qual serviço você procura?</label>

    {/* O <select> continua aqui, escondido: é ele que o formulário envia e
        é ele que aparece se o JavaScript falhar. A lista bonita por cima é
        montada no script — a nativa não aceita raio, cor nem hover. */}
    <select id="servico" name="servico" class="form__nativo">
      <option value="" disabled selected>Selecione</option>
      {servicos.map((s) => <option value={s}>{s}</option>)}
    </select>

    <div class="escolha" id="escolha" hidden>
      <button
        type="button"
        class="escolha__gatilho"
        id="escolha-gatilho"
        aria-haspopup="listbox"
        aria-expanded="false"
        aria-labelledby="servico-rotulo escolha-gatilho"
      >
        <span class="escolha__valor" id="escolha-valor">Selecione</span>
        <svg class="escolha__seta" viewBox="0 0 24 24" aria-hidden="true">
          <path d="m6 9 6 6 6-6" fill="none" stroke="currentColor" stroke-width="2"
                stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </button>

      <ul class="escolha__lista" id="escolha-lista" role="listbox" tabindex="-1" hidden>
        {servicos.map((s) => (
          <li class="escolha__item" role="option" data-valor={s} tabindex="-1">{s}</li>
        ))}
      </ul>
    </div>
  </div>

  <div class="form__campo">
    <label for="mensagem">Mensagem</label>
    <textarea id="mensagem" name="mensagem" required rows="5" maxlength="5000"></textarea>
  </div>

  {/* Iscas: fora da vista e fora do foco por teclado, nunca display:none em
      campo que um leitor de tela precise ignorar — aria-hidden + tabindex. */}
  <div class="form__iscas" aria-hidden="true">
    {CAMPOS_ISCA.map((c) => (
      <input type="text" name={c} tabindex="-1" autocomplete="off" />
    ))}
  </div>

  <p class="form__estado" role="status" aria-live="polite" data-estado></p>

  <button type="submit" class="form__enviar tem-cara-de-botao">Receber proposta personalizada</button>
</form>

<script>
  /*
    Progressive enhancement. Sem este script o form envia por POST normal e a
    API devolve 303 com ?envio= — testado. Com ele, o visitante não perde a
    página.
  */
  const form = document.querySelector<HTMLFormElement>('.form');
  const estado = document.querySelector<HTMLElement>('[data-estado]');
  const botao = document.querySelector<HTMLButtonElement>('.form__enviar');

  if (form && estado && botao) {
    form.addEventListener('submit', async (evento) => {
      evento.preventDefault();
      botao.disabled = true;
      estado.textContent = 'Enviando…';
      estado.dataset.tipo = 'carregando';

      try {
        const resposta = await fetch('/api/contato', {
          method: 'POST',
          body: new FormData(form),
          headers: { accept: 'application/json' },
        });
        const dados = await resposta.json().catch(() => ({}));

        if (resposta.ok) {
          form.reset();
          estado.textContent = 'Mensagem enviada. Responderemos em breve.';
          estado.dataset.tipo = 'sucesso';
        } else {
          estado.textContent = dados.erro ?? 'Não foi possível enviar. Tente novamente.';
          estado.dataset.tipo = 'erro';
        }
      } catch {
        estado.textContent = 'Sem conexão. Tente novamente.';
        estado.dataset.tipo = 'erro';
      } finally {
        botao.disabled = false;
      }
    });
  }
</script>

<style>
  /* Cartão do Figma (node 1:1659): fundo quase branco, raio 8 e a sombra
     curta de 2px que o design usa para descolar da faixa creme. */
  .form {
    background: var(--fig-fundo-cartao);
    border-radius: var(--fig-raio-sm);
    box-shadow: var(--fig-sombra-cartao);
    display: flex;
    flex-direction: column;
    gap: var(--fig-e-md);
    padding: var(--fig-e-xl);
  }
  .form__campo { display: flex; flex-direction: column; gap: 6px; }
  .form__campo label {
    color: #212529;
    font: var(--fig-peso-forte) var(--fig-t-meta) / 1.5 var(--fig-fonte-corpo);
  }
  .form__campo :is(input, select, textarea) {
    background: #fff;
    border: 1px solid var(--fig-borda);
    border-radius: var(--fig-raio-xs);
    color: var(--fig-cinza-900);
    font: var(--fig-peso-normal) var(--fig-t-meta) / 1.5 var(--fig-fonte-corpo);
    padding: 7px 13px;
    width: 100%;
  }
  .form__campo textarea { min-height: 107px; }
  .form__campo :is(input, select, textarea):focus-visible {
    outline: 2px solid var(--fig-primaria-clara);
    outline-offset: 1px;
  }
  .form__campo textarea { resize: vertical; }

  /* Iscas: invisíveis e inalcançáveis, sem sair do DOM. */
  .form__iscas {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .form__enviar {
    background: var(--fig-primaria-clara);
    border: 0;
    border-radius: var(--fig-raio-sm);
    color: #fff;
    cursor: pointer;
    font: var(--fig-peso-forte) var(--fig-t-corpo) / 1.2 var(--fig-fonte-ui);
    padding: var(--fig-e-sm) var(--fig-e-lg);
    transition: transform var(--dur-botao-enviar) var(--mola-botao-enviar);
    width: 100%;
  }
  .form__enviar:hover:not(:disabled) { transform: translateY(-1px); }
  .form__enviar:disabled { opacity: 0.6; cursor: progress; }

  .form__estado { margin: 0; font: var(--fig-peso-normal) var(--fig-t-meta) / 1.4 var(--fig-fonte-corpo); }
  .form__estado:empty { display: none; }
  .form__estado[data-tipo='erro'] { color: #b3261e; }
  .form__estado[data-tipo='sucesso'] { color: #2e6b3e; }

  /* ── O dropdown ─────────────────────────────────────────────
     O <select> nativo não aceita raio, cor de fundo nem hover por item —
     o menu que ele abre é desenhado pelo sistema operacional. Esta lista
     é HTML de verdade por cima dele; o nativo continua no DOM, escondido,
     porque é ele que o formulário envia e é ele que aparece sem JS. */
  /* `.form__campo` no seletor: sem ele a regra genérica de input/select/
     textarea logo abaixo vence por especificidade e devolve os 100% de
     largura ao nativo escondido. */
  .form__campo select.form__nativo {
    /* Escondido, mas ainda no formulário: `display:none` tiraria o valor do
       envio em alguns navegadores. O clip e o 1px impedem que ele estique a
       largura da linha e roube área de clique. */
    clip: rect(0 0 0 0);
    clip-path: inset(50%);
    height: 1px;
    opacity: 0;
    overflow: hidden;
    pointer-events: none;
    position: absolute;
    white-space: nowrap;
    width: 1px;
  }

  .escolha { position: relative; }

  .escolha__gatilho {
    align-items: center;
    background: #fff;
    border: 1px solid var(--fig-borda, #d9cfc6);
    border-radius: 10px;
    color: var(--fig-primaria-ativa);
    cursor: pointer;
    display: flex;
    font: 500 15px/1.4 var(--fig-fonte-corpo);
    gap: 12px;
    justify-content: space-between;
    padding: 13px 15px;
    text-align: left;
    transition: border-color 160ms ease, box-shadow 160ms ease;
    width: 100%;
  }
  .escolha__gatilho:hover { border-color: #b9a894; }
  .escolha__gatilho[aria-expanded='true'] {
    border-color: var(--fig-primaria-ativa);
    box-shadow: 0 0 0 3px rgb(53 32 5 / 0.08);
  }
  .escolha__gatilho:focus-visible {
    border-color: var(--fig-primaria-ativa);
    outline: 2px solid var(--fig-primaria-ativa);
    outline-offset: 2px;
  }
  /* Enquanto nada foi escolhido o rótulo é um texto de espera. */
  .escolha__valor[data-vazio] { color: #9a9088; }

  .escolha__seta {
    color: #8b8178;
    flex: none;
    height: 18px;
    transition: transform 200ms ease;
    width: 18px;
  }
  .escolha__gatilho[aria-expanded='true'] .escolha__seta { transform: rotate(180deg); }

  .escolha__lista {
    background: #fff;
    border: 1px solid #ece5de;
    border-radius: 12px;
    box-shadow: 0 2px 4px rgb(0 0 0 / 0.06), 0 12px 28px rgb(0 0 0 / 0.12);
    left: 0;
    list-style: none;
    margin: 6px 0 0;
    max-height: 260px;
    overflow-y: auto;
    padding: 6px;
    position: absolute;
    right: 0;
    top: 100%;
    z-index: 30;
  }
  .escolha__lista[hidden] { display: none; }

  .escolha__item {
    border-radius: 8px;
    color: var(--fig-primaria-ativa);
    cursor: pointer;
    font: 500 15px/1.4 var(--fig-fonte-corpo);
    padding: 11px 13px;
    transition: background 120ms ease;
  }
  /* O hover por item é o que o <select> nativo não dá: lá é a faixa azul
     do sistema, que não combina com nada da marca. */
  .escolha__item:hover,
  .escolha__item[data-realce] { background: #f5efe9; }
  .escolha__item[aria-selected='true'] {
    background: var(--fig-fundo-pessego);
    font-weight: 700;
  }

  @media (prefers-reduced-motion: reduce) {
    .escolha__seta { transition: none; }
  }
</style>

<script>
  /*
    O dropdown da lista de serviços.

    O <select> nativo continua no formulário e é ele que envia o valor —
    esta lista só o espelha. Se o script não rodar, o `hidden` do .escolha
    nunca sai e o usuário vê o nativo, que funciona.

    Teclado: setas andam, Enter/Espaço escolhem, Esc fecha, Tab sai. É o
    contrato de um listbox, e sem ele o campo ficaria inacessível.
  */
  const nativo = document.getElementById('servico') as HTMLSelectElement | null;
  const caixa = document.getElementById('escolha');
  const gatilho = document.getElementById('escolha-gatilho');
  const lista = document.getElementById('escolha-lista');
  const valor = document.getElementById('escolha-valor');

  if (nativo && caixa && gatilho && lista && valor) {
    const itens = [...lista.querySelectorAll<HTMLElement>('.escolha__item')];

    // Só agora a lista entra em cena; o nativo sai.
    caixa.hidden = false;
    nativo.classList.add('form__nativo');
    valor.dataset.vazio = '';

    let aberto = false;
    let realce = -1;

    function marcaRealce(i: number) {
      itens.forEach((it, n) => it.toggleAttribute('data-realce', n === i));
      realce = i;
      if (i >= 0) itens[i].scrollIntoView({ block: 'nearest' });
    }

    function abre() {
      aberto = true;
      lista.hidden = false;
      gatilho.setAttribute('aria-expanded', 'true');
      const atual = itens.findIndex((it) => it.dataset.valor === nativo.value);
      marcaRealce(atual >= 0 ? atual : 0);
    }

    function fecha() {
      aberto = false;
      lista.hidden = true;
      gatilho.setAttribute('aria-expanded', 'false');
      marcaRealce(-1);
    }

    function escolhe(i: number) {
      const it = itens[i];
      if (!it) return;
      nativo.value = it.dataset.valor!;
      /* `change` de verdade: quem estiver ouvindo o <select> — validação,
         analytics — continua funcionando como se fosse o nativo. */
      nativo.dispatchEvent(new Event('change', { bubbles: true }));
      valor.textContent = it.textContent;
      delete valor.dataset.vazio;
      itens.forEach((o, n) => o.setAttribute('aria-selected', String(n === i)));
      fecha();
      gatilho.focus();
    }

    gatilho.addEventListener('click', () => (aberto ? fecha() : abre()));

    itens.forEach((it, i) => {
      it.addEventListener('click', () => escolhe(i));
      it.addEventListener('mousemove', () => marcaRealce(i));
    });

    gatilho.addEventListener('keydown', (e) => {
      if (['ArrowDown', 'ArrowUp', 'Enter', ' '].includes(e.key)) {
        e.preventDefault();
        if (!aberto) { abre(); return; }
        if (e.key === 'Enter' || e.key === ' ') escolhe(realce);
        else marcaRealce(Math.min(itens.length - 1, Math.max(0, realce + (e.key === 'ArrowDown' ? 1 : -1))));
      }
      if (e.key === 'Escape' && aberto) { e.preventDefault(); fecha(); }
    });

    // Clique fora fecha.
    document.addEventListener('click', (e) => {
      if (aberto && !caixa.contains(e.target as Node)) fecha();
    });
  }
</script>
