---
/**
 * Lista dos artigos, com o estado de cada um (publicado ou rascunho).
 *
 * Tudo acontece no navegador, com a chave anônima: a RLS do banco é quem
 * decide o que ela pode ver e mudar. Rascunho só aparece para editor.
 */
import Base from '~/layouts/Base.astro';
---

<Base titulo="Seus artigos" descricao="Lista dos artigos do blog, com o estado de publicação de cada um." noindex>
  <main class="painel">
    <header class="painel__topo">
      <div>
        <h1 class="painel__titulo">Seus artigos</h1>
        <p class="painel__quem" id="quem"></p>
      </div>
      <div class="painel__acoes">
        <a class="botao-principal" href="/painel/artigo">Escrever artigo</a>
        <button class="botao-simples" id="sair" type="button">Sair</button>
      </div>
    </header>

    <p class="painel__aviso" id="aviso" role="status" hidden></p>

    <div class="lista" id="lista">
      <p class="lista__vazio">Carregando…</p>
    </div>
  </main>
</Base>

<script>
  import { supabase, exigeSessao } from '~/lib/supabase-navegador';

  const lista = document.getElementById('lista')!;
  const quem = document.getElementById('quem')!;
  const aviso = document.getElementById('aviso')!;

  const sessao = await exigeSessao();
  if (sessao) {
    quem.textContent = sessao.user.email ?? '';

    document.getElementById('sair')!.addEventListener('click', async () => {
      await supabase.auth.signOut();
      window.location.href = '/painel/entrar';
    });

    const dataBR = (iso: string) =>
      new Intl.DateTimeFormat('pt-BR', { day: '2-digit', month: 'short', year: 'numeric' })
        .format(new Date(iso));

    async function carrega() {
      const { data, error } = await supabase
        .from('artigos')
        .select('slug, titulo, publicado, publicado_em, categoria')
        .order('publicado_em', { ascending: false });

      if (error) {
        lista.innerHTML = '<p class="lista__vazio">Não consegui carregar os artigos.</p>';
        return;
      }
      if (!data?.length) {
        lista.innerHTML = '<p class="lista__vazio">Nenhum artigo ainda.</p>';
        return;
      }

      lista.innerHTML = data.map((a) => `
        <article class="item">
          <div class="item__texto">
            <h2 class="item__titulo">${a.titulo.replace(/</g, '&lt;')}</h2>
            <p class="item__meta">
              <span class="etiqueta ${a.publicado ? 'etiqueta--no-ar' : 'etiqueta--rascunho'}">
                ${a.publicado ? 'No ar' : 'Rascunho'}
              </span>
              <span>${a.categoria}</span>
              <span>${dataBR(a.publicado_em)}</span>
            </p>
          </div>
          <a class="botao-simples" href="/painel/artigo?slug=${encodeURIComponent(a.slug)}">Editar</a>
        </article>
      `).join('');
    }

    // Se o build ainda está rodando, avisa — senão ela publica e acha que
    // não funcionou porque o site levou um minuto para atualizar.
    if (new URLSearchParams(location.search).get('publicado') === 'sim') {
      aviso.textContent = 'Artigo salvo. O site atualiza em cerca de um minuto.';
      aviso.hidden = false;
    }

    await carrega();
  }
</script>

<style>
  .painel { margin-inline: auto; max-width: 900px; padding: var(--fig-e-4xl) var(--fig-margem-interna) var(--fig-secao-y); }
  .painel__topo { align-items: flex-start; display: flex; flex-wrap: wrap; gap: var(--fig-e-lg); justify-content: space-between; margin-bottom: var(--fig-e-2xl); }
  .painel__titulo { color: var(--fig-primaria-ativa); font: var(--fig-peso-semi) var(--fig-f-titulo-secao) / 1.2 var(--fig-fonte-corpo); margin: 0; }
  .painel__quem { color: var(--fig-texto-meta); font: var(--fig-peso-semi) var(--fig-t-corpo-p) / 1.5 var(--fig-fonte-corpo); margin: var(--fig-e-xs) 0 0; }
  .painel__acoes { display: flex; gap: var(--fig-e-md); }
  .painel__aviso { background: var(--fig-fundo-pessego); border-radius: var(--fig-raio-sm); color: var(--fig-primaria-ativa); font: var(--fig-peso-semi) var(--fig-t-corpo-p) / 1.5 var(--fig-fonte-corpo); margin: 0 0 var(--fig-e-lg); padding: var(--fig-e-md); }

  .botao-principal { background: var(--fig-primaria-ativa); border-radius: var(--fig-raio-sm); color: #fff; font: var(--fig-peso-forte) var(--fig-t-corpo-p) / 1 var(--fig-fonte-corpo); padding: var(--fig-e-md) var(--fig-e-lg); text-decoration: none; }
  .botao-simples { background: #fff; border: 1px solid var(--fig-primaria-ativa); border-radius: var(--fig-raio-sm); color: var(--fig-primaria-ativa); cursor: pointer; font: var(--fig-peso-semi) var(--fig-t-corpo-p) / 1 var(--fig-fonte-corpo); padding: var(--fig-e-md) var(--fig-e-lg); text-decoration: none; }

  .lista { display: flex; flex-direction: column; gap: var(--fig-e-md); }
</style>

<!--
  A lista é montada por script (innerHTML), e esses elementos NÃO recebem o
  atributo de escopo que o Astro põe no que vem do template — então o estilo
  escopado simplesmente não os alcança: os cartões saíam sem borda e os
  títulos com 60px. Por isso estas regras são globais, e por isso os nomes
  são específicos (`.item__`, `.etiqueta`), para não vazarem em outra tela.
-->
<style is:global>
  .lista__vazio { color: var(--fig-texto-meta); font: var(--fig-peso-semi) var(--fig-f-corpo) / 1.6 var(--fig-fonte-corpo); }
  .item { align-items: center; background: #fff; border: 1px solid var(--fig-borda); border-radius: var(--fig-raio-sm); display: flex; gap: var(--fig-e-lg); justify-content: space-between; padding: var(--fig-e-lg); }
  .item__texto { min-width: 0; }
  .item__titulo { color: var(--fig-tinta); font: var(--fig-peso-forte) var(--fig-t-corpo-p) / 1.3 var(--fig-fonte-corpo); margin: 0 0 var(--fig-e-xs); }
  .item__meta { align-items: center; color: var(--fig-texto-meta); display: flex; flex-wrap: wrap; font: var(--fig-peso-semi) 0.875rem / 1.4 var(--fig-fonte-corpo); gap: var(--fig-e-sm); margin: 0; }
  .item .botao-simples { background: #fff; border: 1px solid var(--fig-primaria-ativa); border-radius: var(--fig-raio-sm); color: var(--fig-primaria-ativa); flex: none; font: var(--fig-peso-semi) var(--fig-t-corpo-p) / 1 var(--fig-fonte-corpo); padding: var(--fig-e-md) var(--fig-e-lg); text-decoration: none; }
  .etiqueta { border-radius: 999px; font-weight: 700; padding: 2px 10px; }
  .etiqueta--no-ar { background: #e6f0e2; color: #2f5d2a; }
  .etiqueta--rascunho { background: #f3e6cf; color: #7a5a1e; }

  @media (max-width: 599.98px) {
    .item { align-items: stretch; flex-direction: column; }
  }
</style>
