---
/**
 * Página de artigo. É o primeiro item da Fase 2 da spec por um motivo
 * concreto: **20 dos 25 artigos estão em 302 provisório** desde a virada do
 * domínio, e esta rota é o que devolve conteúdo real a essas URLs.
 *
 * O molde saiu de medir as 5 capturas de artigo, que compartilham layout:
 * data 16px/400 #999, título, corpo 16px/25.6 Mulish #666, headings Inter.
 * Detalhe em src/styles/artigo.css.
 */
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '~/layouts/Base.astro';
import CardArtigo from '~/components/artigos/CardArtigo.astro';
import Cabecalho from '~/components/Cabecalho.astro';
import Rodape from '~/components/Rodape.astro';
import Wordmark from '~/components/Wordmark.astro';
import JsonLd from '~/components/JsonLd.astro';
import { site } from '~/lib/site';
import '~/styles/artigo.css';

export async function getStaticPaths() {
  const artigos = await getCollection('artigos', ({ data }) => data.publicado !== false);
  return artigos.map((artigo) => ({ params: { slug: artigo.id }, props: { artigo } }));
}

const { artigo } = Astro.props;
const { Content } = await render(artigo);
const d = artigo.data;

/* Três outros artigos no fim da página, como no Framer. A escolha prefere a
   mesma categoria — quem leu sobre organização tende a querer mais disso —
   e completa com os mais recentes quando a categoria não dá três. */
const todos = (await getCollection('artigos', ({ data }) => data.publicado !== false))
  .filter((a) => a.id !== artigo.id)
  .sort((a, b) => b.data.publicadoEm.valueOf() - a.data.publicadoEm.valueOf());

const daCategoria = todos.filter((a) => a.data.categoria === d.categoria);
const relacionados = [...daCategoria, ...todos.filter((a) => !daCategoria.includes(a))].slice(0, 3);

const dataLegivel = (valor: Date) =>
  new Intl.DateTimeFormat('pt-BR', { day: '2-digit', month: 'short', year: 'numeric' }).format(valor);

/*
  O título e o resumo do artigo são a fonte do title/description. Não se
  inventa copy: se o frontmatter trouxer seoTitulo/seoDescricao, mandam eles.
*/
const titulo = d.seoTitulo ?? d.titulo;
const descricao = d.seoDescricao ?? d.resumo;
---

<Base
  titulo={titulo}
  descricao={descricao}
  tipo="article"
  publicadoEm={d.publicadoEm}
  atualizadoEm={d.atualizadoEm}
  autor={d.autor}
>
  <Cabecalho slot="cabecalho" />

  {/* Article + BreadcrumbList, além do LocalBusiness que o Base já injeta. */}
  <JsonLd
    tipo="artigo"
    titulo={d.titulo}
    descricao={descricao}
    publicadoEm={d.publicadoEm}
    atualizadoEm={d.atualizadoEm}
    autor={d.autor}
  />
  <JsonLd
    tipo="migalhas"
    migalhas={[
      { nome: 'Início', href: '/' },
      { nome: 'Blog', href: '/artigos' },
      { nome: d.titulo, href: `/artigos/${artigo.id}` },
    ]}
  />

  <article class="artigo">
    {/* A data é a primeira coisa da página, sutil e centralizada — no Framer
        não há migalha aqui. Ela some da vista mas continua no JSON-LD, que é
        de onde o Google lê a trilha. */}
    <p class="artigo-data">
      <time datetime={d.publicadoEm.toISOString()}>{dataLegivel(d.publicadoEm)}</time>
    </p>

    <h1 class="artigo-titulo">{d.titulo}</h1>

    <p class="artigo-categoria">{d.categoria}</p>

    <Image class="artigo-capa" src={d.capa} alt={d.capaAlt} width={d.capaLargura ?? undefined} height={d.capaAltura ?? undefined} widths={[390, 700, 875]} sizes="(min-width: 1200px) 875px, (min-width: 810px) 700px, 100vw" loading="eager" />

    <div class="artigo-corpo">
      <Content />
    </div>
  </article>

  {relacionados.length > 0 && (
    <section class="mais-posts" aria-labelledby="mais-posts-titulo">
      <h2 class="mais-posts__titulo" id="mais-posts-titulo">Ver mais postagens</h2>
      <ul class="mais-posts__grade">
        {relacionados.map((a) => (
          <li><CardArtigo artigo={a} minutos={a.data.tempoLeitura ?? 3} /></li>
        ))}
      </ul>
    </section>
  )}

  <div slot="rodape">

    <Wordmark />

    <Rodape variante="escuro" />

  </div>
</Base>

<style>
  /*
    O artigo é a ÚNICA tela sem desenho no Figma — o design tem detalhe de
    projeto, mas nenhum post individual. Então esta página é derivada: usa a
    mesma gramática do detalhe de projeto (mesma escala de título, mesmo
    corpo, mesmas cores) numa coluna de leitura. Nada aqui é inventado
    visualmente; é o sistema de tokens aplicado a um caso que o design não
    cobriu.
  */
  .artigo-categoria {
    align-self: flex-start;
    background: #8d7252;
    border-radius: var(--fig-raio-xs);
    color: var(--fig-cinza-50);
    display: inline-block;
    font: var(--fig-peso-normal) var(--fig-t-meta) / 1.4 var(--fig-fonte-display);
    margin: var(--fig-e-2xl) 0 var(--fig-e-sm);
    padding: var(--fig-e-2xs) var(--fig-e-lg);
  }


  /* ── Ver mais postagens ─────────────────────────────────────
     Três cards no fim do artigo, como no Framer. Usa o mesmo CardArtigo da
     listagem — card diferente aqui seria uma segunda linguagem para a mesma
     coisa. */
  .mais-posts {
    border-top: 1px solid #e6ddd4;
    margin: 72px auto 0;
    max-width: 1040px;
    padding: 56px 24px 0;
  }
  .mais-posts__titulo {
    color: #3a2e26;
    font: 700 28px/1.2 'Inter', system-ui, sans-serif;
    margin: 0 0 28px;
    text-align: center;
  }
  .mais-posts__grade {
    display: grid;
    gap: 20px;
    grid-template-columns: repeat(3, 1fr);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .mais-posts__grade li { min-width: 0; }

  @media (max-width: 899.98px) {
    .mais-posts__grade { grid-template-columns: repeat(2, 1fr); }
    .mais-posts__grade li:nth-child(3) { display: none; }
  }
  @media (max-width: 599.98px) {
    .mais-posts { padding-top: 40px; }
    .mais-posts__grade { grid-template-columns: 1fr; }
    .mais-posts__grade li:nth-child(3) { display: block; }
  }
</style>
