---
/**
 * Um artigo em página inteira. A edição do dia a dia acontece na gaveta da
 * lista (/painel); esta página existe para links diretos, para quem abre em
 * nova aba, e para o celular, onde a tela cheia é mais confortável.
 *
 * Os campos e a lógica são os mesmos da gaveta — FormArtigo e painel-editor.
 */
import Base from '~/layouts/Base.astro';
import FormArtigo from '~/components/painel/FormArtigo.astro';
import '~/styles/painel.css';
---

<Base titulo="Artigo" descricao="Escrever ou editar um artigo." noindex>
  <div class="pnl">
    <header class="pnl-topo">
      <a class="pnl-btn pnl-btn--icone" href="/painel" aria-label="Voltar para a lista">✕</a>
      <p class="pnl-topo__nome" id="cabecalho">Novo artigo</p>
      <div class="pnl-topo__acoes">
        <span class="pnl-salvo" id="salvo"></span>
        <button class="pnl-btn pnl-btn--azul" type="submit" form="form">Publicar</button>
      </div>
    </header>

    <div class="pnl-form">
      <FormArtigo />
    </div>
  </div>
</Base>

<script>
  import { supabase, exigeSessao } from '~/lib/supabase-navegador';
  import { montaEditor } from '~/lib/painel-editor';

  const sessao = await exigeSessao();
  if (sessao) {
    const slug = new URLSearchParams(location.search).get('slug');
    const salvo = document.getElementById('salvo')!;

    if (slug) document.getElementById('cabecalho')!.textContent = 'Editar artigo';

    montaEditor({
      supabase,
      raiz: document,
      slug,
      usuario: sessao.user.id,
      marcaEstado: (e) => {
        salvo.className = 'pnl-salvo';
        if (e === 'limpo') salvo.textContent = 'Salvo';
        else if (e === 'mexido') { salvo.textContent = 'Não salvo'; salvo.classList.add('pnl-salvo--indo'); }
        else if (e === 'salvando') { salvo.textContent = 'Salvando…'; salvo.classList.add('pnl-salvo--indo'); }
        else { salvo.textContent = 'Salvo'; salvo.classList.add('pnl-salvo--ok'); }
      },
      aoSalvar: () => { window.location.href = '/painel?publicado=sim'; },
    });
  }
</script>
