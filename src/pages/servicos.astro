---
import Base from '~/layouts/Base.astro';
import Cabecalho from '~/components/Cabecalho.astro';
import Rodape from '~/components/Rodape.astro';
import Migalhas from '~/components/Migalhas.astro';
import Botao from '~/components/Botao.astro';
import { servicos } from '~/lib/conteudo';
---

<Base
  titulo="Nossos Serviços"
  descricao="Arquitetura residencial e comercial, design de interiores, consultoria de decoração e ambientação — do briefing ao acompanhamento final."
>
  <Cabecalho slot="cabecalho" />
  <Migalhas atual="Nossos serviços" />

  <section class="secao container">
    <h1>Nossos Serviços</h1>
  </section>

  {servicos.map(({ slug, sobretitulo, titulo, paragrafos }, i) => (
    <section class:list={['servico', i % 2 === 1 && 'servico--alt']} id={slug}>
      <div class="container servico__interno">
        <header>
          {sobretitulo && <p class="servico__sobretitulo">{sobretitulo}</p>}
          <h2 class="servico__titulo">{titulo}</h2>
        </header>
        <div class="servico__corpo">
          {paragrafos.map((t) => <p>{t}</p>)}
          <div class="servico__acao">
            <Botao href="/contato" variante="contorno">Entrar em contato</Botao>
          </div>
        </div>
      </div>
    </section>
  ))}

  <section class="chamada">
    <div class="container chamada__interno">
      <p class="rotulo">Contate-nos</p>
      <h2 class="chamada__titulo">Sobrou alguma dúvida?<br />Vamos conversar!</h2>
      <Botao href="/contato" variante="solido">Quero agendar uma reunião</Botao>
    </div>
  </section>

  <Rodape slot="rodape" />
</Base>

<style>
  .servico { padding-block: var(--secao-y); }
  .servico--alt { background-color: var(--cor-fundo-alt); }
  .servico__interno { display: grid; gap: var(--esp-md); }
  .servico__sobretitulo {
    font-family: var(--fonte-titulo);
    font-size: var(--texto-lg);
    color: var(--cor-texto-suave);
    line-height: 1;
  }
  .servico__titulo { font-size: var(--texto-2xl); }
  .servico__corpo { display: grid; gap: var(--esp-sm); max-width: var(--largura-texto); }
  .servico__corpo p { color: var(--cor-texto-suave); }
  .servico__acao { margin-block-start: var(--esp-sm); }

  .chamada { padding-block: var(--secao-y); }
  .chamada__interno { text-align: center; }
  .chamada__titulo { margin-block: var(--esp-2xs) var(--esp-lg); }

  @media (min-width: 60rem) {
    .servico__interno { grid-template-columns: 1fr 1.4fr; gap: var(--esp-2xl); align-items: start; }
  }
</style>
