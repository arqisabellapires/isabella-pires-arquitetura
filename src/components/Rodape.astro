---
/**
 * Rodapé — valores medidos em _capturas/home/medidas.desktop.json (y > 7190).
 *
 * Fundo #f0d9c7, três colunas: chamada em x=128, "Institucional" em x=720,
 * "Informações" em x=1032. Títulos 32px/700 Mulish #21201f; links 16px/500
 * Mulish #483b2a; a assinatura é 20px/500 Arboria.
 */
import { site, rodape } from '~/lib/site';

const ano = new Date().getFullYear();
---

<footer class="rodape">
  <div class="rodape__interno">
    <section class="rodape__chamada">
      <p class="rodape__sobretitulo">Contate-nos</p>
      <p class="rodape__titulo">Sobrou alguma dúvida?<br />Vamos conversar!</p>
      <a class="rodape__botao" href="/contato">Quero agendar uma reunião</a>
    </section>

    <nav class="rodape__coluna" aria-label="Institucional">
      <h2 class="rodape__coluna-titulo">Institucional</h2>
      <ul class="rodape__lista">
        {rodape.institucional.map(({ rotulo, href }) => (
          <li><a href={href}>{rotulo}</a></li>
        ))}
      </ul>
    </nav>

    <section class="rodape__coluna" aria-labelledby="rodape-informacoes">
      <h2 class="rodape__coluna-titulo" id="rodape-informacoes">Informações</h2>
      <ul class="rodape__lista">
        {/*
          As três políticas não existem como página no Framer: os links
          apontavam para lugar nenhum. Ficam como texto, não como link morto —
          criar política jurídica é decisão do Gabriel, não de quem executa.
        */}
        {rodape.informacoes.map(({ rotulo, href }) => (
          <li>{href ? <a href={href}>{rotulo}</a> : <span>{rotulo}</span>}</li>
        ))}
      </ul>
    </section>
  </div>

  <p class="rodape__assinatura">
    © {ano} Arquiteta Isabella Pires |
    <a href={site.redes.instagram} rel="me noopener" target="_blank">
      {site.redes.arroba}
    </a>
  </p>
</footer>

<style>
  .rodape {
    background: #f0d9c7;
    padding: 64px 0 32px;
    font-family: 'Mulish', system-ui, sans-serif;
  }
  .rodape__interno {
    display: grid;
    gap: 32px;
    grid-template-columns: 1fr;
    margin-inline: auto;
    max-width: 1184px;
    padding-inline: 24px;
  }
  @media (min-width: 1200px) {
    .rodape__interno { grid-template-columns: 1.6fr 1fr 1fr; }
  }
  .rodape__sobretitulo {
    font: 600 20px/1.2 'Mulish', system-ui, sans-serif;
    color: #483b2a;
    margin: 0 0 8px;
  }
  .rodape__titulo {
    font: 600 34px/1.2 'Mulish', system-ui, sans-serif;
    color: #21201f;
    margin: 0 0 24px;
  }
  .rodape__botao {
    display: inline-block;
    font: 600 18px/1.2 'Mulish', system-ui, sans-serif;
    color: #21201f;
    border: 1px solid #483b2a;
    border-radius: 999px;
    padding: 16px 24px;
    text-decoration: none;
  }
  .rodape__coluna-titulo {
    font: 700 32px/1.2 'Mulish', system-ui, sans-serif;
    color: #21201f;
    margin: 0 0 16px;
  }
  .rodape__lista { list-style: none; margin: 0; padding: 0; }
  .rodape__lista li { margin-bottom: 10px; }
  .rodape__lista :is(a, span) {
    font: 500 16px/1.4 'Mulish', system-ui, sans-serif;
    color: #483b2a;
    text-decoration: none;
  }
  .rodape__lista a:hover { text-decoration: underline; }
  .rodape__assinatura {
    font: 500 20px/1.4 'Arboria', 'Mulish', system-ui, sans-serif;
    color: #21201f;
    margin: 48px auto 0;
    max-width: 1184px;
    padding-inline: 24px;
  }
  .rodape__assinatura a { color: inherit; }
</style>
