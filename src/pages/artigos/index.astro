---
/**
 * Listagem do blog. Medida em _capturas/artigos/medidas.desktop.json:
 * migalhas "Início / Blog", título "Blog" 60px/600 Mulish, hero
 * 64px/500 Manrope, filtros de categoria em 16px/400 Inter, grade de 3
 * colunas de 283px.
 *
 * **Exceção conhecida e registrada na spec (§8):** esta é a única página que
 * o portão de pixel nunca vai aprovar. A referência do Framer mede altura
 * diferente a cada carregamento (2778, 5073, 5532 px) porque buscava do CMS
 * em runtime. A aceitação dela é só por comparação lado a lado.
 *
 * Os filtros de categoria são links para /artigos/categoria/<slug>, não
 * JavaScript: página estática filtra no build, que é de graça e indexável.
 */
import { getCollection } from 'astro:content';
import Base from '~/layouts/Base.astro';
import Cabecalho from '~/components/Cabecalho.astro';
import Rodape from '~/components/Rodape.astro';
import CardArtigo from '~/components/artigos/CardArtigo.astro';
import { categorias } from '~/lib/site';
import { minutosDeLeitura, aSlug } from '~/lib/artigos';

const artigos = (await getCollection('artigos', ({ data }) => data.publicado !== false)).sort(
  (a, b) => b.data.publicadoEm.valueOf() - a.data.publicadoEm.valueOf(),
);

const comMinutos = await Promise.all(
  artigos.map(async (artigo) => ({ artigo, minutos: await minutosDeLeitura(artigo) })),
);
---

<Base
  titulo="Blog"
  descricao="Dicas e notícias de arquitetura, interiores e reforma, por Isabella Pires — arquiteta em Maringá."
>
  <Cabecalho slot="cabecalho" />

  <div class="listagem">
    <nav class="migalhas" aria-label="Migalhas">
      <a href="/">Início</a> <span aria-hidden="true">/</span> <span>Blog</span>
    </nav>

    <p class="listagem__rotulo">Blog</p>
    <h1 class="listagem__titulo">Dicas e notícias para quem realmente se destaca.</h1>

    <nav class="filtros" aria-label="Filtrar por categoria">
      <a class="filtros__item filtros__item--ativo" href="/artigos" aria-current="page">Todos</a>
      {categorias.map((c) => (
        <a class="filtros__item" href={`/artigos/categoria/${aSlug(c)}`}>{c}</a>
      ))}
    </nav>

    <div class="grade">
      {comMinutos.map(({ artigo, minutos }, i) => (
        <CardArtigo artigo={artigo} minutos={minutos} prioritaria={i < 3} />
      ))}
    </div>
  </div>

  <Rodape slot="rodape" />
</Base>

<style>
  .listagem {
    margin-inline: auto;
    max-width: 1184px;
    padding: 120px 24px 64px;
  }
  .migalhas {
    font: 700 16px/1.2 'Mulish', system-ui, sans-serif;
    color: #341f04;
    margin-bottom: 48px;
  }
  .migalhas a { color: inherit; text-decoration: none; }
  .listagem__rotulo {
    font: 600 60px/1.1 'Mulish', system-ui, sans-serif;
    color: #21201f;
    margin: 0 0 24px;
  }
  .listagem__titulo {
    font: 500 64px/1.1 'Manrope', 'Mulish', system-ui, sans-serif;
    color: #21201f;
    margin: 0 0 48px;
    max-width: 20ch;
    text-wrap: balance;
  }
  .filtros {
    display: flex;
    flex-wrap: wrap;
    gap: 24px;
    margin-bottom: 40px;
  }
  .filtros__item {
    font: 400 16px/1.4 'Inter', system-ui, sans-serif;
    color: #5a5755;
    text-decoration: none;
  }
  .filtros__item--ativo { color: #341f04; font-weight: 600; }
  .grade {
    display: grid;
    gap: 40px 40px;
    grid-template-columns: repeat(3, 1fr);
  }
  @media (max-width: 1199.98px) {
    .listagem__rotulo { font-size: 44px; }
    .listagem__titulo { font-size: 44px; }
    .grade { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 809.98px) {
    .listagem { padding-top: 96px; }
    .listagem__rotulo { font-size: 32px; }
    .listagem__titulo { font-size: 32px; }
    .grade { grid-template-columns: 1fr; }
  }
</style>
