---
import { site } from '~/lib/site';
import { rodapeLinks } from '~/lib/conteudo';
---

<footer class="rodape">
  <div class="container rodape__interno">
    <div class="rodape__marca">
      <p class="rodape__nome">{site.nomeCurto}</p>
    </div>

    <nav class="rodape__coluna" aria-label="Institucional">
      <p class="rotulo rodape__rotulo">Institucional</p>
      <ul>
        {rodapeLinks.institucional.map(({ rotulo, href }) => <li><a href={href}>{rotulo}</a></li>)}
      </ul>
    </nav>

    <nav class="rodape__coluna" aria-label="Informações">
      <p class="rotulo rodape__rotulo">Informações</p>
      <ul>
        {rodapeLinks.informacoes.map(({ rotulo, href }) => <li><a href={href}>{rotulo}</a></li>)}
      </ul>
    </nav>
  </div>

  <div class="container rodape__base">
    <p>© 2025 Arquiteta Isabella Pires</p>
  </div>
</footer>

<style>
  .rodape {
    margin-block-start: var(--secao-y);
    padding-block-start: var(--esp-xl);
    background-color: var(--cor-fundo-escuro);
    color: color-mix(in srgb, var(--cor-sobre-escuro) 78%, transparent);
    font-size: var(--texto-sm);
  }
  .rodape__interno { display: grid; gap: var(--esp-lg); padding-block-end: var(--esp-xl); }
  .rodape__nome {
    font-family: var(--fonte-titulo);
    font-size: var(--texto-lg);
    color: var(--cor-sobre-escuro);
    letter-spacing: var(--entre-letras-caixa);
    text-transform: uppercase;
  }
  .rodape__rotulo {
    color: color-mix(in srgb, var(--cor-sobre-escuro) 55%, transparent);
    margin-block-end: var(--esp-xs);
  }
  .rodape ul { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--esp-2xs); }
  .rodape a { text-decoration: none; color: inherit; transition: color var(--transicao-rapida); }
  .rodape a:hover { color: var(--cor-acento-suave); }
  .rodape__base {
    padding-block: var(--esp-sm);
    border-top: 1px solid color-mix(in srgb, var(--cor-sobre-escuro) 12%, transparent);
    font-size: var(--texto-xs);
    color: color-mix(in srgb, var(--cor-sobre-escuro) 55%, transparent);
  }
  @media (min-width: 48rem) {
    .rodape__interno { grid-template-columns: 2fr 1fr 1fr; gap: var(--esp-xl); }
  }
</style>
