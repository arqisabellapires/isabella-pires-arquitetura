---
/**
 * Newsletter. Textos extraídos de _capturas/artigos/desktop.html:
 * "Acompanhe-nos através de nossa Newsletter!", "Inscreva-se" e
 * "Sem spam, você pode se desinscrever a qualquer momento."
 *
 * Envia sem JavaScript, como o de contato. Verificado contra a API real da
 * Brevo: assinatura devolve 200 e o contato entra na lista.
 */
import { CAMPOS_ISCA } from '~/lib/antispam';
---

<section class="news" aria-labelledby="news-titulo">
  <h2 class="news__titulo" id="news-titulo">Acompanhe-nos através de nossa Newsletter!</h2>

  <form class="news__form" method="post" action="/api/newsletter" novalidate>
    <label class="news__rotulo" for="news-email">Seu melhor e-mail</label>
    <div class="news__linha">
      <input
        id="news-email"
        name="email"
        type="email"
        required
        autocomplete="email"
        maxlength="254"
        placeholder="Seu e-mail"
      />
      <button type="submit">Inscreva-se</button>
    </div>

    <div class="news__iscas" aria-hidden="true">
      {CAMPOS_ISCA.map((c) => <input type="text" name={c} tabindex="-1" autocomplete="off" />)}
    </div>

    <p class="news__aviso">Sem spam, você pode se desinscrever a qualquer momento.</p>
    <p class="news__estado" role="status" aria-live="polite" data-news-estado></p>
  </form>
</section>

<script>
  const form = document.querySelector<HTMLFormElement>('.news__form');
  const estado = document.querySelector<HTMLElement>('[data-news-estado]');

  if (form && estado) {
    form.addEventListener('submit', async (evento) => {
      evento.preventDefault();
      estado.textContent = 'Enviando…';
      try {
        const r = await fetch('/api/newsletter', {
          method: 'POST',
          body: new FormData(form),
          headers: { accept: 'application/json' },
        });
        if (r.ok) { form.reset(); estado.textContent = 'Pronto! Você está inscrito.'; }
        else { const d = await r.json().catch(() => ({})); estado.textContent = d.erro ?? 'Não foi possível inscrever.'; }
      } catch { estado.textContent = 'Sem conexão. Tente novamente.'; }
    });
  }
</script>

<style>
  /* Fundo BRANCO e sem caixa: no Framer a seção ocupa a largura da tela em
     branco, colada no rodapé. Estava pêssego com raio de 12 e margem — uma
     caixa que lá não existe. */
  .news {
    background: #fff;
    margin-top: 0;
    padding: 90px 32px 100px;
  }
  /* 64px/500 no Framer, centralizado. Era 32px/700 à esquerda. */
  .news__titulo {
    color: #3a2e26;
    font: 500 clamp(2rem, 1rem + 3.4vw, 4rem) / 1.1 'Mulish', system-ui, sans-serif;
    margin: 0 auto 28px;
    max-width: 20ch;   /* 2 linhas, como no Framer */
    text-align: center;
    text-wrap: balance;
  }
  /* O rótulo não existe no Framer: o campo tem só o texto de espera. Fica
     no HTML para o leitor de tela, mas sai da vista. */
  .news__rotulo {
    clip: rect(0 0 0 0);
    clip-path: inset(50%);
    height: 1px;
    overflow: hidden;
    position: absolute;
    white-space: nowrap;
    width: 1px;
    display: block;
    font: 500 14px/1.2 'Inter', system-ui, sans-serif;
    color: #483b2a;
    margin-bottom: 8px;
  }
  /* Centralizada e estreita, como no Framer: o input tem ~360px, não a
     largura inteira da coluna. */
  .news__linha {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    justify-content: center;
    margin-inline: auto;
    max-width: 520px;
  }
  .news__linha input {
    background: #ffffff;
    border: 1px solid #e0cbb8;
    /* Raio 12, não pílula: o Framer usa cantos suaves nos dois. */
    border-radius: 12px;
    flex: 1 1 300px;
    font: 400 15px/1.4 'Mulish', system-ui, sans-serif;
    padding: 15px 18px;
  }
  /* Raio 12 e o marrom do Framer (#3a2e26), com a cara de botão que vale
     para todos os botões do site. */
  .news__linha button {
    background: #3a2e26;
    border: 0;
    border-radius: var(--fig-botao-raio, 12px);
    box-shadow: var(--fig-botao-brilho), var(--fig-sombra-botao);
    color: #ffffff;
    cursor: pointer;
    font: 700 15px/1.2 'Mulish', system-ui, sans-serif;
    padding: 15px 26px;
    transition:
      box-shadow var(--dur-newsletter-artigos) var(--mola-newsletter-artigos),
      transform var(--dur-newsletter-artigos) var(--mola-newsletter-artigos);
    white-space: nowrap;
  }
  .news__linha button:hover {
    box-shadow: var(--fig-botao-brilho), var(--fig-sombra-botao-alta);
    transform: translateY(-2px);
  }
  .news__linha button:active {
    box-shadow: var(--fig-sombra-botao-baixa);
    transform: translateY(1px);
  }
  .news__iscas {
    position: absolute;
    width: 1px; height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  /* 12px e centralizado, embaixo do campo. */
  .news__aviso {
    color: rgb(0 0 0 / 0.48);
    font: 500 12px/1.5 'Mulish', system-ui, sans-serif;
    margin: 14px 0 0;
    text-align: center;
  }
  .news__estado { font: 400 14px/1.4 'Mulish', system-ui, sans-serif; margin: 8px 0 0; }
  .news__estado:empty { display: none; }
  @media (max-width: 809.98px) {
    .news__titulo { font-size: 24px; }
  }
</style>
