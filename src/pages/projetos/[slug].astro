---
/**
 * Página de projeto — reconstruída contra o Figma (node 1:954), medidas em
 * `_figma/projeto-detalhe-medidas.json`.
 *
 * Três mudanças estruturais em relação ao que existia:
 *
 * 1. **Duas colunas.** A ficha técnica é uma coluna sticky de 593px à
 *    esquerda e o texto corre em 1003px à direita. Antes era tudo empilhado
 *    numa coluna só.
 * 2. **O herói tem gradiente**, e o título é Faberge 100px centralizado
 *    sobre a foto — não Mulish no canto inferior. Sem o gradiente o menu
 *    claro ficava ilegível sobre fotos claras, que é o defeito que o portão
 *    de contraste acusou nas quatro páginas de projeto.
 * 3. **"Outros Projetos"** fecha a página, com três cards e o botão "Ver
 *    todos" — não existia.
 *
 * A ficha mantém os campos REAIS da coleção (Ano, Autoria, Localização,
 * Categoria). O Figma pede Cliente, Serviço, Tamanho, Valor e Data — mas
 * publicar o valor de um projeto é decisão de negócio da cliente, e os
 * outros campos não existem no conteúdo.
 */
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '~/layouts/Base.astro';
import Cabecalho from '~/components/Cabecalho.astro';
import Rodape from '~/components/Rodape.astro';
import Wordmark from '~/components/Wordmark.astro';

export async function getStaticPaths() {
  const projetos = await getCollection('projetos', ({ data }) => data.publicado !== false);
  return projetos.map((projeto) => ({
    params: { slug: projeto.id },
    props: { projeto, outros: projetos.filter((p) => p.id !== projeto.id).slice(0, 3) },
  }));
}

const { projeto, outros } = Astro.props;
const { Content } = await render(projeto);
const d = projeto.data;
---

<Base titulo={d.titulo} descricao={d.seoDescricao ?? d.resumo}>
  <Cabecalho slot="cabecalho" sobreHero />

  <article class="projeto">
    <header class="projeto__hero">
      <Image
        class="projeto__capa"
        src={d.capa}
        alt={d.capaAlt}
        widths={[390, 1000, 1440]}
        sizes="100vw"
        loading="eager"
      />
      <h1 class="projeto__titulo">{d.titulo}</h1>
    </header>

    <div class="projeto__interno">
      <section class="ficha" aria-label="Detalhes do projeto">
        <h2 class="ficha__titulo">Detalhes do Projeto</h2>
        <dl class="ficha__lista">
          {d.ano && (<div><dt>Ano</dt><dd>{d.ano}</dd></div>)}
          <div><dt>Autoria</dt><dd>Isabella Pires</dd></div>
          {d.local && (<div><dt>Localização</dt><dd>{d.local}</dd></div>)}
          <div><dt>Categoria</dt><dd>{d.categoria}</dd></div>
        </dl>
      </section>

      <section class="concepcao">
        <h2 class="concepcao__titulo">Concepção e Processo</h2>
        <div class="concepcao__corpo"><Content /></div>
      </section>

      {d.galeria.length > 0 && (
        <section class="galeria" aria-label="Galeria do projeto" data-revela-filhos>
          {d.galeria.map((item) => (
            <Image
              src={item.imagem}
              alt={item.alt}
              widths={[390, 700, 1200]}
              sizes="(min-width: 1200px) 1003px, 100vw"
              loading="lazy"
            />
          ))}
        </section>
      )}
    </div>
  </article>

  {outros.length > 0 && (
    <section class="outros">
      <header class="outros__cabeca">
        <h2 class="outros__titulo">Outros Projetos</h2>
        <a class="outros__botao" href="/projetos">Ver todos</a>
      </header>
      <ul class="outros__grade">
        {outros.map((p) => (
          <li>
            <a href={`/projetos/${p.id}`}>
              <Image
                src={p.data.capa}
                alt={p.data.capaAlt}
                widths={[523, 1046]}
                sizes="(min-width: 1200px) 523px, 90vw"
                loading="lazy"
              />
              <h3>{p.data.titulo}</h3>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}

  <div slot="rodape">

    <Wordmark />

    <Rodape />

  </div>
</Base>

<style>
  /* ─── Herói ───────────────────────────────────────────────
     Foto de 1920x1152 com o gradiente diagonal do design. O gradiente não
     é enfeite: sem ele o cabeçalho claro fica ilegível sobre foto clara. */
  .projeto__hero { position: relative; }
  .projeto__capa {
    aspect-ratio: 1920 / 1152;
    display: block;
    height: auto;
    max-height: 80vh;
    object-fit: cover;
    width: 100%;
  }
  .projeto__hero::after {
    background: linear-gradient(156.5deg, rgb(0 0 0 / 0.6) 29.48%, rgb(0 0 0 / 0.222) 86.19%);
    content: '';
    inset: 0;
    position: absolute;
  }
  .projeto__titulo {
    color: var(--fig-cinza-50);
    font: var(--fig-peso-normal) var(--fig-f-titulo-pagina) / 1.1 var(--fig-fonte-display);
    left: 50%;
    letter-spacing: 0.04em;
    margin: 0;
    position: absolute;
    text-align: center;
    top: 58%;
    transform: translate(-50%, -50%);
    width: min(90%, 1200px);
    z-index: 1;
  }

  /* ─── Corpo: ficha sticky à esquerda, texto à direita ─────*/
  .projeto__interno {
    align-items: flex-start;
    display: grid;
    gap: var(--fig-e-5xl);
    grid-template-columns: 593fr 1003fr;
    margin-inline: auto;
    max-width: var(--fig-largura-conteudo);
    padding: var(--fig-e-4xl) var(--fig-margem-interna);
  }

  .ficha { position: sticky; top: var(--fig-e-2xl); }
  .ficha__titulo {
    color: var(--fig-cinza-900);
    font: var(--fig-peso-semi) clamp(1.75rem, 1.2rem + 1.6vw, 2.5rem) / var(--fig-altura-titulo) var(--fig-fonte-corpo);
    margin: 0 0 var(--fig-e-2xl);
  }
  .ficha__lista { display: flex; flex-direction: column; gap: var(--fig-e-xl); margin: 0; }
  .ficha__lista > div {
    border-bottom: 1px solid var(--fig-borda);
    display: flex;
    gap: var(--fig-e-md);
    justify-content: space-between;
    padding-bottom: var(--fig-e-sm);
  }
  .ficha__lista dt {
    color: var(--fig-texto);
    font: var(--fig-peso-semi) var(--fig-f-corpo) / 1.3 var(--fig-fonte-corpo);
  }
  .ficha__lista dd {
    color: var(--fig-cinza-900);
    font: var(--fig-peso-forte) var(--fig-f-corpo) / 1.3 var(--fig-fonte-corpo);
    margin: 0;
    text-align: right;
  }

  .concepcao__titulo {
    color: var(--fig-cinza-900);
    font: var(--fig-peso-normal) clamp(1.75rem, 1.2rem + 1.6vw, 2.5rem) / var(--fig-altura-titulo) var(--fig-fonte-corpo);
    margin: 0 0 var(--fig-e-lg);
  }
  .concepcao__corpo :global(p) {
    color: var(--fig-texto);
    font: var(--fig-peso-medio) clamp(1.0625rem, 0.95rem + 0.5vw, 1.375rem) / var(--fig-altura-solta) var(--fig-fonte-corpo);
    margin: 0 0 var(--fig-e-md);
  }
  .concepcao__corpo :global(strong) { color: var(--fig-cinza-900); font-weight: 800; }

  /*
    A galeria fica na COLUNA DA DIREITA, sob o texto — é onde o Figma põe as
    fotos, dentro do fluxo do Contexto.

    Sem isto ela caía na segunda linha da grade, ou seja, na coluna estreita
    de 593 sob a ficha: as fotos ficavam com 468px de largura e o lado
    direito da página abria um vão de mais de mil pixels. A grade tem três
    filhos e só duas colunas, e era o terceiro que quebrava a linha.
  */
  .galeria {
    display: grid;
    gap: var(--fig-e-lg);
    grid-column: 2;
    margin-top: var(--fig-e-2xl);
  }
  /* Ficha `galeria-casa-ip`: spring bounce 0.2 / 0.4s. */
  .galeria :global(img) {
    border-radius: var(--fig-raio-xl);
    display: block;
    height: auto;
    transition: transform var(--dur-galeria-casa-ip) var(--mola-galeria-casa-ip);
    width: 100%;
  }
  .galeria :global(img):hover { transform: scale(1.01); }

  /* ─── Outros projetos ─────────────────────────────────────*/
  .outros {
    margin-inline: auto;
    max-width: var(--fig-largura-conteudo);
    padding: 0 var(--fig-margem-interna) var(--fig-secao-y);
  }
  .outros__cabeca {
    align-items: center;
    display: flex;
    flex-wrap: wrap;
    gap: var(--fig-e-lg);
    justify-content: space-between;
    margin-bottom: var(--fig-e-3xl);
  }
  .outros__titulo {
    color: #000;
    font: var(--fig-peso-forte) clamp(1.75rem, 1.2rem + 1.8vw, 3rem) / 1.2 var(--fig-fonte-corpo);
    margin: 0;
  }
  .outros__botao {
    background: var(--fig-primaria-clara);
    border-radius: var(--fig-raio-xs);
    color: #fff;
    font: var(--fig-peso-forte) var(--fig-t-corpo) / 1.2 var(--fig-fonte-ui);
    min-width: 418px;
    padding: var(--fig-e-sm) var(--fig-e-lg);
    text-align: center;
    text-decoration: none;
  }
  .outros__grade {
    display: grid;
    gap: var(--fig-e-3xl);
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .outros__grade a { color: inherit; display: block; text-decoration: none; }
  /* Ficha `card-projeto-abre`: spring bounce 0.2 / 0.4s. */
  .outros__grade :global(img) { transition: transform var(--dur-card-projeto-abre) var(--mola-card-projeto-abre); }
  .outros__grade a:hover :global(img) { transform: scale(1.02); }
  /* No Figma o card de "Outros Projetos" é DEITADO — mais largo que alto,
     com a legenda logo abaixo. Com 545px de altura numa coluna de 413 ele
     ficava em pé, e o nome do projeto caía longe da foto. */
  .outros__grade :global(img) {
    aspect-ratio: 4 / 3;
    border-radius: var(--fig-raio-lg);
    display: block;
    height: auto;
    object-fit: cover;
    width: 100%;
  }
  .outros__grade h3 {
    color: var(--fig-tinta-suave);
    font: var(--fig-peso-normal) clamp(1.25rem, 1rem + 0.9vw, 1.75rem) / 1.2 var(--fig-fonte-display);
    margin: var(--fig-e-md) 0 0;
  }

  @media (max-width: 1199.98px) {
    .projeto__interno { grid-template-columns: 1fr; gap: var(--fig-e-2xl); }
    .ficha { position: static; }
    .outros__botao { min-width: 0; }
    .outros__grade :global(img) { aspect-ratio: 3 / 2; }
  }
</style>
