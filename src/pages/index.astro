---
import { Image } from 'astro:assets';
import Base from '~/layouts/Base.astro';
import Cabecalho from '~/components/Cabecalho.astro';
import Rodape from '~/components/Rodape.astro';
import Botao from '~/components/Botao.astro';
import Formulario from '~/components/Formulario.astro';
import { site } from '~/lib/site';
import { numerosHome, servicos } from '~/lib/conteudo';

import heroSala from '~/assets/imagens/hero-sala.jpg';
import casaIp from '~/assets/imagens/projeto-casa-ip.jpg';
import studio from '~/assets/imagens/projeto-studio.png';

const projetos = [
  { titulo: 'CASA IP', local: 'Maringá - PR', imagem: casaIp, href: '/projetos/casa-ip' },
  { titulo: 'STUDIO', local: 'Maringá - PR', imagem: studio, href: '/projetos/studio' },
];

const posts = [
  { titulo: 'Minimalismo x Maximalismo: Qual estilo é o seu?', data: '12 de mai. de 2026', href: '/artigos/minimalismo-vs-maximalismo-qual-estilo-combina-com-voce' },
  { titulo: 'Vale mais a pena reformar ou construir?', data: '24 de mar. de 2026', href: '/artigos/vale-mais-a-pena-reformar-ou-construir' },
];
---

<Base titulo={site.nome} descricao={site.descricao}>
  <Cabecalho slot="cabecalho" />

  <!-- ─── Hero ─────────────────────────────────────────── -->
  <section class="hero">
    <Image src={heroSala} alt="Sala de estar integrada com iluminação natural e mobiliário em tons neutros"
      class="hero__imagem" widths={[640, 960, 1440, 1920]} sizes="100vw" loading="eager" fetchpriority="high" />
    <div class="hero__veu"></div>
    <div class="hero__conteudo container">
      <h1 class="hero__titulo">Espaços que refletem<br />quem você realmente é</h1>
      <p class="hero__texto">
        Mais do que criar ambientes bonitos, nosso propósito é dar vida a espaços com alma.
        Do primeiro esboço ao acabamento final, tudo é pensado para refletir sua história e
        estilo de vida.
      </p>
      <div class="hero__acoes">
        <Botao href="/contato" variante="solido">Entrar em contato</Botao>
        <Botao href="/projetos" variante="claro">Explorar Projetos</Botao>
      </div>
    </div>
  </section>

  <!-- ─── Sobre nós ────────────────────────────────────── -->
  <section class="secao container">
    <p class="rotulo">Sobre nós</p>
    <h2 class="bloco__titulo">Mais que Design,<br />Um Estilo de Vida.</h2>
    <p class="bloco__texto">
      Nosso propósito é criar o incomum. Ambientes que emocionam, acolhem e refletem
      autenticidade, traduzindo não apenas estética e funcionalidade, mas também histórias,
      valores e modos de viver. Cada detalhe é pensado para unir beleza e praticidade,
      resultando em espaços que fazem sentido, acolhem quem chega e permanecem impactantes
      com o tempo.
    </p>
    <div class="bloco__acao">
      <Botao href="/sobre" variante="contorno">Saiba mais sobre quem somos</Botao>
    </div>
  </section>

  <!-- ─── Números ──────────────────────────────────────── -->
  <section class="numeros">
    <div class="container numeros__grade">
      {numerosHome.map(({ valor, rotulo }) => (
        <div>
          <p class="numeros__valor">{valor}</p>
          <p class="numeros__rotulo">{rotulo}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- ─── Histórias Recentes ───────────────────────────── -->
  <section class="secao container">
    <!-- NOTA: no site atual este rótulo está escrito "Serviços". Reproduzido igual. -->
    <p class="rotulo">Serviços</p>
    <h2 class="bloco__titulo">Histórias Recentes</h2>

    <ul class="projetos">
      {projetos.map(({ titulo, local, imagem, href }) => (
        <li>
          <a href={href} class="projeto__link">
            <div class="projeto__moldura">
              <Image src={imagem} alt={`Projeto ${titulo}, em ${local}`} class="projeto__imagem"
                widths={[400, 800, 1200]} sizes="(min-width: 60rem) 50vw, 100vw" loading="lazy" />
            </div>
            <div class="projeto__texto">
              <h3 class="projeto__titulo">{titulo}</h3>
              <p class="projeto__local">{local}</p>
            </div>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <!-- ─── Serviços ─────────────────────────────────────── -->
  <section class="servicos">
    <div class="container">
      <p class="rotulo">Serviços</p>
      <h2 class="bloco__titulo">Serviços pensados para você</h2>

      <ul class="servicos__grade">
        {servicos.map(({ tituloCompleto, resumoHome }) => (
          <li class="servico">
            <h3 class="servico__titulo">{tituloCompleto}</h3>
            <p class="servico__texto">{resumoHome}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ─── Contato ──────────────────────────────────────── -->
  <section class="secao container contato">
    <div class="contato__texto">
      <p class="rotulo">Entre em contato</p>
      <h2 class="bloco__titulo">Vamos conversar sobre seu próximo projeto?</h2>
      <p class="bloco__texto">
        Conte um pouco sobre o que você sonha para o seu espaço. Nossa equipe vai preparar
        uma proposta feita sob medida para você.
      </p>
    </div>
    <div class="contato__formulario"><Formulario /></div>
  </section>

  <!-- ─── Blog ─────────────────────────────────────────── -->
  <section class="blog">
    <div class="container">
      <p class="rotulo">Blog</p>
      <h2 class="bloco__titulo">Arquitetura, Design &amp;<br />Mercado</h2>
      <p class="bloco__texto">Dicas e tendências para quem valoriza bons espaços.</p>
      <div class="bloco__acao"><Botao href="/artigos" variante="contorno">Acessar blog</Botao></div>

      <ul class="posts">
        {posts.map(({ titulo, data, href }) => (
          <li class="post">
            <a href={href} class="post__link">
              <h3 class="post__titulo">{titulo}</h3>
              <p class="post__data">{data}</p>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ─── Chamada final ────────────────────────────────── -->
  <section class="chamada">
    <div class="container chamada__interno">
      <p class="rotulo">Contate-nos</p>
      <h2 class="chamada__titulo">Sobrou alguma dúvida?<br />Vamos conversar!</h2>
      <Botao href="/contato" variante="solido">Quero agendar uma reunião</Botao>
    </div>
  </section>

  <Rodape slot="rodape" />
</Base>

<style>
  .hero { position: relative; display: grid; align-items: end; min-height: min(88svh, 46rem); isolation: isolate; overflow: clip; }
  .hero :global(.hero__imagem) { position: absolute; inset: 0; z-index: -2; width: 100%; height: 100%; object-fit: cover; }
  .hero__veu { position: absolute; inset: 0; z-index: -1;
    background: linear-gradient(to top, rgb(23 18 14 / 0.82) 0%, rgb(23 18 14 / 0.55) 38%, rgb(23 18 14 / 0.15) 70%, rgb(23 18 14 / 0.05) 100%); }
  .hero__conteudo { padding-block: var(--esp-xl) var(--esp-2xl); }
  .hero__titulo { color: #fff; font-size: var(--texto-3xl); font-weight: var(--peso-semi); max-width: 18ch; }
  .hero__texto { color: color-mix(in srgb, #fff 86%, transparent); max-width: 48ch; margin-block-start: var(--esp-md); font-size: var(--texto-md); }
  .hero__acoes { display: flex; flex-wrap: wrap; gap: var(--esp-xs); margin-block-start: var(--esp-lg); }

  .bloco__titulo { margin-block-start: var(--esp-2xs); max-width: 20ch; }
  .bloco__texto { max-width: var(--largura-texto); margin-block-start: var(--esp-md); color: var(--cor-texto-suave); }
  .bloco__acao { margin-block-start: var(--esp-lg); }

  .numeros { background-color: var(--cor-fundo-alt); padding-block: var(--esp-xl); }
  .numeros__grade { display: grid; gap: var(--esp-lg); text-align: center; }
  .numeros__valor { font-family: var(--fonte-titulo); font-size: var(--texto-2xl); font-weight: var(--peso-semi); color: var(--cor-tinta); line-height: 1; }
  .numeros__rotulo { margin-block-start: var(--esp-2xs); font-size: var(--texto-sm); color: var(--cor-texto-suave); max-width: 22ch; margin-inline: auto; }

  .projetos { list-style: none; margin: var(--esp-lg) 0 0; padding: 0; display: grid; gap: var(--esp-md); }
  .projeto__link { text-decoration: none; display: block; }
  .projeto__moldura { overflow: clip; border-radius: var(--raio-lg); aspect-ratio: 4 / 5; background-color: var(--cor-fundo-alt); }
  .projetos :global(.projeto__imagem) { width: 100%; height: 100%; object-fit: cover; transition: transform var(--transicao-suave); }
  .projeto__link:hover :global(.projeto__imagem) { transform: scale(1.04); }
  .projeto__texto { display: flex; align-items: baseline; justify-content: space-between; gap: var(--esp-sm); padding-block-start: var(--esp-sm); }
  .projeto__titulo { font-size: var(--texto-md); letter-spacing: var(--entre-letras-caixa); }
  .projeto__local { font-size: var(--texto-sm); color: var(--cor-texto-suave); }

  .servicos { background-color: var(--cor-fundo-alt); padding-block: var(--secao-y); }
  .servicos__grade { list-style: none; margin: var(--esp-lg) 0 0; padding: 0; display: grid; gap: var(--esp-lg); }
  .servico { border-top: 1px solid var(--cor-borda); padding-block-start: var(--esp-sm); }
  .servico__titulo { font-size: var(--texto-lg); margin-block-end: var(--esp-2xs); }
  .servico__texto { font-size: var(--texto-sm); color: var(--cor-texto-suave); }

  .contato { display: grid; gap: var(--esp-xl); }

  .blog { padding-block: var(--secao-y); }
  .posts { list-style: none; margin: var(--esp-xl) 0 0; padding: 0; display: grid; gap: var(--esp-md); }
  .post { border-top: 1px solid var(--cor-borda); padding-block-start: var(--esp-sm); }
  .post__link { text-decoration: none; display: block; }
  .post__titulo { font-size: var(--texto-md); transition: color var(--transicao-rapida); }
  .post__link:hover .post__titulo { color: var(--cor-acento-escuro); }
  .post__data { font-size: var(--texto-sm); color: var(--cor-texto-suave); margin-block-start: var(--esp-3xs); }

  .chamada { padding-block: var(--secao-y); background-color: var(--cor-fundo-alt); }
  .chamada__interno { text-align: center; }
  .chamada__titulo { margin-block: var(--esp-2xs) var(--esp-lg); }

  @media (min-width: 40rem) {
    .numeros__grade { grid-template-columns: repeat(4, 1fr); }
    .projetos { grid-template-columns: repeat(2, 1fr); }
    .servicos__grade { grid-template-columns: repeat(2, 1fr); gap: var(--esp-lg) var(--esp-xl); }
    .posts { grid-template-columns: repeat(2, 1fr); gap: var(--esp-xl); }
  }
  @media (min-width: 60rem) {
    .contato { grid-template-columns: 1fr 1.2fr; gap: var(--esp-2xl); align-items: start; }
  }
</style>
