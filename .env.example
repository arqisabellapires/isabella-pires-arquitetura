# ─── Brevo (e-mail transacional do formulário de contato) ───
# Painel: https://app.brevo.com → SMTP & API → API Keys → Create a new API key (v3)
BREVO_API_KEY=
# Remetente verificado na Brevo (precisa validar o domínio/e-mail lá antes de enviar)
BREVO_REMETENTE_EMAIL=contato@isabellapiresarquitetura.com.br
BREVO_REMETENTE_NOME=Site Isabella Pires
# Para onde os contatos do formulário são encaminhados
BREVO_DESTINO_EMAIL=

# ─── Google Analytics 4 ───
# Painel: https://analytics.google.com → Admin → Fluxos de dados → ID da métrica
PUBLIC_GA4_ID=

# ─── Microsoft Clarity ───
# Painel: https://clarity.microsoft.com → Settings → Overview → Project ID
PUBLIC_CLARITY_ID=

# ─── Supabase (só a partir da Fase 5 — CMS) ───
# Painel: https://supabase.com/dashboard → Project Settings → API
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ═══════════════════════════════════════════════════════════
#  INFRAESTRUTURA — credenciais que eu (agente) uso para
#  versionar e publicar. Cole o valor cru depois do "=",
#  sem aspas e sem espaços. Exemplo:
#      GH_TOKEN=ghp_AbC123...
# ═══════════════════════════════════════════════════════════

# ─── GitHub ───
# Criar em: https://github.com/settings/tokens
#   "Tokens (classic)" → Generate new token (classic)
#   Escopos necessários: repo, workflow
#   (ou fine-grained com permissão Contents: Read and write)
GH_TOKEN=
GITHUB_USUARIO=arqisabellapires
GITHUB_REPO=isabella-pires-arquitetura

# ─── Vercel ───
# Criar em: https://vercel.com/account/settings/tokens
#   Create Token → escopo da conta DELA → validade "No expiration"
VERCEL_TOKEN=
# Preenchidos automaticamente no primeiro deploy — pode deixar em branco
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=

# ─── registro.br ───
# Não tem API pública para apontamento; o DNS é feito no painel, a mão.
# Deixo as instruções prontas na Fase 4.

# ─── Supabase: senha do banco (só Fase 5) ───
# Painel: Project Settings → Database → Database password
SUPABASE_DATABASE_PASSWORD=
