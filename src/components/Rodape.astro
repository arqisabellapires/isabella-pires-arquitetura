---
import { navegacao, site } from '~/lib/site';
const ano = new Date().getFullYear();
---

<footer class="rodape">
  <div class="container rodape__interno">
    <div class="rodape__marca">
      <p class="rodape__nome">{site.nomeCurto}</p>
      <p class="rodape__frase">{site.descricao}</p>
    </div>

    <nav class="rodape__nav" aria-label="Navegação do rodapé">
      <p class="rotulo rodape__rotulo">Navegue</p>
      <ul>
        {navegacao.map(({ rotulo, href }) => <li><a href={href}>{rotulo}</a></li>)}
      </ul>
    </nav>

    <div class="rodape__contato">
      <p class="rotulo rodape__rotulo">Contato</p>
      <ul>
        {site.email && <li><a href={`mailto:${site.email}`}>{site.email}</a></li>}
        {site.telefone && <li><a href={`tel:${site.telefone.replace(/\D/g, '')}`}>{site.telefone}</a></li>}
        {site.redes.instagram && <li><a href={site.redes.instagram} rel="me noopener" target="_blank">Instagram</a></li>}
      </ul>
    </div>
  </div>

  <div class="container rodape__base">
    <p>© {ano} {site.nome}. Todos os direitos reservados.</p>
  </div>
</footer>

<style>
  .rodape {
    margin-block-start: var(--secao-y);
    padding-block-start: var(--esp-xl);
    background-color: var(--cor-fundo-escuro);
    color: color-mix(in srgb, var(--cor-sobre-escuro) 78%, transparent);
    font-size: var(--texto-sm);
  }

  .rodape__interno {
    display: grid;
    gap: var(--esp-lg);
    padding-block-end: var(--esp-xl);
  }

  .rodape__nome {
    font-family: var(--fonte-titulo);
    font-size: var(--texto-lg);
    color: var(--cor-sobre-escuro);
    letter-spacing: var(--entre-letras-caixa);
    text-transform: uppercase;
  }
  .rodape__frase {
    margin-block-start: var(--esp-2xs);
    max-width: 34ch;
    line-height: var(--altura-corpo);
  }

  .rodape__rotulo {
    color: color-mix(in srgb, var(--cor-sobre-escuro) 55%, transparent);
    margin-block-end: var(--esp-xs);
  }

  .rodape ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--esp-2xs);
  }
  .rodape a {
    text-decoration: none;
    color: inherit;
    transition: color var(--transicao-rapida);
  }
  .rodape a:hover { color: var(--cor-acento-suave); }

  .rodape__base {
    padding-block: var(--esp-sm);
    border-top: 1px solid color-mix(in srgb, var(--cor-sobre-escuro) 12%, transparent);
    font-size: var(--texto-xs);
    color: color-mix(in srgb, var(--cor-sobre-escuro) 55%, transparent);
  }

  @media (min-width: 48rem) {
    .rodape__interno {
      grid-template-columns: 2fr 1fr 1fr;
      gap: var(--esp-xl);
    }
  }
</style>
