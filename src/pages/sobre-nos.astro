---
/**
 * Sobre nós — reconstruída contra o Figma (node 1:1363), medidas em
 * `_figma/sobre-medidas.json`.
 *
 * É a tela mais rica do design, e a que estava mais longe: faltavam **duas
 * seções inteiras** (a timeline do método, 01–04, e o feed do Instagram) e a
 * página não tinha uma única imagem — o design pede seis.
 *
 * Uma correção de leitura que vale registrar, porque uma medição anterior
 * errou: **"Nossos valores" não é acordeão.** São três linhas sempre
 * abertas, separadas por divisores de 2px, sobre uma faixa
 * rgba(240,217,199,.2). O acordeão de verdade é a seção "Nós entregamos
 * apenas o nosso melhor", com os cinco serviços — e esse é feito com
 * <details>, recurso nativo, sem JavaScript.
 *
 * Os textos vêm de `conteudo.ts`, transcritos do próprio Figma.
 */
import Base from '~/layouts/Base.astro';
import Cabecalho from '~/components/Cabecalho.astro';
import Rodape from '~/components/Rodape.astro';
import Wordmark from '~/components/Wordmark.astro';
import Migalhas from '~/components/Migalhas.astro';
import RotuloSecao from '~/components/RotuloSecao.astro';
import FeedInstagram from '~/components/FeedInstagram.astro';
import { servicos, selosSobre, valores, passosMetodo } from '~/lib/conteudo';
import '~/styles/cabeca-pagina.css';

const fotosInstagram = [
  '/imagens/figma/sobre--unsplash-gwd-zp-xup-ms0.webp',
  '/imagens/figma/sobre--unsplash-gwd-zp-xup-ms1.webp',
  '/imagens/figma/sobre--unsplash-gwd-zp-xup-ms2.webp',
  '/imagens/figma/sobre--unsplash-gwd-zp-xup-ms3.webp',
];
---

<Base
  titulo="Sobre nós"
  descricao="Conheça o escritório de Isabella Pires: arquitetura e design de interiores em Maringá, com projetos que unem estética, funcionalidade e personalidade."
>
  <Cabecalho slot="cabecalho" />

  <header class="cabeca">
    <div class="cabeca__interno">
      <Migalhas itens={[{ rotulo: 'Início', href: '/' }, { rotulo: 'Sobre nós' }]} />
      <h1 class="cabeca__titulo">Sobre nós</h1>
    </div>
    <img class="cabeca__selo" src="/imagens/figma/selo-marca.webp" alt="" width="328" height="328" loading="lazy" />
  </header>

  <section class="historia" data-revela>
    <img
      class="historia__foto"
      src="/imagens/figma/sobre--foto2911.webp"
      alt="Isabella Cito Pires, arquiteta responsável pelo escritório"
      width="349"
      height="524"
    />
    <div class="historia__texto">
      <RotuloSecao>Quem somos</RotuloSecao>
      <h2 class="titulo-secao">Nossa História</h2>
      <p class="paragrafo">
        No nosso escritório, conduzido por Isabella Cito Pires, transformamos ideias em
        projetos arquitetônicos e de interiores que unem estética, funcionalidade e
        personalidade. Cada espaço é planejado para valorizar o estilo de vida e criar
        ambientes únicos.
      </p>
      <p class="paragrafo">
        Oferecemos também consultorias e ambientações personalizadas, garantindo soluções
        práticas e duradouras, sempre com atenção aos desejos e necessidades de cada cliente.
      </p>
      <blockquote class="historia__citacao">
        “Arquitetura é a arte de transformar espaços em experiências inesquecíveis”
      </blockquote>
    </div>

    {/* No Figma (1:1391–1:1392) os três diferenciais são uma COLUNA à
        direita do texto, separada por uma barra vertical de 3px, com um
        traço horizontal sob cada item. Estavam numa faixa horizontal
        abaixo da seção. */}
    <div class="selos" aria-label="Nossos diferenciais">
      {selosSobre.map((s) => (
        <div class="selo">
          <h3 class="selo__titulo">{s.titulo}</h3>
          <p class="selo__texto">{s.texto}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="valores" data-revela>
    <div class="valores__interno">
      <RotuloSecao>Princípios que nos movem</RotuloSecao>
      <h2 class="titulo-secao">Nossos valores</h2>
      <dl class="valores__lista">
        {valores.map((v) => (
          <div class="valor">
            <dt class="valor__titulo">{v.titulo}</dt>
            <dd class="valor__texto">{v.texto}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <section class="entrega" data-revela>
    <h2 class="entrega__titulo">Nós entregamos apenas o nosso melhor</h2>
    <div class="entrega__linha">
      <div class="acordeao">
        {/* `name` compartilhado: o navegador fecha os outros sozinho, que é o
            comportamento do Framer — um aberto por vez, sem JavaScript. */}
        {servicos.map((s, i) => (
          <details class="acordeao__item" name="servico-sobre" open={i === 1}>
            <summary class="acordeao__rotulo">
              {s.tituloCompleto}
              <img class="acordeao__seta" src="/icones/seta-baixo.svg" alt="" width="32" height="32" />
            </summary>
            <p class="acordeao__texto">{s.resumoHome}</p>
          </details>
        ))}
      </div>
      <img
        class="entrega__foto"
        src="/imagens/figma/sobre--unsplash-gwd-zp-xup-ms0.webp"
        alt=""
        width="953"
        height="724"
        loading="lazy"
      />
    </div>
  </section>

  {/*
    O `data-revela` saiu da <section> e desceu para o cabeçalho e a lista.
    Motivo: `revela.css` anima `transform`, e um ancestral transformado vira o
    bloco de contenção do `position: sticky` — o cabeçalho grudava dentro da
    seção em vez de na janela, e se soltava no meio da rolagem. Medido: com o
    `data-revela` na seção, o topo ia de 130px para -222px; sem ele, fica.
  */}
  <section class="metodo">
    <header class="metodo__cabeca">
      <div data-revela>
        <RotuloSecao>Passo a passo</RotuloSecao>
        <h2 class="titulo-secao">Nós temos um método simples,<br />mas rápido e efetivo</h2>
      </div>
    </header>
    <ol class="metodo__lista" data-revela-filhos>
      {passosMetodo.map((p, i) => (
        <li class:list={['passo', i % 2 === 1 && 'passo--direita']}>
          <span class="passo__numero" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          <div>
            <h3 class="passo__titulo">{p.titulo}</h3>
            <p class="passo__texto">{p.texto}</p>
          </div>
        </li>
      ))}
    </ol>
  </section>

  <FeedInstagram fotos={fotosInstagram} />

  <div slot="rodape">
    <Wordmark />
    <Rodape />
  </div>
</Base>

<style>

  .titulo-secao {
    color: var(--fig-tinta);
    font: var(--fig-peso-forte) var(--fig-f-titulo-secao) / 1.21 var(--fig-fonte-corpo);
    margin: 0;
    text-wrap: balance;
  }
  .paragrafo {
    color: rgb(48 48 48 / 0.8);
    font: var(--fig-peso-semi) var(--fig-f-corpo) / var(--fig-altura-solta) var(--fig-fonte-corpo);
    margin: 0;
  }

  /* ─── Nossa História ──────────────────────────────────────*/
  .historia {
    align-items: center;
    display: flex;
    gap: 68px;
    justify-content: center;
    margin-inline: auto;
    max-width: var(--fig-largura-conteudo);
    padding: var(--fig-e-6xl) var(--fig-margem-interna) var(--fig-e-4xl);
  }
  .historia__foto {
    border-radius: var(--fig-raio-xl);
    flex: none;
    height: 524px;
    object-fit: cover;
    width: 349px;
  }
  .historia__texto {
    display: flex;
    flex-direction: column;
    gap: var(--fig-e-lg);
    max-width: 705px;
  }
  .historia__citacao {
    border-left: 6px solid #8d7252;
    color: var(--fig-primaria-media);
    font: italic var(--fig-peso-semi) var(--fig-f-corpo) / 1.5 var(--fig-fonte-corpo);
    margin: 0;
    padding-left: var(--fig-e-md);
  }

  /* ─── Selos ───────────────────────────────────────────────*/
  /* Coluna de 389px à direita do texto, com a barra de 3px do design
     fazendo a separação (node 1:1391). */
  .selos {
    border-left: 3px solid var(--fig-primaria-ativa);
    display: flex;
    flex: none;
    flex-direction: column;
    gap: 42px;
    padding: var(--fig-e-2xl) 0 var(--fig-e-2xl) var(--fig-e-2xl);
    width: 389px;
  }
  /* Traço horizontal sob cada item, como no design — o último também
     tem, então não é separador entre itens. */
  .selo { border-bottom: 1px solid var(--fig-borda); padding-bottom: var(--fig-e-lg); }
  /* Faberge 32px no título e 24px no apoio (1:1394/1:1395). */
  .selo__titulo {
    color: var(--fig-primaria-ativa);
    font: var(--fig-peso-normal) var(--fig-t-rodape-col) / 1.1 var(--fig-fonte-display);
    margin: 0 0 14px;
  }
  .selo__texto {
    color: rgb(72 59 42 / 0.83);
    font: var(--fig-peso-normal) var(--fig-t-rotulo) / 1.2 var(--fig-fonte-display);
    margin: 0;
  }

  /* ─── Nossos valores ──────────────────────────────────────
     Três linhas sempre abertas, com divisor de 2px. Não é acordeão. */
  .valores {
    background: var(--fig-veu-destaque);
    margin-block: var(--fig-secao-y);
    padding: var(--fig-e-4xl) var(--fig-margem-interna);
  }
  .valores__interno {
    display: flex;
    flex-direction: column;
    gap: var(--fig-e-3xl);
    margin-inline: auto;
    max-width: var(--fig-largura-conteudo);
  }
  .valores__lista { display: flex; flex-direction: column; margin: 0; }
  .valor {
    align-items: flex-start;
    border-top: 2px solid var(--fig-primaria-clara);
    display: flex;
    gap: var(--fig-e-2xl);
    justify-content: space-between;
    padding: var(--fig-e-lg) 0;
  }
  .valor:last-child { border-bottom: 2px solid var(--fig-primaria-clara); }
  .valor__titulo {
    color: #8d7252;
    flex: none;
    font: var(--fig-peso-forte) clamp(1.5rem, 1rem + 1.6vw, 2.5rem) / 1.15 var(--fig-fonte-corpo);
    width: min(38%, 400px);
  }
  .valor__texto {
    color: var(--fig-texto);
    font: var(--fig-peso-medio) var(--fig-f-corpo) / var(--fig-altura-solta) var(--fig-fonte-corpo);
    margin: 0;
    max-width: 700px;
  }

  /* ─── Acordeão de serviços ────────────────────────────────
     <details> nativo: abre sem JavaScript. A mola vem da ficha
     `acordeao-servicos`, medida no Framer vivo. */
  .entrega {
    margin-inline: auto;
    max-width: var(--fig-largura-conteudo);
    padding: 0 var(--fig-margem-interna) var(--fig-secao-y);
  }
  .entrega__titulo {
    color: var(--fig-cinza-900);
    font: var(--fig-peso-normal) clamp(2rem, 1rem + 3.6vw, 4.5rem) / 1.15 var(--fig-fonte-corpo);
    margin: 0 0 var(--fig-e-2xl);
    text-align: center;
    text-wrap: balance;
  }
  .entrega__linha { display: flex; gap: var(--fig-e-4xl); align-items: center; }
  /* min-width fixo somado ao flex-basis da foto estourava a linha em
     1440px. Percentual nos dois lados não estoura em largura nenhuma. */
  .acordeao { display: flex; flex: 1 1 46%; flex-direction: column; gap: var(--fig-e-md); min-width: 0; }
  /* Sem `display` próprio: qualquer valor diferente do padrão tira do
     <details> o controle nativo do conteúdo, e os cinco textos aparecem
     mesmo com um só aberto. */
  .acordeao__item {
    border: 1px solid #d9cfc6;
    border-radius: 14px;
    padding: var(--fig-e-md) var(--fig-e-lg);
    transition:
      background var(--dur-acordeao-servicos) var(--mola-acordeao-servicos),
      border-color var(--dur-acordeao-servicos) var(--mola-acordeao-servicos);
  }
  /* Fechado é claro com borda fina; aberto é pêssego sem borda. No Framer é
     esse contraste que mostra qual está aberto — antes todos eram pêssego. */
  .acordeao__item[open] {
    background: var(--fig-veu-acordeao);
    border-color: transparent;
  }
  .acordeao__item:not([open]):hover { border-color: #b9a894; }
  .acordeao__rotulo {
    align-items: center;
    color: var(--fig-cinza-900);
    cursor: pointer;
    display: flex;
    font: var(--fig-peso-normal) var(--fig-f-corpo) / 1.3 var(--fig-fonte-corpo);
    gap: var(--fig-e-lg);
    justify-content: space-between;
    list-style: none;
  }
  .acordeao__rotulo::-webkit-details-marker { display: none; }
  .acordeao__seta {
    flex: none;
    transition: transform var(--dur-acordeao-servicos) var(--mola-acordeao-servicos);
  }
  /* A seta aponta para baixo quando fechado e para cima quando aberto. O
     ícone seta-baixo.svg já aponta para baixo, então quem gira é o aberto. */
  .acordeao__seta { transform: rotate(0deg); }
  .acordeao__item[open] .acordeao__seta { transform: rotate(180deg); }
  .acordeao__texto {
    color: var(--fig-texto);
    font: var(--fig-peso-medio) var(--fig-t-meta) / var(--fig-altura-solta) var(--fig-fonte-corpo);
    margin: var(--fig-e-sm) 0 0;
  }
  .entrega__foto {
    border-radius: var(--fig-raio-xl);
    flex: 1 1 54%;
    height: 724px;
    max-width: 100%;
    min-width: 0;
    object-fit: cover;
  }

  /* ─── Método ──────────────────────────────────────────────*/
  /*
    Duas colunas, com o cabeçalho FIXO à direita enquanto os passos 01–04
    rolam à esquerda. Medido no vídeo
    `_capturas/_videos/sobre-nos.desktop.reveal-entrada.webm`: entre 10,8s e
    12,2s o bloco "Passo a passo / Nós temos um método simples" permanece na
    mesma posição da janela enquanto 01→02 e depois 03→04 passam por ele.

    A geometria vem de `_capturas/sobre-nos/medidas.desktop.json`: os passos
    ocupam x=132..753 e o cabeçalho começa em x=785 — daí as duas colunas.
    Os passos vão de y=3458 a y=4644, ou seja, o cabeçalho fica preso por
    ~1200px de rolagem.

    Atenção: `position: sticky` só funciona se NENHUM ancestral tiver
    `overflow` diferente de `visible`. Por isso o grude vive na coluna, e não
    na seção.
  */
  .metodo {
    margin-inline: auto;
    max-width: var(--fig-largura-conteudo);
    padding: 0 var(--fig-margem-interna) var(--fig-secao-y);
  }
  @media (min-width: 1200px) {
    .metodo {
      align-items: start;
      display: grid;
      /* 621px de passos + 555px de cabeçalho, na proporção do Framer. */
      grid-template-columns: minmax(0, 648fr) minmax(0, 555fr);
      column-gap: var(--fig-e-2xl);
    }
    /* O cabeçalho é a 2ª coluna, mas vem antes no HTML: leitor de tela e
       teclado continuam ouvindo o título antes da lista que ele descreve. */
    .metodo__cabeca {
      grid-column: 2;
      grid-row: 1;
      position: sticky;
      /* abaixo do menu de 90px, com respiro */
      top: calc(90px + var(--fig-e-2xl));
      margin-bottom: 0;
      /* Sem isto o item de grade se estica até a altura da linha (365px em
         vez dos ~180px do conteúdo), e o grude acaba cedo: o percurso de um
         sticky é `altura da linha − altura do elemento`. Encolhendo o
         cabeçalho, ele acompanha os quatro passos até o fim. */
      align-self: start;
    }
    .metodo__lista { grid-column: 1; grid-row: 1; }
    /* Em duas colunas os passos já não alternam: todos ficam à esquerda. */
    .metodo .passo--direita { margin-left: 0; }
  }
  .metodo__cabeca { display: flex; flex-direction: column; gap: var(--fig-e-sm); margin-bottom: var(--fig-e-2xl); }
  .metodo__lista { display: flex; flex-direction: column; gap: var(--fig-e-md); list-style: none; margin: 0; padding: 0; }
  .passo {
    align-items: flex-start;
    border-bottom: 2px solid var(--fig-borda);
    display: flex;
    gap: var(--fig-e-lg);
    max-width: 648px;
    padding: var(--fig-e-2xl) var(--fig-e-xl);
  }
  /* 02 e 04 vão para a direita, como no design. */
  .passo--direita { margin-left: auto; }
  .passo__numero {
    color: #8d7252;
    flex: none;
    font: var(--fig-peso-forte) clamp(2.5rem, 1.4rem + 3.6vw, 5.625rem) / 1 var(--fig-fonte-corpo);
  }
  .passo--direita .passo__numero { color: var(--fig-primaria-ativa); }
  .passo__titulo {
    color: var(--fig-secundaria-ativa);
    font: var(--fig-peso-forte) clamp(1.25rem, 0.9rem + 1.1vw, 2rem) / 1.2 var(--fig-fonte-ui);
    margin: 0 0 var(--fig-e-xs);
  }
  .passo__texto {
    color: var(--fig-texto-meta);
    font: var(--fig-peso-semi) var(--fig-t-corpo-p) / var(--fig-altura-solta) var(--fig-fonte-corpo);
    margin: 0;
    opacity: 0.85;
  }



  @media (max-width: 1199.98px) {
    .cabeca__selo { display: none; }
    .historia { flex-direction: column; align-items: stretch; gap: var(--fig-e-2xl); }
    .historia__foto { height: 420px; width: 100%; }
    .entrega__linha { flex-direction: column; }
    .entrega__foto { height: 420px; max-width: 100%; width: 100%; }
    .valor { flex-direction: column; gap: var(--fig-e-sm); }
    .valor__titulo { width: auto; }
    .passo, .passo--direita { max-width: 100%; margin-left: 0; }
    }
  @media (max-width: 809.98px) {
    .selos {
      border-left: 0;
      padding: 0;
      width: auto;
      gap: var(--fig-e-lg);
    }
    }
</style>
