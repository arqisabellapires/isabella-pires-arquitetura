---
/**
 * Card de artigo — refeito contra o FRAMER no ar (08/09/2026), medidas em
 * _capturas/framer-blog/.
 *
 * Vale a regra do projeto: no blog, o Framer manda em tudo, forma inclusive.
 * A versão anterior seguia o Figma (card horizontal, 2 por fileira) e o
 * Gabriel pediu para voltar à do Framer.
 *
 * O card é VERTICAL: caixa branca com borda, imagem 400×240 em cima, título,
 * e um rodapé "Categoria • Xmin". Sem data, sem autor, sem resumo e sem
 * "Ler mais" — o Framer não os mostra, e é o que deixa três por fileira.
 *
 * `variante="compacto"` é o mesmo card; a home o usa em três colunas.
 */
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
  artigo: CollectionEntry<'artigos'>;
  minutos: number;
  /** A primeira fileira carrega ansioso; o resto espera o scroll. */
  prioritaria?: boolean;
  variante?: 'horizontal' | 'compacto';
}
const { artigo, minutos, prioritaria = false, variante = 'horizontal' } = Astro.props;
const d = artigo.data;

/* O Framer mostra o tempo de leitura do CMS; o nosso vem da coluna
   tempo_leitura, e cai na conta por palavras quando ela é nula. */
const tempo = d.tempoLeitura ?? minutos;
---

<article class="card" data-variante={variante}>
  <a class="card__link" href={`/artigos/${artigo.id}`}>
    {/* width/height só vão quando a capa é remota (vem do CMS): o <Image>
        exige as duas para não deixar a página pular. Com arquivo local o
        Astro mede sozinho, e passar undefined é inofensivo. */}
    <Image
      class="card__capa"
      src={d.capa}
      alt={d.capaAlt}
      width={d.capaLargura ?? undefined}
      height={d.capaAltura ?? undefined}
      widths={[400, 800]}
      sizes="(min-width: 1200px) 400px, (min-width: 810px) 45vw, 90vw"
      loading={prioritaria ? 'eager' : 'lazy'}
    />
    <div class="card__texto">
      <h2 class="card__titulo">{d.titulo}</h2>
      <p class="card__meta">
        <span>{d.categoria}</span>
        <span class="card__ponto" aria-hidden="true"></span>
        <span>{tempo}min</span>
      </p>
    </div>
  </a>
</article>

<style>
  /* Caixa branca com borda de 1px sobre o creme da página: é ela que
     desenha a grade no Framer. */
  .card {
    background: #ffffff;
    border: 1px solid #ece5de;
    border-radius: 10px;
    overflow: hidden;
    transition: border-color 180ms ease, transform 180ms ease;
  }
  .card:hover { border-color: #d8cabb; transform: translateY(-2px); }

  .card__link {
    color: inherit;
    display: flex;
    flex-direction: column;
    height: 100%;
    text-decoration: none;
  }

  /* 400×240 no Framer, com 20px de folga dentro da caixa. A proporção é
     mantida por aspect-ratio para o card ficar nos 439px de lá em qualquer
     largura de coluna. */
  .card :global(.card__capa) {
    aspect-ratio: 360 / 240;
    border-radius: 6px;
    display: block;
    height: auto;
    margin: 20px 20px 0;
    object-fit: cover;
    width: calc(100% - 40px);
  }

  /* min-height fecha a conta dos 439px: 240 de foto + 20 de folga acima +
     o texto. Sem ele, cards de título curto encolhem e a fileira desalinha. */
  .card__texto {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 10px;
    min-height: 132px;
    padding: 18px 20px 20px;
  }

  /* 17px Mulish bold: o título ocupa até duas linhas e o card mantém a
     altura de 439px que o Framer tem. */
  .card__titulo {
    color: var(--fig-primaria-ativa);
    font: var(--fig-peso-forte) 17px/1.35 var(--fig-fonte-corpo);
    margin: 0;
    text-wrap: pretty;
  }

  /* "Categoria • 6min", cinza, colado no pé do card. */
  .card__meta {
    align-items: center;
    color: #8b8178;
    display: flex;
    flex-wrap: wrap;
    font: var(--fig-peso-medio) 14px/1.4 var(--fig-fonte-corpo);
    gap: 8px;
    margin: auto 0 0;
  }
  .card__ponto {
    background: currentColor;
    border-radius: 50%;
    display: block;
    height: 4px;
    width: 4px;
  }

  @media (max-width: 809.98px) {
    .card :global(.card__capa) { height: 200px; }
  }
</style>
