---
/**
 * Cabeçalho — valores medidos em _capturas/home/medidas.<bp>.json (y < 80).
 *
 * Marca "ISABELLA PIRES" 16px/700 Mulish branco em x=152 no desktop, 14px em
 * x=73 nos outros dois. Os seis links são 15px/500 Inter, branco, e existem
 * **só no desktop** — em tablet e mobile viram menu, exatamente como a ficha
 * `menu-celular` mede.
 *
 * A altura aberta do menu é 519px, MEDIDA no Framer vivo. O `variantes.json`
 * diz 223 e está errado: as classes framer-v-* não sobrevivem a uma
 * republicação (HANDOFF §6.9 e a correção 3 do §0). Medida manda.
 *
 * O estado é atributo `data-estado`, nunca classe gerada pelo Framer — é
 * regra da spec §4.4.
 */
import { navegacao, site } from '~/lib/site';

interface Props {
  /** Sobre hero escura o cabeçalho começa transparente e claro. */
  sobreHero?: boolean;
}
const { sobreHero = false } = Astro.props;
const atual = Astro.url.pathname.replace(/\/$/, '') || '/';
const estaAtiva = (href: string) =>
  href === '/' ? atual === '/' : atual === href || atual.startsWith(`${href}/`);
---

<header class:list={['cabecalho', sobreHero && 'cabecalho--sobre-hero']} data-estado="fechado">
  <div class="cabecalho__interno">
    <a href="/" class="cabecalho__marca">{site.nomeCurto.toUpperCase()}</a>

    <nav class="cabecalho__nav" aria-label="Navegação principal">
      <ul class="cabecalho__lista">
        {navegacao.map(({ rotulo, href }) => (
          <li>
            <a href={href} aria-current={estaAtiva(href) ? 'page' : undefined}>{rotulo}</a>
          </li>
        ))}
      </ul>
    </nav>

    <button
      type="button"
      class="cabecalho__alternador"
      aria-expanded="false"
      aria-controls="menu-movel"
      aria-label="Abrir menu"
      data-alternador
    >
      <span class="cabecalho__risco" aria-hidden="true"></span>
      <span class="cabecalho__risco" aria-hidden="true"></span>
    </button>
  </div>

  <nav class="cabecalho__movel" id="menu-movel" aria-label="Navegação principal" hidden>
    <ul>
      {navegacao.map(({ rotulo, href }) => (
        <li>
          <a href={href} aria-current={estaAtiva(href) ? 'page' : undefined}>{rotulo}</a>
        </li>
      ))}
    </ul>
  </nav>
</header>

<script>
  /*
    Menu de celular. Duas travas que a experiência já cobrou:

    1. Nunca chamar preventDefault num clique que caiu num <a href> — foi o
       que quase matou a navegação do site inteiro (HANDOFF §3). Aqui o
       handler está no <button>, então o risco não existe por construção.
    2. `hidden` só sai enquanto o menu está aberto, para o conteúdo não ficar
       alcançável por teclado quando está fechado.
  */
  const cabecalho = document.querySelector<HTMLElement>('.cabecalho');
  const botao = document.querySelector<HTMLButtonElement>('[data-alternador]');
  const menu = document.getElementById('menu-movel');

  if (cabecalho && botao && menu) {
    const alterna = (abrir: boolean) => {
      cabecalho.dataset.estado = abrir ? 'aberto' : 'fechado';
      botao.setAttribute('aria-expanded', String(abrir));
      botao.setAttribute('aria-label', abrir ? 'Fechar menu' : 'Abrir menu');
      menu.hidden = !abrir;
    };

    botao.addEventListener('click', () => {
      alterna(cabecalho.dataset.estado !== 'aberto');
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && cabecalho.dataset.estado === 'aberto') {
        alterna(false);
        botao.focus();
      }
    });
  }
</script>

<style>
  /*
    A cor do cabeçalho depende do que está ATRÁS dele.

    O componente sempre pintou tudo de branco, e a classe
    `cabecalho--sobre-hero` não fazia nada — então nas páginas internas, que
    têm fundo claro, o menu inteiro ficava branco sobre bege: invisível. Foi
    assim que foi parar no preview.

    Agora o padrão é a tinta escura, e o branco só entra sobre o herói
    escuro da home e sobre a foto de capa dos projetos, que é onde ele de
    fato precisa ser claro.
  */
  .cabecalho {
    position: absolute;
    inset: 0 0 auto;
    z-index: 10;
    font-family: 'Inter', system-ui, sans-serif;
    --cabecalho-cor: #21201f;
  }
  .cabecalho--sobre-hero { --cabecalho-cor: #ffffff; }
  .cabecalho__interno {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    margin-inline: auto;
    max-width: 1184px;
    min-height: 59px;
    padding: 25px 24px;
  }
  /* Marca: 16px/700 Mulish no desktop, 14px nos outros — medido. */
  .cabecalho__marca {
    font: 700 16px/1.2 'Mulish', system-ui, sans-serif;
    color: var(--cabecalho-cor);
    letter-spacing: 0.02em;
    text-decoration: none;
  }
  .cabecalho__lista {
    display: flex;
    gap: 20px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .cabecalho__lista a {
    font: 500 15px/1.2 'Inter', system-ui, sans-serif;
    color: var(--cabecalho-cor);
    text-decoration: none;
  }
  .cabecalho__lista a[aria-current='page'] { text-decoration: underline; }

  .cabecalho__alternador {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: 0;
    cursor: pointer;
    padding: 8px;
  }
  .cabecalho__risco {
    display: block;
    width: 22px;
    height: 2px;
    background: var(--cabecalho-cor);
  }

  .cabecalho__movel {
    background: #21201f;
    padding: 24px;
  }
  .cabecalho__movel ul { list-style: none; margin: 0; padding: 0; }
  .cabecalho__movel li { margin-bottom: 16px; }
  .cabecalho__movel a {
    font: 500 18px/1.4 'Inter', system-ui, sans-serif;
    color: #ffffff;
    text-decoration: none;
  }

  /* Os links inline existem só no desktop — medido nos 3 breakpoints. */
  @media (max-width: 1199.98px) {
    .cabecalho__marca { font-size: 14px; }
    .cabecalho__nav { display: none; }
    .cabecalho__alternador { display: flex; }
  }
</style>
