---
import '~/styles/fontes.css';
import '~/styles/tokens.css';
/* Os tokens do Figma entram DEPOIS dos antigos: onde os dois falam da mesma
   coisa, o design manda. Ver docs/PLANO-FIGMA.md. */
import '~/styles/tokens.figma.css';
/* As 17 molas do Framer, viradas em linear() nativo. Gerado; ver
   tools/mola-para-css.mjs. */
import '~/styles/motion.css';
import '~/styles/base.css';

import Seo from '~/components/Seo.astro';
import JsonLd from '~/components/JsonLd.astro';
import { site } from '~/lib/site';

interface Props {
  titulo: string;
  descricao: string;
  imagem?: string;
  tipo?: 'website' | 'article';
  publicadoEm?: Date;
  atualizadoEm?: Date;
  autor?: string;
  noindex?: boolean;
}

const props = Astro.props;
const ga4 = import.meta.env.PUBLIC_GA4_ID;
const clarity = import.meta.env.PUBLIC_CLARITY_ID;
---

<!doctype html>
<html lang={site.idioma}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <!--
      A fonte do corpo entra no caminho crítico; as demais podem esperar.
      Este é o subset latin da Mulish (U+0000-00FF cobre o pt-BR), o mesmo
      arquivo que o Framer servia. O caminho anterior apontava para um nome
      do Google Fonts que não existe em disco e dava 404 — preload de arquivo
      inexistente é pior que preload nenhum: custa uma requisição e ainda
      avisa o navegador que a fonte é urgente.
    -->
    <link
      rel="preload"
      href="/fontes/gstatic/mulish/v18/1Ptvg83HX_SGhgqk3wot.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#fbf7f4" />

    <Seo {...props} />

    {/*
      LocalBusiness em TODA página, com endereço e área atendida. O site não
      tinha nenhum dado estruturado, e sem cidade associada não concorre por
      "arquitetura Maringá" — que a pesquisa de SEO apontou como a única busca
      que ele tem chance real de ganhar.
    */}
    <JsonLd tipo="negocio" />
  </head>

  <body>
    <a class="pular-conteudo" href="#conteudo">Pular para o conteúdo</a>

    <slot name="cabecalho" />

    <main id="conteudo">
      <slot />
    </main>

    <slot name="rodape" />

    {
      ga4 && (
        <script
          is:inline
          async
          src={`https://www.googletagmanager.com/gtag/js?id=${ga4}`}
        />
        <script is:inline define:vars={{ ga4 }}>
          window.dataLayer = window.dataLayer || [];
          function gtag() { window.dataLayer.push(arguments); }
          gtag('js', new Date());
          gtag('config', ga4, { anonymize_ip: true });
        </script>
      )
    }

    {
      clarity && (
        <script is:inline define:vars={{ clarity }}>
          (function (c, l, a, r, i, t, y) {
            c[a] = c[a] || function () { (c[a].q = c[a].q || []).push(arguments); };
            t = l.createElement(r); t.async = 1;
            t.src = 'https://www.clarity.ms/tag/' + i;
            y = l.getElementsByTagName(r)[0]; y.parentNode.insertBefore(t, y);
          })(window, document, 'clarity', 'script', clarity);
        </script>
      )
    }
  </body>
</html>
