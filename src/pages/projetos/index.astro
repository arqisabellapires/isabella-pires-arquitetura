---
/**
 * Listagem de projetos. Medida em _capturas/projetos/medidas.desktop.json:
 * título "Projetos" 60px/600, cards com nome 64px/400 e "Ver projeto"
 * 20px/700, alternando lado.
 *
 * **No desktop são 4 cards empilhados, não carrossel** — o HANDOFF §4.2
 * corrigiu isso medindo: o controlador a6Nde7smU só existe em tablet e
 * mobile. Aqui a grade responsiva cobre os três breakpoints sem script, que
 * é melhor do que reproduzir um carrossel que só existia por limitação de
 * espaço.
 *
 * O hover do card é a ÚNICA interação de hover do site inteiro (medido: 2/18
 * em /projetos/, 0/8 na home). Feito em CSS puro com :hover e :focus-within,
 * como a spec §4.4 manda — sem JavaScript.
 */
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '~/layouts/Base.astro';
import Cabecalho from '~/components/Cabecalho.astro';
import Rodape from '~/components/Rodape.astro';

const projetos = (await getCollection('projetos', ({ data }) => data.publicado !== false)).sort(
  (a, b) => a.data.ordem - b.data.ordem,
);
---

<Base
  titulo="Projetos"
  descricao="Projetos de arquitetura e interiores por Isabella Pires: residenciais, comerciais e reformas em Maringá."
>
  <Cabecalho slot="cabecalho" />

  <div class="projetos">
    <nav class="migalhas" aria-label="Migalhas">
      <a href="/">Início</a> <span aria-hidden="true">/</span> <span>Projetos</span>
    </nav>

    <h1 class="projetos__titulo">Projetos</h1>

    <ul class="projetos__lista">
      {projetos.map((projeto) => (
        <li class="cartao">
          <a class="cartao__link" href={`/projetos/${projeto.id}`}>
            <Image
              class="cartao__imagem"
              src={projeto.data.capa}
              alt={projeto.data.capaAlt}
              widths={[390, 700, 1136]}
              sizes="(min-width: 1200px) 1136px, 100vw"
              loading="lazy"
            />
            <div class="cartao__texto">
              <h2 class="cartao__titulo">{projeto.data.titulo}</h2>
              <p class="cartao__resumo">{projeto.data.resumo}</p>
              <span class="cartao__cta">Ver projeto</span>
            </div>
          </a>
        </li>
      ))}
    </ul>
  </div>

  <Rodape slot="rodape" />
</Base>

<style>
  .projetos { margin-inline: auto; max-width: 1184px; padding: 120px 24px 64px; }
  .migalhas {
    font: 700 16px/1.2 'Mulish', system-ui, sans-serif;
    color: #341f04;
    margin-bottom: 48px;
  }
  .migalhas a { color: inherit; text-decoration: none; }
  .projetos__titulo {
    font: 600 60px/1.1 'Mulish', system-ui, sans-serif;
    color: #21201f;
    margin: 0 0 64px;
  }
  .projetos__lista { display: grid; gap: 64px; list-style: none; margin: 0; padding: 0; }

  .cartao__link {
    color: inherit;
    display: block;
    position: relative;
    text-decoration: none;
  }
  .cartao__imagem {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1136 / 557;
    object-fit: cover;
    border-radius: 12px;
    /*
      557 → 367px é a altura medida do estado de hover no variantes.json.
      A mola do original é spring damping 30 / stiffness 400; aqui a transição
      é de transform, que não força layout.
    */
    transition: transform 0.4s cubic-bezier(0.34, 1.2, 0.64, 1);
  }
  .cartao__link:hover .cartao__imagem,
  .cartao__link:focus-visible .cartao__imagem { transform: scale(1.02); }

  .cartao__texto { padding-top: 24px; }
  .cartao__titulo {
    font: 400 64px/1.05 'Mulish', system-ui, sans-serif;
    color: #21201f;
    margin: 0 0 12px;
  }
  .cartao__resumo {
    font: 600 21px/1.5 'Mulish', system-ui, sans-serif;
    color: #5a5755;
    margin: 0 0 16px;
    max-width: 60ch;
  }
  .cartao__cta {
    font: 700 20px/1.2 'Mulish', system-ui, sans-serif;
    color: #341f04;
    border-bottom: 1px solid currentColor;
  }

  @media (prefers-reduced-motion: reduce) {
    .cartao__imagem { transition: none; }
    .cartao__link:hover .cartao__imagem { transform: none; }
  }
  @media (max-width: 1199.98px) {
    .projetos__titulo { font-size: 44px; }
    .cartao__titulo { font-size: 44px; }
  }
  @media (max-width: 809.98px) {
    .projetos { padding-top: 96px; }
    .projetos__titulo { font-size: 36px; }
    .cartao__titulo { font-size: 32px; }
    .cartao__resumo { font-size: 18px; }
  }
</style>
