---
/**
 * Rodapé — reconstruído contra o Figma (node 1:687 e equivalentes),
 * medidas em `_figma/servicos-medidas.json`.
 *
 * Uma decisão de projeto registrada aqui: **o design mostra o rodapé com
 * quatro fundos diferentes** entre as telas — #a98d67 (Serviços, Sobre nós),
 * #3a2e26 (Blog), #f8efe9 (Contato) e #989694 (Projeto detalhe). Isso é
 * inconsistência do próprio Figma, não do código, e uniformizar é a escolha
 * certa: rodapé que muda de cor a cada página parece defeito, não intenção.
 *
 * **O padrão é o pêssego #f0d9c7, medido no site de referência.**
 *
 * Antes era #3a2e26 escuro, e a razão registrada aqui era de contraste: com
 * fundo caramelo #a98d67 os textos claros davam 2,70:1, abaixo do mínimo. A
 * conclusão estava certa mas a alternativa era falsa — a escolha foi tratada
 * como "caramelo ou escuro", e o site de referência não usa nenhum dos dois:
 * usa o **pêssego**, com o texto ESCURO por cima. Medido em
 * `_capturas/home/medidas.desktop.json`: fundo rgb(240,217,199), títulos
 * rgb(33,32,31) e links rgb(72,59,42).
 *
 * E o contraste passa com folga: #483b2a sobre #f0d9c7 dá 7,99:1, e #21201f
 * dá 11,97:1. Inverter o texto em vez de escurecer o fundo resolve os dois
 * lados — fidelidade e legibilidade.
 *
 * O caramelo continua em `data-variante="caramelo"` e o escuro em
 * `data-variante="escuro"`, mas nenhum dos dois é o padrão.
 *
 * O Figma desenha cinco redes sociais (inclui TikTok e YouTube). O site.ts
 * tem três perfis reais. Ficam as três: perfil que não existe não vira link.
 *
 * As três páginas de política também não existem — no Framer os links
 * apontavam para o vazio. Ficam como texto, não como link quebrado.
 */
import { rodape, site } from '~/lib/site';
import '~/styles/botoes.css';

interface Props {
  /** O padrão é 'pessego', medido na referência. Os outros dois são do
      Figma e ficam disponíveis, mas têm contraste pior. */
  variante?: 'pessego' | 'escuro' | 'caramelo';
}
const { variante = 'pessego' } = Astro.props;

const redes = [
  { nome: 'Instagram', href: site.redes.instagram, icone: '/icones/instagram.svg' },
  { nome: 'Facebook', href: site.redes.facebook, icone: '/icones/facebook.svg' },
  { nome: 'LinkedIn', href: site.redes.linkedin, icone: '/icones/linkedin.svg' },
];
---

<footer class="rodape" data-variante={variante}>
  <div class="rodape__interno">
    <div class="rodape__topo">
      <div class="rodape__cta">
        <p class="rodape__rotulo">Contate-nos</p>
        <p class="rodape__chamada">Sobrou alguma dúvida?<br />Vamos conversar!</p>
        <a class="rodape__botao tem-cara-de-botao" href="/contato">Quero agendar uma reunião</a>
      </div>

      <div class="rodape__colunas">
        <nav class="rodape__coluna" aria-label="Institucional">
          <p class="rodape__coluna-titulo">Institucional</p>
          <ul>
            {rodape.institucional.map(({ rotulo, href }) => (
              <li><a href={href}>{rotulo}</a></li>
            ))}
          </ul>
        </nav>

        <div class="rodape__coluna">
          <p class="rodape__coluna-titulo">Informações</p>
          <ul>
            {rodape.informacoes.map(({ rotulo, href }) => (
              <li>{href ? <a href={href}>{rotulo}</a> : <span>{rotulo}</span>}</li>
            ))}
          </ul>
        </div>
      </div>
    </div>

    <hr class="rodape__divisor" />

    <div class="rodape__base">
      <p class="rodape__copyright">{site.copyright}</p>
      <ul class="rodape__redes">
        {redes.map(({ nome, href, icone }) => (
          <li>
            <a href={href} rel="noopener noreferrer" target="_blank" aria-label={nome}>
              <img src={icone} alt="" width="40" height="40" />
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>
</footer>

<style>
  .rodape {
    background: var(--fig-fundo-pessego);
    color: #21201f;
    /* 52px no topo é o que a referência mede entre a borda do rodapé e o
       "Contate-nos"; com os 100px de antes o rodapé ia a 584 contra 485. */
    padding: var(--fig-e-3xl) var(--fig-margem-interna) var(--fig-e-2xl);
  }
  .rodape[data-variante='caramelo'] { background: var(--fig-primaria-clara); }
  .rodape[data-variante='escuro'] { background: var(--fig-fundo-escuro); }

  .rodape__interno {
    display: flex;
    flex-direction: column;
    gap: var(--fig-e-xl);
    margin-inline: auto;
    max-width: var(--fig-largura-conteudo);
  }
  .rodape__topo {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--fig-e-3xl);
    flex-wrap: wrap;
  }

  .rodape__cta { display: flex; flex-direction: column; gap: var(--fig-e-sm); }
  .rodape__rotulo {
    margin: 0;
    font: var(--fig-peso-semi) var(--fig-t-corpo) / 1.2 var(--fig-fonte-corpo);
    color: #483b2a;
  }
  .rodape__chamada {
    margin: 0 0 var(--fig-e-2xs);
    font: var(--fig-peso-normal) var(--fig-f-subtitulo) / 1.15 var(--fig-fonte-display);
    color: #21201f;
  }
  /* O Gabriel disse que não tinha cara de botão, e não tinha mesmo: era um
     retângulo branco chapado, sem sombra nenhuma. O Framer usa três camadas
     de sombra — uma linha de contato quase colada, uma média, e uma larga e
     fraca. É a de baixo que dá o relevo; as de cima é que dão o assentamento.
     Medida no Framer no ar, com os valores arredondados. */
  .rodape__botao {
    align-self: flex-start;
    background: #fff;
    border-radius: var(--fig-raio-lg);
    box-shadow:
      0 0.6px 0.6px -1.25px rgb(0 0 0 / 0.18),
      0 2.3px 2.3px -2.5px rgb(0 0 0 / 0.16),
      0 10px 10px -3.75px rgb(0 0 0 / 0.06);
    color: var(--fig-primaria-ativa);
    font: var(--fig-peso-semi) var(--fig-t-corpo) / 1.2 var(--fig-fonte-corpo);
    padding: var(--fig-e-md) var(--fig-e-xl);
    text-decoration: none;
    transition:
      box-shadow var(--dur-rodape-por-pagina) var(--mola-rodape-por-pagina),
      transform var(--dur-rodape-por-pagina) var(--mola-rodape-por-pagina);
  }
  /* Sobe um fio e a sombra cresce junto: é o que faz o botão parecer que
     se levanta da página em vez de só clarear. */
  .rodape__botao:hover {
    box-shadow:
      0 1px 1px -1.25px rgb(0 0 0 / 0.2),
      0 4px 4px -2.5px rgb(0 0 0 / 0.18),
      0 14px 16px -3.75px rgb(0 0 0 / 0.1);
    transform: translateY(-2px);
  }
  .rodape__botao:active { transform: translateY(0); }

  @media (prefers-reduced-motion: reduce) {
    .rodape__botao,
    .rodape__botao:hover { transform: none; }
  }

  .rodape__colunas { display: flex; gap: var(--fig-e-7xl); flex-wrap: wrap; }
  .rodape__coluna ul { list-style: none; margin: 0; padding: 0; }
  .rodape__coluna li + li { margin-top: var(--fig-e-sm); }
  .rodape__coluna-titulo {
    margin: 0 0 var(--fig-e-sm);
    /* 32px/700 em Mulish na referência, não Faberge 400. */
    font: var(--fig-peso-forte) var(--fig-t-rodape-col) / 1.2 var(--fig-fonte-corpo);
    color: #21201f;
  }
  .rodape__coluna a,
  .rodape__coluna span {
    font: var(--fig-peso-medio) var(--fig-t-meta) / 1.4 var(--fig-fonte-ui);
    color: #483b2a;
    text-decoration: none;
  }
  .rodape__coluna a:hover { color: #21201f; text-decoration: underline; }

  .rodape__divisor {
    border: 0;
    border-top: 1px solid rgb(255 255 255 / 0.35);
    margin: 0;
    width: 100%;
  }

  .rodape__base {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--fig-e-lg);
    flex-wrap: wrap;
  }
  .rodape__copyright {
    margin: 0;
    font: var(--fig-peso-medio) var(--fig-t-corpo) / 1.2 var(--fig-fonte-ui);
    color: #483b2a;
  }
  .rodape__redes { display: flex; gap: var(--fig-e-sm); list-style: none; margin: 0; padding: 0; }
  .rodape__redes img { display: block; width: 40px; height: 40px; }

  @media (max-width: 809.98px) {
    .rodape__colunas { gap: var(--fig-e-2xl); }
  }
</style>
