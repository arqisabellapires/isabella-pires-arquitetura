---
/**
 * Listagem do blog. Medida em _capturas/artigos/medidas.desktop.json:
 * migalhas "Início / Blog", título "Blog" 60px/600 Mulish, hero
 * 64px/500 Manrope, filtros de categoria em 16px/400 Inter, grade de 3
 * colunas de 283px.
 *
 * **Exceção conhecida e registrada na spec (§8):** esta é a única página que
 * o portão de pixel nunca vai aprovar. A referência do Framer mede altura
 * diferente a cada carregamento (2778, 5073, 5532 px) porque buscava do CMS
 * em runtime. A aceitação dela é só por comparação lado a lado.
 *
 * Os filtros de categoria são links para /artigos/categoria/<slug>, não
 * JavaScript: página estática filtra no build, que é de graça e indexável.
 */
import { getCollection } from 'astro:content';
import Base from '~/layouts/Base.astro';
import Cabecalho from '~/components/Cabecalho.astro';
import Rodape from '~/components/Rodape.astro';
import Wordmark from '~/components/Wordmark.astro';
import Migalhas from '~/components/Migalhas.astro';
import CardArtigo from '~/components/artigos/CardArtigo.astro';
import Newsletter from '~/components/formularios/Newsletter.astro';
import { categorias } from '~/lib/site';
import { minutosDeLeitura, aSlug } from '~/lib/artigos';

const artigos = (await getCollection('artigos', ({ data }) => data.publicado !== false)).sort(
  (a, b) => b.data.publicadoEm.valueOf() - a.data.publicadoEm.valueOf(),
);

const comMinutos = await Promise.all(
  artigos.map(async (artigo) => ({ artigo, minutos: await minutosDeLeitura(artigo) })),
);
---

<Base
  titulo="Blog"
  descricao="Dicas e notícias de arquitetura, interiores e reforma, por Isabella Pires — arquiteta em Maringá."
>
  <Cabecalho slot="cabecalho" />

  <div class="listagem">
    <Migalhas itens={[{ rotulo: 'Início', href: '/' }, { rotulo: 'Blog' }]} />

    {/*
      No blog o Framer manda na FORMA, não só no tamanho (decisão de
      07/09/2026). E lá o herói tem DOIS blocos, não um:
      "Blog" à esquerda, e a manchete centralizada abaixo. Medido em
      _capturas/artigos/medidas.desktop.json.
    */}
    <p class="listagem__rotulo">Blog</p>

    {/* A pill que o Framer tem acima da manchete e nós não tínhamos. */}
    <p class="pill">IsabellaPires Arquitetura</p>

    <h1 class="listagem__manchete">Dicas e notícias para quem realmente se destaca.</h1>

    {/* Filtros à esquerda e busca à direita, na mesma linha, como no Framer. */}
    <div class="barra">
      <nav class="filtros" aria-label="Filtrar por categoria">
        <a class="filtros__item filtros__item--ativo" href="/artigos" aria-current="page">Todos</a>
        {categorias.map((c) => (
          <a class="filtros__item" href={`/artigos/categoria/${aSlug(c)}`}>{c}</a>
        ))}
      </nav>

      {/* Busca só no navegador: filtra os cards já na página, sem recarregar.
          Sem JS o campo some e os filtros de categoria continuam servindo. */}
      <div class="busca" hidden id="busca-caixa">
        <svg class="busca__lupa" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <circle cx="11" cy="11" r="7" /><path d="m21 21-4.3-4.3" />
        </svg>
        <input class="busca__campo" id="busca" type="search" placeholder="Pesquisar" aria-label="Pesquisar artigo pelo título" />
      </div>
    </div>

    <p class="vazio" id="vazio" hidden>Nenhum artigo com esse termo.</p>

    {/*
      O Framer mostra os 24 de uma vez, rolando — não tem "Carregar mais".
      Os três primeiros carregam ansiosos (a primeira fileira), o resto
      espera o scroll.
    */}
    <div class="grade" data-revela-filhos>
      {comMinutos.map(({ artigo, minutos }, i) => (
        <CardArtigo artigo={artigo} minutos={minutos} prioritaria={i < 3} />
      ))}
    </div>

    <Newsletter />
  </div>

  <div slot="rodape">

    <Wordmark />

    <Rodape variante="escuro" />

  </div>
</Base>

<style>
  .listagem {
    margin-inline: auto;
    max-width: var(--fig-largura-conteudo);
    padding: var(--fig-e-4xl) var(--fig-margem-interna) var(--fig-secao-y);
  }
  /* "Blog": 60px Mulish 600, rgb(52,31,4), à esquerda (x=100, y=240 no
     Framer). Continua sendo o rótulo da página, mas não é mais o <h1> —
     quem titula é a manchete abaixo. */
  .listagem__rotulo {
    color: var(--fig-primaria-ativa);
    font: var(--fig-peso-semi) var(--fig-f-titulo-pagina) / 1.2 var(--fig-fonte-corpo);
    margin: var(--fig-e-3xl) 0 0;
  }

  /* Manchete do herói: 64px Manrope 500, tracking -0.06em, entrelinha 110%,
     centralizada, preta, largura ~698px. Medida no Framer (y=491.8).
     A Manrope já estava em fontes.css, servida do próprio domínio — este é o
     primeiro lugar do site que a usa. */
  .listagem__manchete {
    color: #000;
    font: 500 clamp(2rem, 1.1rem + 2.9vw, 4rem) / 1.1 'Manrope', var(--fig-fonte-corpo);
    letter-spacing: -0.06em;
    margin: var(--fig-e-3xl) auto var(--fig-e-2xl);
    max-width: 698px;
    text-align: center;
  }

  /* Pastilhas: a ativa é sólida, as outras têm contorno. Node 1:1108.
     Continuam sendo links por rota — cada categoria tem URL própria, o que
     vale mais para busca do que filtrar no cliente. */
  /* Sem margin-bottom: quem separa da grade agora é a .barra, e a margem
     aqui desalinhava a busca dentro do flex. */
  .filtros {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin: 0;
  }
  /* A pill do topo: fundo bege, cantos redondos, texto pequeno.
     Medida na captura do Framer. */
  .pill {
    align-self: center;
    background: #f0e9e2;
    border-radius: 999px;
    color: var(--fig-primaria-ativa);
    font: 500 13px/1.2 var(--fig-fonte-corpo);
    margin: 0 auto var(--fig-e-lg);
    padding: 7px 14px;
    width: fit-content;
  }

  /* 16px/400 e pílula de 35px no Framer. Estava em --fig-f-corpo (até 20px)
     com peso 600 e padding 12/24, o que deixava os filtros "estourados". */
  .filtros__item {
    background: #fff;
    border: 1px solid var(--fig-primaria-ativa);
    border-radius: var(--fig-raio-sm);
    color: var(--fig-primaria-ativa);
    font: 400 15px/1.2 var(--fig-fonte-corpo);
    padding: 8px 14px;
    text-decoration: none;
    transition: background var(--dur-filtros-categoria-artigos) var(--mola-filtros-categoria-artigos);
  }
  .filtros__item:hover { background: var(--fig-fundo-pessego); }
  .filtros__item--ativo {
    background: var(--fig-primaria-ativa);
    border-color: var(--fig-primaria-ativa);
    color: var(--fig-cinza-50);
  }

  /* Duas por fileira, como no design — não três colunas. */
  /* Filtros e busca na MESMA linha, como no Framer. O flex-wrap deixava a
     busca cair para baixo quando os cinco filtros ocupavam a largura; agora
     os filtros é que quebram entre si, e a busca fica ancorada à direita. */
  .barra {
    align-items: center;
    display: flex;
    gap: var(--fig-e-md);
    justify-content: space-between;
    margin-bottom: var(--fig-e-2xl);
  }
  .barra .filtros { flex: 1 1 auto; min-width: 0; }
  .barra .busca { flex: none; }
  .busca {
    align-items: center;
    background: #ffffff;
    border: 1px solid #ece5de;
    border-radius: 8px;
    display: flex;
    gap: 8px;
    padding: 0 12px;
  }
  .busca__lupa { color: #a89e94; height: 15px; width: 15px; flex: none; }
  .busca__campo {
    background: none;
    border: 0;
    color: var(--fig-primaria-ativa);
    font: 400 14px/1 var(--fig-fonte-corpo);
    padding: 8px 0;
    width: 170px;
  }
  .busca__campo::placeholder { color: #a89e94; }
  .busca__campo:focus-visible { outline: none; }
  .busca:focus-within { border-color: #d8cabb; }

  .vazio {
    color: var(--fig-texto-meta);
    font: var(--fig-peso-medio) 15px/1.5 var(--fig-fonte-corpo);
    margin: 0 0 var(--fig-secao-y);
  }

  /* Três por fileira, como no Framer: cards de 400px com 20px de vão.
     O minmax de 560px que estava aqui vinha do card horizontal do Figma e
     só cabia dois. */
  .grade {
    display: grid;
    gap: 20px;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    margin-bottom: var(--fig-secao-y);
  }
  @media (min-width: 1200px) {
    .grade { grid-template-columns: repeat(3, 1fr); }
  }

  .mais { margin-bottom: var(--fig-secao-y); }
  .mais__botao {
    background: var(--fig-primaria-ativa);
    border-radius: var(--fig-raio-sm);
    color: var(--fig-cinza-50);
    cursor: pointer;
    display: block;
    font: var(--fig-peso-forte) var(--fig-f-corpo) / 1.2 var(--fig-fonte-corpo);
    list-style: none;
    margin-inline: auto;
    padding: var(--fig-e-sm) var(--fig-e-lg);
    text-align: center;
    width: max-content;
  }
  .mais__botao::-webkit-details-marker { display: none; }
  .mais[open] .mais__botao { display: none; }
  .grade--extra { margin-bottom: 0; }

  @media (max-width: 809.98px) {
    .grade { gap: 16px; grid-template-columns: 1fr; }
  }
</style>

<script>
  // Busca só no navegador: os 24 cards já estão no HTML, então filtrar é
  // esconder linha. O campo nasce escondido e aparece aqui — sem JS, os
  // filtros de categoria continuam dando conta.
  const caixa = document.getElementById('busca-caixa');
  const campo = document.getElementById('busca') as HTMLInputElement | null;
  const vazio = document.getElementById('vazio');
  const cards = [...document.querySelectorAll<HTMLElement>('.grade .card')];

  if (caixa && campo && vazio && cards.length) {
    caixa.hidden = false;

    /** Sem acento e em minúsculas, para "iluminacao" achar "Iluminação". */
    const limpa = (t: string) =>
      t.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase();

    const textos = cards.map((c) => limpa(c.innerText));

    campo.addEventListener('input', () => {
      const q = limpa(campo.value.trim());
      let achou = 0;
      cards.forEach((c, i) => {
        const bate = !q || textos[i].includes(q);
        c.hidden = !bate;
        if (bate) achou++;
      });
      vazio.hidden = achou > 0;
    });
  }
</script>
