---
/**
 * O feed do Instagram que fecha as telas de Sobre nós (node 1:1497) e
 * Contato (node 1:1710): o arroba grande à esquerda, o botão caramelo à
 * direita, e os posts embaixo.
 *
 * Os posts são EMBEDS de verdade, como no Framer: ele carrega três iframes
 * de `instagram.com/p/<id>/embed/`. Antes aqui eram imagens soltas do
 * design com um cabeçalho desenhado por cima, que parecia post mas não era
 * — não abria, não atualizava, e o "Ver perfil" era decoração.
 *
 * Os três ids saíram do Framer no ar (08/09/2026). Quando a Isabella
 * publicar algo novo que valha a pena fixar aqui, é só trocar a lista em
 * `src/lib/site.ts`.
 *
 * O iframe é `loading="lazy"`: são três pedidos a um domínio de terceiro, e
 * a seção fica no fim da página. Sem isso o LCP paga por algo que quase
 * ninguém rola até ver.
 */
import { site } from '~/lib/site';
import '~/styles/botoes.css';

interface Props {
  /** Ids dos posts. Sem isto, usa os três do site.ts. */
  posts?: readonly string[];
}
const { posts = site.redes.postsInstagram } = Astro.props;
---

<section class="instagram">
  <header class="instagram__cabeca">
    <p class="instagram__arroba">{site.redes.arroba}</p>
    <a class="instagram__botao tem-cara-de-botao" href={site.redes.instagram} rel="noopener noreferrer" target="_blank">
      Siga-nos no Instagram!
    </a>
  </header>

  <ul class="instagram__posts">
    {posts.map((id) => (
      <li class="instagram__post">
        <iframe
          src={`https://www.instagram.com/p/${id}/embed/`}
          title="Publicação no Instagram de Isabella Pires Arquitetura"
          loading="lazy"
          scrolling="no"
          allowtransparency="true"
          frameborder="0"
        ></iframe>
      </li>
    ))}
  </ul>
</section>

<style>
  .instagram {
    margin-inline: auto;
    max-width: var(--fig-largura-conteudo);
    padding: 0 var(--fig-margem-interna) var(--fig-secao-y);
  }
  .instagram__cabeca {
    align-items: center;
    display: flex;
    flex-wrap: wrap;
    gap: var(--fig-e-lg);
    justify-content: space-between;
    margin-bottom: var(--fig-e-2xl);
  }
  .instagram__arroba {
    color: var(--fig-primaria-ativa);
    font: var(--fig-peso-forte) clamp(1.5rem, 1rem + 2vw, 2.75rem) / 1.2 var(--fig-fonte-corpo);
    margin: 0;
  }
  .instagram__botao {
    background: var(--fig-secundaria-ativa);
    border-radius: var(--fig-raio-sm);
    color: var(--fig-cinza-50);
    font: var(--fig-peso-forte) var(--fig-t-corpo) / 1.2 var(--fig-fonte-corpo);
    padding: var(--fig-e-sm) var(--fig-e-lg);
    text-decoration: none;
    transition: opacity var(--dur-rodape-por-pagina, 0.3s) ease;
  }
  .instagram__botao:hover { opacity: 0.88; }

  .instagram__posts {
    display: grid;
    gap: var(--fig-e-lg);
    grid-template-columns: repeat(3, 1fr);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  /* O embed do Instagram tem altura própria e não se adapta sozinho: a
     proporção fica aqui, e o iframe preenche a caixa. */
  .instagram__post {
    background: #fff;
    border: 1px solid #ece5de;
    border-radius: var(--fig-raio-md);
    overflow: hidden;
    /* O embed pede ~1.28 de altura sobre a largura para caber a legenda. */
    aspect-ratio: 1 / 1.28;
    min-width: 0;
  }
  .instagram__post iframe {
    border: 0;
    display: block;
    height: 100%;
    width: 100%;
  }

  @media (max-width: 1023.98px) {
    .instagram__posts { grid-template-columns: repeat(2, 1fr); }
    /* O terceiro sai quando só cabem dois: meia fileira solta fica pior. */
    .instagram__post:nth-child(3) { display: none; }
  }
  @media (max-width: 599.98px) {
    .instagram__posts { grid-template-columns: 1fr; }
    .instagram__post:nth-child(3) { display: block; }
    .instagram__botao { min-width: 0; }
  }
</style>
