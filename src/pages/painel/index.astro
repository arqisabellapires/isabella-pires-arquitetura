---
/**
 * Lista dos artigos, na forma do CMS do Framer: tabela larga, tema escuro,
 * uma coluna por campo. As capturas do Framer que o Gabriel mandou são a
 * referência — menos o painel "Agent", que ele pediu para não existir.
 *
 * Tudo acontece no navegador, com a chave anônima: a RLS do banco é quem
 * decide o que ela pode ver e mudar. Rascunho só aparece para editor.
 */
import Base from '~/layouts/Base.astro';
import '~/styles/painel.css';
---

<Base titulo="Painel — artigos" descricao="Lista dos artigos do blog." noindex>
  <div class="pnl">
    <header class="pnl-topo">
      <span class="pnl-topo__marca">CMS</span>
      <p class="pnl-topo__nome">Website — Isabella Pires</p>
      <div class="pnl-topo__acoes">
        <a class="pnl-btn" href="/artigos" target="_blank" rel="noopener">Ver o blog</a>
        <button class="pnl-btn" id="sair" type="button">Sair</button>
        <a class="pnl-btn pnl-btn--azul" href="/painel/artigo">Novo artigo</a>
      </div>
    </header>

    <div class="pnl-corpo">
      <aside class="pnl-lado">
        <input class="pnl-lado__busca" id="busca" type="search" placeholder="Buscar…" aria-label="Buscar artigo pelo título" />
        <div class="pnl-lado__item">
          Blog <span class="pnl-lado__conta" id="conta"></span>
        </div>
        <p class="pnl-lado__quem" id="quem"></p>
      </aside>

      <main class="pnl-area">
        <p class="pnl-aviso" id="aviso" role="status" hidden></p>

        <div class="pnl-rolagem">
          <table class="pnl-tabela">
            <thead>
              <tr>
                <th>Título</th>
                <th>Status</th>
                <th>Slug</th>
                <th>Nome</th>
                <th>Categoria</th>
                <th>Data</th>
                <th>Capa</th>
                <th>Tempo de leitura</th>
                <th>Meta Description</th>
                <th>Keywords</th>
                <th>Editado</th>
                <th></th>
              </tr>
            </thead>
            <tbody id="linhas">
              <tr><td class="pnl-tabela__vazio" colspan="12">Carregando…</td></tr>
            </tbody>
          </table>
        </div>
      </main>
    </div>
  </div>
</Base>

<script>
  import { supabase, exigeSessao } from '~/lib/supabase-navegador';

  const linhas = document.getElementById('linhas')!;
  const quem = document.getElementById('quem')!;
  const conta = document.getElementById('conta')!;
  const aviso = document.getElementById('aviso')!;
  const busca = document.getElementById('busca') as HTMLInputElement;

  const sessao = await exigeSessao();
  if (sessao) {
    quem.textContent = sessao.user.email ?? '';

    document.getElementById('sair')!.addEventListener('click', async () => {
      await supabase.auth.signOut();
      window.location.href = '/painel/entrar';
    });

    const escapa = (s: string) =>
      String(s ?? '').replace(/[<>&"]/g, (c) =>
        ({ '<': '&lt;', '>': '&gt;', '&': '&amp;', '"': '&quot;' })[c]!);

    // O `publicado_em` é timestamptz gravado em UTC. Formatar no fuso local
    // do navegador joga o dia para trás (12/05 vira 11/05), então lemos a
    // data em UTC — que é a que a Isabella digitou no editor.
    const dataBR = (iso: string | null) =>
      iso
        ? new Intl.DateTimeFormat('pt-BR', {
            day: '2-digit', month: '2-digit', year: 'numeric', timeZone: 'UTC',
          }).format(new Date(iso))
        : '—';

    /** A capa é gravada como URL completa; só o acervo antigo teria caminho. */
    const urlCapa = (capa: string) =>
      /^https?:\/\//.test(capa)
        ? capa
        : supabase.storage.from('artigos').getPublicUrl(capa).data.publicUrl;

    type Artigo = {
      slug: string; titulo: string; publicado: boolean; publicado_em: string;
      atualizado_em: string | null; categoria: string; autor: string;
      capa: string; capa_alt: string; tempo_leitura: number | null;
      seo_descricao: string | null; tags: string[] | null;
    };

    let todos: Artigo[] = [];

    function desenha(lista: Artigo[]) {
      conta.textContent = String(todos.length);

      if (!lista.length) {
        linhas.innerHTML =
          `<tr><td class="pnl-tabela__vazio" colspan="12">${
            todos.length ? 'Nenhum artigo com esse título.' : 'Nenhum artigo ainda.'
          }</td></tr>`;
        return;
      }

      linhas.innerHTML = lista.map((a) => {
        const editar = `/painel/artigo?slug=${encodeURIComponent(a.slug)}`;
        const chaves = (a.tags ?? []).join(', ');
        return `
        <tr>
          <td><a class="pnl-tabela__titulo" href="${editar}" title="${escapa(a.titulo)}">${escapa(a.titulo)}</a></td>
          <td><span class="pnl-tag ${a.publicado ? 'pnl-tag--live' : 'pnl-tag--draft'}">${a.publicado ? 'Live' : 'Rascunho'}</span></td>
          <td><span class="pnl-tabela__corte" title="${escapa(a.slug)}">${escapa(a.slug)}</span></td>
          <td>${escapa(a.autor)}</td>
          <td>${escapa(a.categoria)}</td>
          <td class="pnl-num">${dataBR(a.publicado_em)}</td>
          <td><img class="pnl-tabela__capa" src="${escapa(urlCapa(a.capa))}" alt="${escapa(a.capa_alt)}" loading="lazy" /></td>
          <td class="pnl-num">${a.tempo_leitura ?? '—'}</td>
          <td><span class="pnl-tabela__corte" title="${escapa(a.seo_descricao ?? '')}">${escapa(a.seo_descricao ?? '—')}</span></td>
          <td><span class="pnl-tabela__corte" title="${escapa(chaves)}">${escapa(chaves || '—')}</span></td>
          <td class="pnl-num">${dataBR(a.atualizado_em)}</td>
          <td><a class="pnl-btn" href="${editar}">Editar</a></td>
        </tr>`;
      }).join('');
    }

    busca.addEventListener('input', () => {
      const q = busca.value.trim().toLowerCase();
      desenha(q ? todos.filter((a) => a.titulo.toLowerCase().includes(q)) : todos);
    });

    async function carrega() {
      const { data, error } = await supabase
        .from('artigos')
        .select('slug, titulo, publicado, publicado_em, atualizado_em, categoria, autor, capa, capa_alt, tempo_leitura, seo_descricao, tags')
        .order('publicado_em', { ascending: false });

      if (error) {
        linhas.innerHTML = '<tr><td class="pnl-tabela__vazio" colspan="12">Não consegui carregar os artigos.</td></tr>';
        return;
      }
      todos = (data ?? []) as Artigo[];
      desenha(todos);
    }

    // Se o build ainda está rodando, avisa — senão ela publica e acha que
    // não funcionou porque o site levou um minuto para atualizar.
    if (new URLSearchParams(location.search).get('publicado') === 'sim') {
      aviso.textContent = 'Artigo salvo. O site atualiza em cerca de um minuto.';
      aviso.hidden = false;
    }

    await carrega();
  }
</script>
