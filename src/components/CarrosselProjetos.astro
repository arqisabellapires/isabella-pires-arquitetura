---
/**
 * "Histórias Recentes" — carrossel de projetos da home (Figma node 1:223).
 *
 * A forma vem da imagem em `_figma/secoes/home-1223-historias-recentes.png`,
 * não das medidas: card central de 817×545 destacado, e as duas peças
 * vizinhas aparecendo cortadas nas bordas com 451px de altura e um véu preto
 * de 20% por cima. Abaixo, as bolinhas de posição (15px, gap 13); e mais
 * abaixo o nome do projeto em Faberge 48px com o local em 30px, ladeado
 * pelas setas ← e → (32×49).
 *
 * A versão anterior desta seção eram três cards empilhados na vertical —
 * mesma altura de página, forma completamente diferente. Daí a regra do
 * handoff: altura não é evidência de fidelidade.
 *
 * Sem JavaScript o carrossel continua legível: é uma lista rolável com
 * scroll-snap, e as setas são âncoras para os slides. O script só troca o
 * estado ativo (destaque, bolinha, legenda) para quem tem JS.
 */
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
  projetos: CollectionEntry<'projetos'>[];
}
const { projetos } = Astro.props;

/*
  O carrossel abre no segundo projeto, não no primeiro.

  No design as duas peças vizinhas aparecem cortadas nas bordas — e isso só
  existe se houver um slide de cada lado do ativo. Abrindo no primeiro, a
  esquerda fica vazia e a seção perde a forma. Com dois ou menos projetos o
  efeito não existe de qualquer jeito, e aí vale abrir no primeiro.
*/
const inicial = projetos.length > 2 ? 1 : 0;
---

<div class="carrossel" data-carrossel>
  <div class="carrossel__janela">
  <ul class="carrossel__trilho" data-trilho>
    {projetos.map((p, i) => (
      <li class="carrossel__slide" id={`slide-${p.id}`} data-slide data-ativo={i === inicial ? '' : undefined}>
        <a href={`/projetos/${p.id}`} class="carrossel__foto">
          <Image
            src={p.data.capa}
            alt={p.data.capaAlt}
            widths={[817, 1634]}
            sizes="(min-width: 1200px) 817px, 90vw"
            loading={i <= inicial + 2 ? 'eager' : 'lazy'}
          />
        </a>
      </li>
    ))}
  </ul>
  </div>

  <ol class="carrossel__bolinhas" data-bolinhas>
    {projetos.map((p, i) => (
      <li>
        <button
          type="button"
          class="carrossel__bolinha"
          data-ir={i}
          data-ativo={i === inicial ? '' : undefined}
          aria-label={`Ir para ${p.data.titulo}`}
        ></button>
      </li>
    ))}
  </ol>

  <div class="carrossel__rodape">
    <button type="button" class="carrossel__seta" data-anterior aria-label="Projeto anterior">
      <svg viewBox="0 0 32 49" width="32" height="49" aria-hidden="true" focusable="false">
        <path d="M30 2 6 24.5 30 47" fill="none" stroke="currentColor" stroke-width="4"
              stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </button>

    {/* Uma legenda só, trocada pelo script — no design há um único par
        título/local por vez, centrado entre as setas. */}
    <p class="carrossel__legenda" data-legenda aria-live="polite">
      <span class="carrossel__titulo" data-titulo>{projetos[inicial]?.data.titulo}</span>
      <span class="carrossel__local" data-local>{projetos[inicial]?.data.local}</span>
    </p>

    <button type="button" class="carrossel__seta" data-proximo aria-label="Próximo projeto">
      <svg viewBox="0 0 32 49" width="32" height="49" aria-hidden="true" focusable="false">
        <path d="M2 2 26 24.5 2 47" fill="none" stroke="currentColor" stroke-width="4"
              stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </button>
  </div>

  {/* O script lê daqui os títulos e locais, para não montar HTML no cliente. */}
  <script type="application/json" data-legendas set:html={JSON.stringify(
    projetos.map((p) => ({ titulo: p.data.titulo, local: p.data.local ?? '' })),
  )} />
</div>

<script>
  /*
    O carrossel move o trilho por `transform`, não por scroll.

    A versão anterior usava scroll-snap: quando o slide ativo mudou de
    largura (675 nos vizinhos, 817 no do meio, como no Framer), o navegador
    recalculava os pontos de encaixe no meio da transição e pulava vários
    projetos de uma vez. Com transform, a posição é calculada por nós e a
    animação é uma só.

    O laço é infinito: os slides são clonados nas duas pontas, e quando a
    viagem chega num clone o trilho salta para o original sem animação —
    o corte é invisível porque as duas posições mostram a mesma imagem.
  */
  document.querySelectorAll<HTMLElement>('[data-carrossel]').forEach((raiz) => {
    const trilho = raiz.querySelector<HTMLElement>('[data-trilho]');
    const originais = [...raiz.querySelectorAll<HTMLElement>('[data-slide]')];
    const bolinhas = [...raiz.querySelectorAll<HTMLElement>('[data-ir]')];
    const elTitulo = raiz.querySelector<HTMLElement>('[data-titulo]');
    const elLocal = raiz.querySelector<HTMLElement>('[data-local]');
    const legendas: { titulo: string; local: string }[] = JSON.parse(
      raiz.querySelector<HTMLElement>('[data-legendas]')?.textContent || '[]',
    );
    if (!trilho || originais.length === 0) return;

    const n = originais.length;
    trilho.removeAttribute('data-desloca');   // o CSS não centra mais nada

    /* Clones nas duas pontas: com um de cada lado o vizinho já existe
       quando se chega à borda, e a volta ao original passa despercebida. */
    const clonesAntes = originais.map((s) => {
      const c = s.cloneNode(true) as HTMLElement;
      c.dataset.clone = '';
      c.removeAttribute('id');
      return c;
    });
    const clonesDepois = clonesAntes.map((c) => c.cloneNode(true) as HTMLElement);
    clonesAntes.forEach((c) => trilho.insertBefore(c, originais[0]));
    clonesDepois.forEach((c) => trilho.appendChild(c));

    const todos = [...raiz.querySelectorAll<HTMLElement>('[data-slide]')];
    /* O índice anda no espaço dos clones: n é o primeiro original. */
    let pos = n + Math.max(0, originais.findIndex((s) => s.hasAttribute('data-ativo')));
    let animando = false;

    const real = () => ((pos - n) % n + n) % n;

    /** Centra o slide `pos` movendo o trilho. */
    function posiciona(comAnimacao: boolean) {
      const alvo = todos[pos];
      if (!alvo) return;
      trilho.dataset.animando = comAnimacao ? '' : 'nao';
      /* O deslocamento é medido do próprio layout: assim a conta continua
         certa quando as larguras mudam com o breakpoint. */
      const centroAlvo = alvo.offsetLeft + alvo.offsetWidth / 2;
      const centroTela = trilho.parentElement!.offsetWidth / 2;
      trilho.style.transform = `translate3d(${centroTela - centroAlvo}px, 0, 0)`;

      todos.forEach((s, i) => s.toggleAttribute('data-ativo', i === pos));
      const r = real();
      bolinhas.forEach((b, i) => b.toggleAttribute('data-ativo', i === r));
      if (elTitulo && legendas[r]) elTitulo.textContent = legendas[r].titulo;
      if (elLocal && legendas[r]) elLocal.textContent = legendas[r].local;
    }

    function anda(passo: number) {
      if (animando) return;
      animando = true;
      pos += passo;
      posiciona(true);
    }

    /* Ao terminar a viagem, se paramos num clone, volta ao original
       equivalente sem animação. */
    trilho.addEventListener('transitionend', (e) => {
      if (e.propertyName !== 'transform') return;
      animando = false;
      if (pos < n || pos >= n * 2) {
        pos = n + real();
        posiciona(false);
        /* Força o reflow antes de devolver a animação, senão o próximo
           passo herda o estado sem transição. */
        void trilho.offsetWidth;
        trilho.removeAttribute('data-animando');
      }
    });

    function irPara(iReal: number) {
      if (animando) return;
      const atual = real();
      let d = iReal - atual;
      /* Vai pelo caminho mais curto: de 3 para 0 anda +1, não -3. */
      if (d > n / 2) d -= n;
      if (d < -n / 2) d += n;
      if (d !== 0) anda(d);
    }

    raiz.querySelector('[data-anterior]')?.addEventListener('click', () => anda(-1));
    raiz.querySelector('[data-proximo]')?.addEventListener('click', () => anda(1));
    bolinhas.forEach((b, i) => b.addEventListener('click', () => irPara(i)));

    /* Arrastar com o dedo. */
    let x0 = 0;
    trilho.addEventListener('pointerdown', (e) => { x0 = e.clientX; });
    trilho.addEventListener('pointerup', (e) => {
      const d = e.clientX - x0;
      if (Math.abs(d) > 45) anda(d < 0 ? 1 : -1);
    });

    /* Setas do teclado, quando o carrossel tem o foco. */
    raiz.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') { e.preventDefault(); anda(1); }
      if (e.key === 'ArrowLeft') { e.preventDefault(); anda(-1); }
    });

    posiciona(false);
    void trilho.offsetWidth;
    trilho.removeAttribute('data-animando');

    /* Ao mudar a largura da janela as medidas mudam; recentra sem animar. */
    let t: number;
    addEventListener('resize', () => {
      clearTimeout(t);
      t = window.setTimeout(() => posiciona(false), 120);
    });
  });
</script>

<style>
  .carrossel {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--fig-e-2xl);
  }

  /* O trilho sangra para fora do conteúdo: é isso que deixa as peças
     vizinhas cortadas nas bordas da tela, como no design. O padding lateral
     de 50% menos meio card centra o primeiro e o último slide. */
  /* O trilho não rola: ele é movido por transform pelo script. O contêiner
     é que esconde o excesso, e as peças vizinhas aparecem cortadas nas
     bordas da tela, como no design. */
  .carrossel__janela {
    overflow: hidden;
    width: 100vw;
    max-width: 100vw;
  }
  .carrossel__trilho {
    display: flex;
    gap: var(--fig-e-5xl);
    list-style: none;
    margin: 0;
    padding: 0;
    will-change: transform;
  }
  /* O motion: a mola do design, medida na ficha carrossel-home. */
  .carrossel__trilho:not([data-animando='nao']) {
    transition: transform var(--dur-carrossel-home, 0.6s) var(--mola-carrossel-home, cubic-bezier(0.22, 1, 0.36, 1));
  }
  .carrossel__trilho[data-animando='nao'] { transition: none; }

  @media (prefers-reduced-motion: reduce) {
    .carrossel__trilho { transition: none !important; }
  }

  .carrossel__slide {
    flex: none;
    scroll-snap-align: center;
    transition: width var(--dur-carrossel-home, 0.6s) var(--mola-carrossel-home, ease);
    width: min(675px, 74vw);
  }
  .carrossel__slide[data-ativo] { width: min(817px, 90vw); }

  /* Peça lateral: 451px de altura contra os 545px do card ativo, e o véu
     preto de 20% que o design usa para empurrá-la para trás. */
  .carrossel__foto {
    display: block;
    border-radius: var(--fig-raio-sm);
    overflow: clip;
    position: relative;
  }
  .carrossel__foto::after {
    content: '';
    position: absolute;
    inset: 0;
    background: rgb(0 0 0 / 0.2);
    transition: opacity var(--dur-carrossel-home, 0.6s) var(--mola-carrossel-home, ease);
  }
  .carrossel__slide[data-ativo] .carrossel__foto::after { opacity: 0; }

  .carrossel__foto :global(img) {
    display: block;
    width: 100%;
    height: 469px;
    object-fit: cover;
    transition: height var(--dur-carrossel-home, 0.6s) var(--mola-carrossel-home, ease);
  }
  .carrossel__slide[data-ativo] .carrossel__foto :global(img) { height: 545px; }

  .carrossel__bolinhas {
    display: flex;
    gap: 13px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .carrossel__bolinha {
    background: var(--fig-primaria-clara);
    border: 0;
    border-radius: var(--fig-raio-pill);
    cursor: pointer;
    display: block;
    height: 15px;
    padding: 0;
    width: 15px;
  }
  .carrossel__bolinha[data-ativo] { background: var(--fig-primaria-ativa); }
  .carrossel__bolinha:focus-visible {
    outline: 2px solid var(--fig-primaria-ativa);
    outline-offset: 3px;
  }

  .carrossel__rodape {
    align-items: center;
    display: flex;
    gap: var(--fig-e-xs);
    justify-content: center;
  }
  .carrossel__seta {
    background: none;
    border: 0;
    color: var(--fig-tinta);
    cursor: pointer;
    display: grid;
    padding: var(--fig-e-xs);
    place-items: center;
    transition: transform var(--dur-carrossel-home, 0.6s) var(--mola-carrossel-home, ease);
  }
  .carrossel__seta:hover { transform: scale(1.1); }
  .carrossel__seta:focus-visible {
    outline: 2px solid var(--fig-primaria-ativa);
    outline-offset: 2px;
  }

  .carrossel__legenda {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0;
    margin: 0;
    text-align: center;
    width: 537px;
    max-width: 60vw;
  }
  .carrossel__titulo {
    color: #262626;
    font: var(--fig-peso-normal) 48px / 1.2 var(--fig-fonte-display);
  }
  .carrossel__local {
    color: #525252;
    font: var(--fig-peso-normal) 30px / 1.2 var(--fig-fonte-corpo);
  }

  @media (max-width: 1199.98px) {
    .carrossel__foto :global(img) { height: 320px; }
    .carrossel__slide[data-ativo] .carrossel__foto :global(img) { height: 400px; }
    .carrossel__trilho { gap: var(--fig-e-2xl); }
    .carrossel__titulo { font-size: 34px; }
    .carrossel__local { font-size: 20px; }
  }
  @media (max-width: 809.98px) {
    .carrossel__foto :global(img),
    .carrossel__slide[data-ativo] .carrossel__foto :global(img) { height: 260px; }
    .carrossel__seta svg { width: 20px; height: 31px; }
    .carrossel__titulo { font-size: 26px; }
    .carrossel__local { font-size: 17px; }
  }

  /* Quem pediu menos movimento não ganha o crescimento do card nem o
     scroll suave — o carrossel continua navegável, só não anima. */
  @media (prefers-reduced-motion: reduce) {
    .carrossel__foto :global(img),
    .carrossel__foto::after,
    .carrossel__seta { transition: none; }
  }
</style>
