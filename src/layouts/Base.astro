---
import '~/styles/fontes.css';
import '~/styles/tokens.css';
/* Os tokens do Figma entram DEPOIS dos antigos: onde os dois falam da mesma
   coisa, o design manda. Ver docs/PLANO-FIGMA.md. */
import '~/styles/tokens.figma.css';
/* As 17 molas do Framer, viradas em linear() nativo. Gerado; ver
   tools/mola-para-css.mjs. */
import '~/styles/motion.css';
import '~/styles/revela.css';
import '~/styles/base.css';

import Seo from '~/components/Seo.astro';
import JsonLd from '~/components/JsonLd.astro';
import AvisoCookies from '~/components/AvisoCookies.astro';
import { site } from '~/lib/site';

interface Props {
  titulo: string;
  descricao: string;
  imagem?: string;
  tipo?: 'website' | 'article';
  publicadoEm?: Date;
  atualizadoEm?: Date;
  autor?: string;
  noindex?: boolean;
}

const props = Astro.props;

/*
  Medição: os scripts NÃO são injetados aqui.

  Antes o GA4 e o Clarity entravam direto no HTML se as variáveis tivessem
  valor — sem perguntar nada, o que a LGPD não permite para cookie de
  estatística. Agora as chaves só são passadas ao cliente, e quem cria as
  tags é `lib/consentimento.ts`, depois do aceite no aviso de cookies.

  Sem nenhuma das duas configuradas não há o que consentir, e o aviso nem
  aparece — que é o estado de hoje, e o que a Política de Cookies afirma.
*/
const ga4 = import.meta.env.PUBLIC_GA4_ID;
const clarity = import.meta.env.PUBLIC_CLARITY_ID;
const temMedicao = Boolean(ga4 || clarity);
---

<!doctype html>
<html lang={site.idioma}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <!--
      A fonte do corpo entra no caminho crítico; as demais podem esperar.
      Este é o subset latin da Mulish (U+0000-00FF cobre o pt-BR), o mesmo
      arquivo que o Framer servia. O caminho anterior apontava para um nome
      do Google Fonts que não existe em disco e dava 404 — preload de arquivo
      inexistente é pior que preload nenhum: custa uma requisição e ainda
      avisa o navegador que a fonte é urgente.
    -->
    <link
      rel="preload"
      href="/fontes/gstatic/mulish/v18/1Ptvg83HX_SGhgqk3wot.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#fbf7f4" />

    <Seo {...props} />

    {/*
      LocalBusiness em TODA página, com endereço e área atendida. O site não
      tinha nenhum dado estruturado, e sem cidade associada não concorre por
      "arquitetura Maringá" — que a pesquisa de SEO apontou como a única busca
      que ele tem chance real de ganhar.
    */}
    <JsonLd tipo="negocio" />
  </head>

  <body>
    <a class="pular-conteudo" href="#conteudo">Pular para o conteúdo</a>

    <slot name="cabecalho" />

    <main id="conteudo">
      <slot />
    </main>

    <slot name="rodape" />

    <AvisoCookies ativo={temMedicao} />

    {/* As chaves viajam num data-* para o script abaixo, que é empacotado
        pelo Astro e por isso pode importar `lib/consentimento`. */}
    {
      temMedicao && (
        <span hidden data-medicao data-ga4={ga4 ?? ''} data-clarity={clarity ?? ''} />
      )
    }

    <script>
      import { lerEscolha, gravarEscolha, ligarMedicao } from '~/lib/consentimento';

      const dados = document.querySelector<HTMLElement>('[data-medicao]');
      const aviso = document.querySelector<HTMLElement>('[data-aviso-cookies]');

      if (dados) {
        const ga4 = dados.dataset.ga4 || undefined;
        const clarity = dados.dataset.clarity || undefined;
        const escolha = lerEscolha();

        if (escolha === 'aceito') {
          ligarMedicao(ga4, clarity);
        } else if (escolha === null && aviso) {
          /* Só aparece para quem ainda não escolheu. */
          aviso.hidden = false;
        }

        aviso?.querySelector('[data-aceitar]')?.addEventListener('click', () => {
          gravarEscolha('aceito');
          aviso.hidden = true;
          ligarMedicao(ga4, clarity);
        });
        aviso?.querySelector('[data-recusar]')?.addEventListener('click', () => {
          gravarEscolha('recusado');
          aviso.hidden = true;
        });
      }
    </script>
  </body>
</html>
