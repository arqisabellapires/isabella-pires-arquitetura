---
/**
 * Projetos — reconstruída contra o Figma (node 1:762), medidas em
 * `_figma/projetos-lista-medidas.json`.
 *
 * O card estava invertido: o site punha a foto em cima e o texto abaixo. No
 * design a **foto é o fundo** — 557px no primeiro card, 450px nos demais —
 * com véu escuro por cima e o texto posicionado dentro dela. É o que dá o
 * peso editorial da página.
 *
 * Os filtros de categoria não existiam. Existem agora e filtram de verdade,
 * sem JavaScript: cada pastilha é um <label> de um <input type=radio>
 * escondido, e uma regra por categoria (gerada no frontmatter, porque
 * depende do conteúdo) esconde os cards que não pertencem à marcada.
 *
 * As categorias são as REAIS das coleções (Residencial, Comercial,
 * Interiores), não as do Figma — o design listava "Especializado", que não
 * corresponde a nenhum projeto.
 */
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '~/layouts/Base.astro';
import Cabecalho from '~/components/Cabecalho.astro';
import Rodape from '~/components/Rodape.astro';
import Wordmark from '~/components/Wordmark.astro';
import Migalhas from '~/components/Migalhas.astro';

const projetos = (await getCollection('projetos', ({ data }) => data.publicado !== false)).sort(
  (a, b) => a.data.ordem - b.data.ordem,
);

/* As categorias que de fato existem, na ordem em que aparecem. */
const categorias = [...new Set(projetos.map((p) => p.data.categoria))];

/* Uma regra por categoria: com o rádio daquela categoria marcado, some com
   todo card que não a tenha. Escrito aqui porque depende do conteúdo. */
const regrasFiltro = categorias
  .map((c) => {
    const id = `cat-${c.toLowerCase()}`;
    return [
      `#${id}:checked ~ .lista .card:not([data-categoria='${c}']) { display: none; }`,
      `#${id}:checked ~ .filtros [for='${id}'] { background: var(--fig-primaria-ativa); color: var(--fig-cinza-50); }`,
      `#${id}:checked ~ .filtros [for='cat-todos'] { background: #fff; color: var(--fig-primaria-ativa); }`,
    ].join('\n');
  })
  .join('\n');
---

<Base
  titulo="Projetos"
  descricao="Projetos de arquitetura e interiores por Isabella Pires: residenciais, comerciais e reformas em Maringá."
>
  <Cabecalho slot="cabecalho" />

  <header class="cabeca">
    <div class="cabeca__interno">
      <Migalhas itens={[{ rotulo: 'Início', href: '/' }, { rotulo: 'Projetos' }]} />
      <h1 class="cabeca__titulo">Projetos</h1>
    </div>
    <img class="cabeca__selo" src="/imagens/figma/selo-marca.webp" alt="" width="328" height="328" loading="lazy" />
  </header>

  <div class="conteudo">
    <style set:html={regrasFiltro}></style>
    {/* Os rádios vivem AQUI, irmãos da lista: é isso que faz o seletor `~`
        alcançar os cards. Dentro de um <fieldset> eles não alcançariam. */}
    <input class="visualmente-oculto" type="radio" name="categoria" id="cat-todos" checked />
    {categorias.map((c) => (
      <input class="visualmente-oculto" type="radio" name="categoria" id={`cat-${c.toLowerCase()}`} />
    ))}

    <div class="filtros" role="group" aria-label="Filtrar projetos por categoria">
      <label class="filtro" for="cat-todos">Todos</label>
      {categorias.map((c) => (
        <label class="filtro" for={`cat-${c.toLowerCase()}`}>{c}</label>
      ))}
    </div>

    <ul class="lista" data-revela-filhos>
      {projetos.map((p, i) => (
        <li class:list={['card', i === 0 && 'card--destaque']} data-categoria={p.data.categoria} data-revela>
          <a href={`/projetos/${p.id}`}>
            <Image
              class="card__foto"
              src={p.data.capa}
              alt={p.data.capaAlt}
              widths={[900, 1624]}
              sizes="(min-width: 1200px) 1624px, 94vw"
              loading={i === 0 ? 'eager' : 'lazy'}
            />
            {/* Duas colunas sobre a foto, como no Figma (1:789/1:790): o
                nome grande à esquerda, e o resumo com o botão à direita. A
                etiqueta de categoria fica solta no alto à esquerda. */}
            <p class="card__tag">{p.data.categoria}</p>
            <div class="card__texto">
              <h2 class="card__titulo">{p.data.titulo}</h2>
              <div class="card__coluna">
                <p class="card__resumo">{p.data.resumo}</p>
                <span class="card__cta">Ver projeto</span>
              </div>
            </div>
          </a>
        </li>
      ))}
    </ul>
  </div>

  <div slot="rodape">
    <Wordmark />
    <Rodape />
  </div>
</Base>

<style>
  .cabeca {
    align-items: flex-start;
    border-bottom: 1px solid var(--fig-primaria-ativa);
    display: flex;
    justify-content: space-between;
    padding: var(--fig-e-4xl) var(--fig-margem-interna);
  }
  .cabeca__interno { display: flex; flex-direction: column; gap: var(--fig-e-3xl); }
  .cabeca__titulo {
    color: var(--fig-primaria-ativa);
    font: var(--fig-peso-semi) var(--fig-f-titulo-pagina) / 1.1 var(--fig-fonte-corpo);
    margin: 0;
  }
  .cabeca__selo { flex: none; height: auto; max-width: 328px; opacity: 0.9; width: 20vw; }

  .conteudo {
    margin-inline: auto;
    max-width: var(--fig-largura-canvas);
    padding: var(--fig-e-2xl) var(--fig-margem-interna) var(--fig-e-5xl);
  }

  /* ─── Filtros ─────────────────────────────────────────────
     Pastilhas de raio 8: a ativa é sólida marrom, as outras têm
     contorno de 1px. Node 1:778. */
  .filtros {
    display: flex;
    flex-wrap: wrap;
    gap: var(--fig-e-md);
    margin: 0 0 var(--fig-e-2xl);
    padding: 0;
  }
  .visualmente-oculto {
    clip-path: inset(50%);
    height: 1px;
    overflow: hidden;
    position: absolute;
    white-space: nowrap;
    width: 1px;
  }
  .filtro {
    background: #fff;
    cursor: pointer;
    border: 1px solid var(--fig-primaria-ativa);
    border-radius: var(--fig-raio-sm);
    color: var(--fig-primaria-ativa);
    font: var(--fig-peso-semi) var(--fig-f-corpo) / 1.2 var(--fig-fonte-corpo);
    padding: var(--fig-e-sm) var(--fig-e-lg);
    text-decoration: none;
    transition: background var(--dur-filtros-categoria-artigos) var(--mola-filtros-categoria-artigos),
                color var(--dur-filtros-categoria-artigos) var(--mola-filtros-categoria-artigos);
  }
  .filtro:hover { background: var(--fig-fundo-pessego); color: var(--fig-primaria-ativa); }
  /* O rótulo ativo é sólido: fundo marrom, texto claro. Sem isto o hover
     pinta o fundo por cima e o texto some — foi o que aconteceu. */
  #cat-todos:checked ~ .filtros [for='cat-todos']:hover {
    background: var(--fig-primaria-ativa);
    color: var(--fig-cinza-50);
  }
  /* O rádio checado pinta o seu rótulo — e é ele quem esconde os cards
     que não são da categoria. Filtragem real, sem uma linha de JavaScript. */
  #cat-todos:checked ~ .filtros [for='cat-todos'] { background: var(--fig-primaria-ativa); color: var(--fig-cinza-50); }
  input[name='categoria']:focus-visible ~ .filtros .filtro { outline: 2px solid transparent; }

  /* ─── Cards ───────────────────────────────────────────────*/
  .lista {
    display: flex;
    flex-direction: column;
    gap: var(--fig-e-xl);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .card a {
    border-radius: 33px;
    color: #fff;
    display: block;
    overflow: clip;
    position: relative;
    text-decoration: none;
  }
  .card :global(.card__foto) {
    display: block;
    height: 450px;
    object-fit: cover;
    transition: transform var(--dur-card-projeto-hover) var(--mola-card-projeto-hover);
    width: 100%;
  }
  .card--destaque :global(.card__foto) { height: 557px; }
  .card a:hover :global(.card__foto),
  .card a:focus-visible :global(.card__foto) { transform: scale(1.03); }

  /* O véu é mais forte nos cards menores: o design usa .39 no primeiro e
     .75 nos demais, porque neles o texto compete com mais imagem. */
  .card a::after {
    content: '';
    position: absolute;
    inset: 0;
    background: rgb(0 0 0 / 0.6);
  }
  .card--destaque a::after { background: rgb(0 0 0 / 0.39); }

  /* O Figma posiciona tudo em absoluto sobre a foto: nome em left:196, o
     resumo em left:1016 com 544 de largura. Em grade de duas colunas isso
     vira proporção em vez de px fixo, e continua valendo em telas menores. */
  .card__texto {
    align-items: center;
    display: grid;
    gap: clamp(var(--fig-e-2xl), 6vw, 120px);
    grid-template-columns: minmax(0, 1fr) minmax(0, 544px);
    inset: 0 clamp(var(--fig-e-lg), 5vw, 68px);
    padding-inline: clamp(0px, 4vw, 128px);
    position: absolute;
    z-index: 1;
  }
  .card__coluna { display: flex; flex-direction: column; align-items: flex-start; text-align: left; }
  /* Véu translúcido não garante contraste: sobre foto clara o branco
     sumia. Fundo sólido resolve e continua discreto. */
  /* Etiqueta: no design é branca a 76% com borda escura, no alto à
     esquerda (left:68, top:53), fora do bloco de texto. */
  .card__tag {
    background: rgb(255 255 255 / 0.88);
    border: 1px solid var(--fig-primaria-ativa);
    border-radius: var(--fig-raio-sm);
    color: var(--fig-primaria-ativa);
    font: var(--fig-peso-semi) var(--fig-t-meta) / 1.2 var(--fig-fonte-ui);
    left: clamp(var(--fig-e-lg), 5vw, 68px);
    margin: 0;
    padding: var(--fig-e-xs) var(--fig-e-lg);
    position: absolute;
    top: clamp(var(--fig-e-lg), 4vw, 53px);
    z-index: 2;
  }
  .card__titulo {
    color: #fff;
    font: var(--fig-peso-medio) var(--fig-f-card-titulo) / 1.05 var(--fig-fonte-ui);
    margin: 0;
  }
  /* 21px no Figma e no Framer. */
  .card__resumo {
    color: rgb(255 255 255 / 0.92);
    font: var(--fig-peso-semi) 21px / 1.45 var(--fig-fonte-corpo);
    margin: 0 0 var(--fig-e-lg);
  }
  /* No design é um botão claro preenchido (1:791), não um link sublinhado. */
  .card__cta {
    background: var(--fig-cinza-50);
    border-radius: var(--fig-raio-sm);
    color: var(--fig-primaria-ativa);
    font: var(--fig-peso-forte) var(--fig-t-corpo) / 1.2 var(--fig-fonte-corpo);
    padding: var(--fig-e-sm) var(--fig-e-lg);
  }


  @media (max-width: 1199.98px) {
    .cabeca__selo { display: none; }
    .card :global(.card__foto),
    .card--destaque :global(.card__foto) { height: 380px; }
    /* Uma coluna só: as duas do design não cabem, e o resumo espremido
       ficaria ilegível. O nome fica em cima, o resto embaixo — ancorados na
       base, para não passarem por baixo da etiqueta de categoria. */
    .card__texto {
      align-content: end;
      grid-template-columns: minmax(0, 1fr);
      gap: var(--fig-e-sm);
      inset: auto var(--fig-e-lg) var(--fig-e-lg);
      padding: 0;
    }
  }
  @media (max-width: 809.98px) {
    /* Card mais alto no celular: o resumo inteiro sobre a foto não cabe em
       380px, e cortar texto é pior que crescer o card. */
    /* No celular o texto deixa de ficar sobre a foto: sobreposto, ou ele
       vaza para fora do card, ou espreme a foto até virar tarja. Foto em
       cima, texto embaixo sobre o fundo escuro do card. */
    .card :global(.card__foto),
    .card--destaque :global(.card__foto) { height: 260px; }
    /* Fora da foto o véu não alcança, e o texto branco ficava sobre o
       fundo claro da página. O card ganha fundo escuro próprio. */
    .card > a {
      display: block;
      background: var(--fig-fundo-escuro);
      border-radius: var(--fig-raio-xl);
      overflow: clip;
    }
    .card a::after { inset: 0 0 auto; height: 260px; }
    .card__texto {
      inset: auto;
      position: static;
      gap: var(--fig-e-sm);
      padding: var(--fig-e-lg);
    }
    .card__tag { position: static; margin: var(--fig-e-lg) 0 0 var(--fig-e-lg); display: inline-block; }
    .card__resumo { font-size: var(--fig-t-corpo-p); }
    /* No celular a etiqueta desce para junto do nome: presa no alto, ela
       cruzava por cima do título quando o resumo empurrava o bloco para
       cima. Fica acima da pilha, alinhada com ela. */
    .card__tag {
      bottom: auto;
      left: var(--fig-e-lg);
      top: var(--fig-e-lg);
    }
    /* O bloco começa abaixo da etiqueta: `inset` só na base deixava o nome
       subir até a altura dela quando o resumo era longo. */
    .card__texto {
      inset: calc(var(--fig-e-lg) + 52px) var(--fig-e-lg) var(--fig-e-lg);
      align-content: end;
    }
    .card :global(.card__foto),
    .card--destaque :global(.card__foto) { height: 320px; }
    .card__texto { left: var(--fig-e-lg); right: var(--fig-e-lg); }
  }
</style>
