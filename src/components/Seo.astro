---
import { site } from '~/lib/site';

interface Props {
  titulo: string;
  descricao: string;
  imagem?: string;
  tipo?: 'website' | 'article';
  publicadoEm?: Date;
  atualizadoEm?: Date;
  autor?: string;
  noindex?: boolean;
}

const {
  titulo,
  descricao,
  imagem = site.imagemPadrao,
  tipo = 'website',
  publicadoEm,
  atualizadoEm,
  autor,
  noindex = false,
} = Astro.props;

const canonica = new URL(Astro.url.pathname, site.url).href.replace(/(.+)\/$/, '$1');
const imagemAbsoluta = new URL(imagem, site.url).href;
// Evita "Isabella Pires Arquitetura | Isabella Pires Arquitetura" na home.
const tituloCompleto = titulo === site.nome ? titulo : `${titulo} | ${site.nome}`;

/*
  O JSON-LD saiu daqui para o JsonLd.astro.

  Este componente emitia um BlogPosting por conta própria, e o JsonLd.astro
  emite Article para a mesma página — dois blocos concorrentes descrevendo o
  mesmo conteúdo, que é ambiguidade que o Google não tem como resolver. Agora
  existe uma fonte só, e ela tem endereço e área atendida.
*/

---

<title>{tituloCompleto}</title>
<meta name="description" content={descricao} />
<link rel="canonical" href={canonica} />
{noindex && <meta name="robots" content="noindex, nofollow" />}

<meta property="og:type" content={tipo} />
<meta property="og:title" content={tituloCompleto} />
<meta property="og:description" content={descricao} />
<meta property="og:url" content={canonica} />
<meta property="og:image" content={imagemAbsoluta} />
<meta property="og:site_name" content={site.nome} />
<meta property="og:locale" content={site.locale} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={tituloCompleto} />
<meta name="twitter:description" content={descricao} />
<meta name="twitter:image" content={imagemAbsoluta} />

