---
/**
 * Página de artigo. É o primeiro item da Fase 2 da spec por um motivo
 * concreto: **20 dos 25 artigos estão em 302 provisório** desde a virada do
 * domínio, e esta rota é o que devolve conteúdo real a essas URLs.
 *
 * O molde saiu de medir as 5 capturas de artigo, que compartilham layout:
 * data 16px/400 #999, título, corpo 16px/25.6 Mulish #666, headings Inter.
 * Detalhe em src/styles/artigo.css.
 */
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '~/layouts/Base.astro';
import Cabecalho from '~/components/Cabecalho.astro';
import Rodape from '~/components/Rodape.astro';
import Wordmark from '~/components/Wordmark.astro';
import Migalhas from '~/components/Migalhas.astro';
import JsonLd from '~/components/JsonLd.astro';
import { site } from '~/lib/site';
import '~/styles/artigo.css';

export async function getStaticPaths() {
  const artigos = await getCollection('artigos', ({ data }) => data.publicado !== false);
  return artigos.map((artigo) => ({ params: { slug: artigo.id }, props: { artigo } }));
}

const { artigo } = Astro.props;
const { Content } = await render(artigo);
const d = artigo.data;

const dataLegivel = (valor: Date) =>
  new Intl.DateTimeFormat('pt-BR', { day: '2-digit', month: 'short', year: 'numeric' }).format(valor);

/*
  O título e o resumo do artigo são a fonte do title/description. Não se
  inventa copy: se o frontmatter trouxer seoTitulo/seoDescricao, mandam eles.
*/
const titulo = d.seoTitulo ?? d.titulo;
const descricao = d.seoDescricao ?? d.resumo;
---

<Base
  titulo={titulo}
  descricao={descricao}
  tipo="article"
  publicadoEm={d.publicadoEm}
  atualizadoEm={d.atualizadoEm}
  autor={d.autor}
>
  <Cabecalho slot="cabecalho" />

  {/* Article + BreadcrumbList, além do LocalBusiness que o Base já injeta. */}
  <JsonLd
    tipo="artigo"
    titulo={d.titulo}
    descricao={descricao}
    publicadoEm={d.publicadoEm}
    atualizadoEm={d.atualizadoEm}
    autor={d.autor}
  />
  <JsonLd
    tipo="migalhas"
    migalhas={[
      { nome: 'Início', href: '/' },
      { nome: 'Blog', href: '/artigos' },
      { nome: d.titulo, href: `/artigos/${artigo.id}` },
    ]}
  />

  <article class="artigo">
    <Migalhas itens={[{ rotulo: 'Início', href: '/' }, { rotulo: 'Blog', href: '/artigos' }, { rotulo: d.titulo }]} />
    <p class="artigo-categoria">{d.categoria}</p>
    <p class="artigo-data">
      <time datetime={d.publicadoEm.toISOString()}>{dataLegivel(d.publicadoEm)}</time>
    </p>

    <h1 class="artigo-titulo">{d.titulo}</h1>

    <Image class="artigo-capa" src={d.capa} alt={d.capaAlt} widths={[390, 700, 875]} sizes="(min-width: 1200px) 875px, (min-width: 810px) 700px, 100vw" loading="eager" />

    <div class="artigo-corpo">
      <Content />
    </div>
  </article>

  <div slot="rodape">

    <Wordmark />

    <Rodape />

  </div>
</Base>

<style>
  /*
    O artigo é a ÚNICA tela sem desenho no Figma — o design tem detalhe de
    projeto, mas nenhum post individual. Então esta página é derivada: usa a
    mesma gramática do detalhe de projeto (mesma escala de título, mesmo
    corpo, mesmas cores) numa coluna de leitura. Nada aqui é inventado
    visualmente; é o sistema de tokens aplicado a um caso que o design não
    cobriu.
  */
  .artigo {
    margin-inline: auto;
    max-width: 875px;
    padding: var(--fig-e-4xl) var(--fig-margem-interna) var(--fig-secao-y);
  }
  .artigo-categoria {
    align-self: flex-start;
    background: #8d7252;
    border-radius: var(--fig-raio-xs);
    color: var(--fig-cinza-50);
    display: inline-block;
    font: var(--fig-peso-normal) var(--fig-t-meta) / 1.4 var(--fig-fonte-display);
    margin: var(--fig-e-2xl) 0 var(--fig-e-sm);
    padding: var(--fig-e-2xs) var(--fig-e-lg);
  }
  .artigo-data {
    color: var(--fig-texto-meta);
    font: var(--fig-peso-forte) var(--fig-t-meta) / 1.4 var(--fig-fonte-corpo);
    margin: 0 0 var(--fig-e-md);
  }
  .artigo-titulo {
    color: var(--fig-primaria-ativa);
    font: var(--fig-peso-semi) clamp(2rem, 1.2rem + 3vw, 3.75rem) / 1.1 var(--fig-fonte-corpo);
    margin: 0 0 var(--fig-e-2xl);
    text-wrap: balance;
  }
  .artigo :global(.artigo-capa) {
    border-radius: var(--fig-raio-xl);
    display: block;
    height: auto;
    margin-bottom: var(--fig-e-2xl);
    width: 100%;
  }

  .artigo-corpo :global(h2) {
    color: var(--fig-cinza-900);
    font: var(--fig-peso-semi) clamp(1.5rem, 1.1rem + 1.4vw, 2.25rem) / 1.2 var(--fig-fonte-corpo);
    margin: var(--fig-e-2xl) 0 var(--fig-e-md);
  }
  .artigo-corpo :global(h3) {
    color: var(--fig-cinza-900);
    font: var(--fig-peso-semi) clamp(1.25rem, 1rem + 0.9vw, 1.75rem) / 1.25 var(--fig-fonte-corpo);
    margin: var(--fig-e-xl) 0 var(--fig-e-sm);
  }
  .artigo-corpo :global(p),
  .artigo-corpo :global(li) {
    color: var(--fig-texto);
    font: var(--fig-peso-medio) clamp(1.0625rem, 0.98rem + 0.4vw, 1.25rem) / var(--fig-altura-solta) var(--fig-fonte-corpo);
  }
  .artigo-corpo :global(p) { margin: 0 0 var(--fig-e-md); }
  .artigo-corpo :global(ul),
  .artigo-corpo :global(ol) { margin: 0 0 var(--fig-e-md); padding-left: var(--fig-e-lg); }
  .artigo-corpo :global(li) { margin-bottom: var(--fig-e-2xs); }
  .artigo-corpo :global(strong) { color: var(--fig-cinza-900); font-weight: 800; }
  .artigo-corpo :global(a) { color: var(--fig-primaria-ativa); }
  .artigo-corpo :global(img) {
    border-radius: var(--fig-raio-lg);
    display: block;
    height: auto;
    margin: var(--fig-e-xl) 0;
    width: 100%;
  }
  .artigo-corpo :global(blockquote) {
    border-left: 6px solid #8d7252;
    color: var(--fig-primaria-media);
    font: italic var(--fig-peso-semi) var(--fig-f-corpo) / 1.5 var(--fig-fonte-corpo);
    margin: var(--fig-e-xl) 0;
    padding-left: var(--fig-e-md);
  }
</style>
