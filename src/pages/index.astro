---
/**
 * Home — reconstruída contra o Figma (node 1:176), medidas em
 * `_figma/home-medidas.json` e no bruto `_figma/home-design-context.json`.
 *
 * A versão anterior era uma simplificação: herói de fundo chapado, sem foto,
 * sem a caixa central, tudo em coluna de 1184px. O design é outro — herói de
 * 913px com foto e gradiente diagonal, caixa de 1344×592 com véu por cima, e
 * seções que alternam texto e imagem em 1560px de conteúdo.
 *
 * O texto continua vindo de `conteudo.ts` e das coleções: o Figma tem
 * placeholder do designer em alguns pontos, e copy não se inventa.
 *
 * Ordem das seções, como no Figma: herói · sobre · números · projetos ·
 * serviços · CTA com formulário · blog · wordmark · rodapé.
 */
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '~/layouts/Base.astro';
import Cabecalho from '~/components/Cabecalho.astro';
import Rodape from '~/components/Rodape.astro';
import Wordmark from '~/components/Wordmark.astro';
import RotuloSecao from '~/components/RotuloSecao.astro';
import CardArtigoHome from '~/components/artigos/CardArtigoHome.astro';
import CarrosselProjetos from '~/components/CarrosselProjetos.astro';
import AcordeaoServicos from '~/components/AcordeaoServicos.astro';
import Contato from '~/components/formularios/Contato.astro';
import { numerosHome } from '~/lib/conteudo';

const artigos = (await getCollection('artigos', ({ data }) => data.publicado !== false))
  .sort((a, b) => b.data.publicadoEm.valueOf() - a.data.publicadoEm.valueOf())
  .slice(0, 6);
/* O card da home não mostra tempo de leitura (o design não tem), então não
   há por que ler o corpo de cada artigo aqui. */

/* Sem `slice`: o carrossel mostra todos, e as peças vizinhas cortadas nas
   bordas só existem se houver o que cortar. */
const projetos = (await getCollection('projetos', ({ data }) => data.publicado !== false))
  .sort((a, b) => a.data.ordem - b.data.ordem);
---

<Base
  titulo="Isabella Pires Arquitetura"
  descricao="Arquitetura e interiores em Maringá: projetos residenciais, comerciais e reformas que traduzem quem você é."
>
  <Cabecalho slot="cabecalho" sobreHero />

  <section class="heroi">
    <img
      class="heroi__foto"
      src="/imagens/figma/home--image381.webp"
      alt=""
      width="1920"
      height="1152"
      fetchpriority="high"
    />
    <div class="heroi__caixa">
      <div class="heroi__conteudo">
        <h1 class="heroi__titulo">
          Espaços que refletem<br />quem você <em>realmente</em> é
        </h1>
        <p class="heroi__texto">
          Mais do que criar ambientes bonitos, nosso propósito é dar vida a espaços com alma.
          Do primeiro esboço ao acabamento final, tudo é pensado para refletir sua história
          e estilo de vida.
        </p>
        <p class="heroi__acoes">
          <a class="botao botao--claro" href="/contato">Entrar em contato</a>
          <a class="botao botao--caramelo" href="/projetos">Explorar Projetos</a>
        </p>
      </div>
    </div>
  </section>

  <section class="sobre" data-revela>
    <div class="sobre__texto">
      <RotuloSecao>Sobre nós</RotuloSecao>
      <h2 class="titulo-secao">Mais que Design,<br />Um Estilo de Vida.</h2>
      <p class="sobre__paragrafo">
        Nosso propósito é criar o incomum. Ambientes que emocionam, acolhem e refletem
        autenticidade, traduzindo não apenas estética e funcionalidade, mas também histórias,
        valores e modos de viver. Cada detalhe é pensado para unir beleza e praticidade,
        resultando em espaços que fazem sentido, acolhem quem chega e permanecem impactantes
        com o tempo.
      </p>
      <blockquote class="sobre__citacao">
        Acreditamos que cada espaço conta uma história — e a sua merece ser contada com
        cuidado, escuta e personalidade.
      </blockquote>
      <a class="ligacao" href="/sobre-nos">Saiba mais sobre quem somos</a>
    </div>
    <img
      class="sobre__foto"
      src="/imagens/figma/home--unsplash2-d4-laq-alb-da.webp"
      alt=""
      loading="lazy"
      width="705"
      height="637"
    />
  </section>

  <section class="numeros" aria-label="Nossos números" data-revela>
    <dl class="numeros__lista" data-revela-filhos>
      {numerosHome.map((n) => (
        <div class="numeros__item">
          <dt class="numeros__valor">{n.valor}</dt>
          <dd class="numeros__rotulo">{n.rotulo}</dd>
        </div>
      ))}
    </dl>
  </section>

  {/* "Histórias Recentes" — carrossel (node 1:223). O rótulo é "Serviços"
      no Figma, não "Projetos": o designer reaproveitou o rótulo da seção
      seguinte. Mantenho o do design; se estiver errado é texto, e texto é
      decisão do Gabriel. */}
  <section class="projetos" data-revela>
    <header class="secao__cabeca secao__cabeca--centro">
      <RotuloSecao>Serviços</RotuloSecao>
      <h2 class="titulo-secao">Histórias Recentes</h2>
    </header>
    <CarrosselProjetos projetos={projetos} />
  </section>

  {/* Acordeão horizontal (node 1:300): título à esquerda, botão
      "Solicitar Proposta" à direita alinhado com ele, painéis embaixo. */}
  <section class="servicos" data-revela>
    <header class="servicos__cabeca">
      <div class="secao__cabeca">
        <RotuloSecao>Serviços</RotuloSecao>
        <h2 class="titulo-secao">Serviços pensados<br />para você</h2>
      </div>
      <a class="botao botao--caramelo servicos__proposta" href="/contato">Solicitar Proposta</a>
    </header>
    <AcordeaoServicos />
  </section>

  {/* node 1:332 — duas colunas: cartão do formulário à esquerda (533px),
      texto à direita (705px), gap 104. Era título em cima e formulário
      largo embaixo; é o "form desproporcional" que o Gabriel apontou. */}
  <section class="cta" data-revela>
    <div class="cta__interno">
      <div class="cta__form"><Contato /></div>
      <div class="cta__texto">
        <RotuloSecao cor="secundaria">Entre em contato</RotuloSecao>
        <h2 class="titulo-secao cta__titulo">Vamos conversar sobre<br />seu próximo projeto?</h2>
        <p class="cta__apoio">
          Conte um pouco sobre o que você sonha para o seu espaço. Nossa equipe vai preparar
          uma proposta feita sob medida para você.
        </p>
      </div>
    </div>
  </section>

  {/* node 1:351 — texto à esquerda, carrossel de cards verticais à direita
      escorrendo para fora da borda. Era um bloco centrado com três cards
      horizontais largos embaixo. */}
  <section class="blog" data-revela>
    <div class="blog__texto">
      <RotuloSecao>Blog</RotuloSecao>
      <h2 class="titulo-secao blog__titulo">
        Arquitetura,<br />Design &amp; <em>Mercado</em>
      </h2>
      <p class="blog__apoio">Dicas e tendências para quem valoriza bons espaços.</p>
      <a class="botao botao--caramelo blog__acesso" href="/artigos">Acessar blog</a>
    </div>
    <ul class="blog__trilho">
      {artigos.map((artigo) => (
        <li class="blog__item">
          <CardArtigoHome artigo={artigo} />
        </li>
      ))}
    </ul>
  </section>

  <div slot="rodape">
    <Wordmark />
    <Rodape />
  </div>
</Base>

<style>
  /* ─── Herói ────────────────────────────────────────────────
     913px de altura, foto sangrando por trás com gradiente diagonal, e a
     caixa de texto com véu por cima. Tudo medido no node 1:177/1:180. */
  /* A caixa não é centrada: no Figma ela começa em y=223 de 913, ou seja,
     encostada no topo depois do menu. Alinhar ao topo com o padding do
     menu reproduz isso e continua valendo em telas mais baixas. */
  .heroi {
    position: relative;
    display: flex;
    align-items: flex-start;
    justify-content: center;
    min-height: 913px;
    overflow: clip;
    padding: 223px var(--fig-margem-interna) var(--fig-e-3xl);
  }
  .heroi__foto {
    position: absolute;
    inset: 0;
    height: 100%;
    width: 100%;
    object-fit: cover;
    z-index: -2;
  }
  .heroi::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--fig-gradiente-hero);
    z-index: -1;
  }
  .heroi__caixa {
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--fig-veu-hero);
    border-radius: var(--fig-raio-lg);
    max-width: 1344px;
    min-height: 592px;
    padding: var(--fig-e-3xl) var(--fig-margem-interna);
    width: 100%;
  }
  .heroi__conteudo {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--fig-e-3xl);
    max-width: 882px;
    text-align: center;
  }
  .heroi__titulo {
    margin: 0;
    color: #fff;
    font: var(--fig-peso-forte) var(--fig-f-hero) / var(--fig-altura-titulo) var(--fig-fonte-corpo);
  }
  /* O design pinta só a palavra "realmente" em #eee. */
  .heroi__titulo em { color: var(--fig-cinza-50); font-style: normal; }
  /* 24px no Figma; a escala de corpo parava em 20 e o texto ficava miúdo
     dentro da caixa. */
  .heroi__texto {
    margin: calc(var(--fig-e-xl) - var(--fig-e-3xl)) 0 0;
    color: #eaeaea;
    font: var(--fig-peso-semi) clamp(1.0625rem, 0.9rem + 0.7vw, 1.5rem) / 1.4 var(--fig-fonte-corpo);
  }
  .heroi__acoes {
    display: flex;
    gap: var(--fig-e-xl);
    margin: 0;
    width: 100%;
  }
  .botao {
    border-radius: var(--fig-raio-sm);
    flex: 1;
    font: var(--fig-peso-forte) var(--fig-f-rotulo) / 1 var(--fig-fonte-corpo);
    letter-spacing: var(--fig-tracking-botao);
    padding: var(--fig-e-md) var(--fig-e-lg);
    text-align: center;
    text-decoration: none;
    transition: transform var(--dur-cta-antes-do-rodape) var(--mola-cta-antes-do-rodape);
  }
  .botao:hover { transform: translateY(-2px); }
  .botao--claro { background: var(--fig-cinza-50); color: var(--fig-primaria-ativa); }
  .botao--caramelo { background: var(--fig-primaria-clara); color: #fff; }

  /* ─── Blocos gerais ───────────────────────────────────────*/
  .titulo-secao {
    margin: 0;
    color: var(--fig-tinta);
    font: var(--fig-peso-forte) var(--fig-f-titulo-secao) / 1.21 var(--fig-fonte-corpo);
    text-wrap: balance;
  }
  .secao__cabeca {
    display: flex;
    flex-direction: column;
    gap: var(--fig-e-sm);
    margin-bottom: var(--fig-e-3xl);
  }
  .secao__apoio {
    margin: 0;
    color: var(--fig-texto);
    font: var(--fig-peso-medio) var(--fig-t-corpo-p) / var(--fig-altura-solta) var(--fig-fonte-corpo);
  }
  .ligacao {
    align-self: flex-start;
    border-bottom: 1px solid currentColor;
    color: var(--fig-primaria-ativa);
    display: inline-block;
    font: var(--fig-peso-forte) var(--fig-t-corpo-p) / 1.2 var(--fig-fonte-corpo);
    text-decoration: none;
    /* A ficha `ver-todas-postagens` mede spring damping 60 / stiffness 500. */
    transition: transform var(--dur-ver-todas-postagens) var(--mola-ver-todas-postagens);
  }
  .ligacao:hover { transform: translateX(4px); }

  /* `.projetos` e `.blog` ficam de fora: os dois têm trilho que sangra até
     a borda da tela, e um container centrado cortaria justamente o efeito. */
  .sobre,
  .servicos {
    margin-inline: auto;
    max-width: var(--fig-largura-conteudo);
    padding-inline: var(--fig-margem-interna);
  }
  .projetos { margin-inline: auto; max-width: var(--fig-largura-canvas); }

  /* ─── Sobre ───────────────────────────────────────────────*/
  .sobre {
    display: flex;
    align-items: center;
    gap: var(--fig-e-3xl);
    justify-content: space-between;
    padding-block: var(--fig-secao-y);
  }
  .sobre__texto {
    display: flex;
    flex-direction: column;
    gap: var(--fig-e-lg);
    max-width: 705px;
  }
  .sobre__paragrafo {
    margin: 0;
    color: rgb(48 48 48 / 0.8);
    font: var(--fig-peso-normal) var(--fig-t-corpo-p) / var(--fig-altura-solta) var(--fig-fonte-corpo);
    max-width: 586px;
  }
  /* O design usa uma barra de 6px com raio 100 à esquerda da citação. */
  .sobre__citacao {
    border-left: 6px solid var(--fig-primaria-ativa);
    border-radius: var(--fig-raio-pill);
    color: var(--fig-primaria-media);
    font: italic var(--fig-peso-semi) var(--fig-t-corpo) / 1.5 var(--fig-fonte-corpo);
    margin: 0;
    max-width: 586px;
    padding-left: var(--fig-e-md);
  }
  .sobre__foto {
    border-radius: var(--fig-raio-md);
    flex: none;
    height: auto;
    max-width: 46%;
    object-fit: cover;
  }

  /* ─── Números ─────────────────────────────────────────────
     Faberge 66px sobre o valor, 28px no rótulo — node 1:209. */
  .numeros { padding: var(--fig-e-3xl) var(--fig-margem-interna); }
  .numeros__lista {
    display: grid;
    gap: var(--fig-e-3xl);
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    margin: 0 auto;
    max-width: var(--fig-largura-conteudo);
  }
  .numeros__item { display: flex; align-items: flex-start; gap: var(--fig-e-xl); }
  .numeros__valor {
    color: var(--fig-primaria-ativa);
    font: var(--fig-peso-normal) var(--fig-f-numero) / var(--fig-altura-titulo) var(--fig-fonte-display);
  }
  .numeros__rotulo {
    color: var(--fig-primaria-ativa);
    font: var(--fig-peso-normal) var(--fig-f-rotulo) / var(--fig-altura-titulo) var(--fig-fonte-display);
    margin: 0;
  }

  /* ─── Histórias Recentes (carrossel) ─────────────────────
     O trilho sangra até a borda da tela — por isso a seção não recebe
     `padding-inline`, só o cabeçalho. O layout está em CarrosselProjetos. */
  .projetos {
    display: flex;
    flex-direction: column;
    gap: var(--fig-e-3xl);
    padding-block: var(--fig-secao-y);
  }
  .secao__cabeca--centro {
    align-items: center;
    padding-inline: var(--fig-margem-interna);
    text-align: center;
  }

  /* ─── Serviços (acordeão) ─────────────────────────────────
     Cabeçalho em duas pontas: título à esquerda, "Solicitar Proposta" à
     direita alinhado ao topo do bloco de texto (node 1:301). */
  .servicos {
    display: flex;
    flex-direction: column;
    gap: var(--fig-e-3xl);
    padding-block: var(--fig-e-5xl) var(--fig-e-8xl);
  }
  .servicos__cabeca {
    align-items: center;
    display: flex;
    gap: var(--fig-e-2xl);
    justify-content: space-between;
  }
  .servicos__proposta { flex: none; }

  /* ─── CTA com formulário ──────────────────────────────────
     Duas colunas do node 1:333: cartão de 533px, texto de 705px, gap 104.
     A faixa é de largura total; o par é que se centra dentro dela. */
  .cta {
    background: var(--fig-veu-cta);
    padding: var(--fig-e-6xl) var(--fig-margem-interna) var(--fig-e-8xl);
  }
  .cta__interno {
    align-items: start;
    display: flex;
    gap: var(--fig-e-7xl);
    justify-content: center;
    margin-inline: auto;
    max-width: var(--fig-largura-conteudo);
  }
  .cta__form { flex: none; width: 533px; }
  .cta__texto {
    display: flex;
    flex-direction: column;
    gap: var(--fig-e-sm);
    max-width: 705px;
    padding-block: var(--fig-e-lg);
  }
  /* O título do CTA é Faberge no design (não Mulish, como as outras
     seções) — node 1:349, 71px. */
  .cta__titulo {
    font-family: var(--fig-fonte-display);
    margin-bottom: var(--fig-e-lg);
  }
  .cta__apoio {
    color: rgb(48 48 48 / 0.8);
    font: var(--fig-peso-semi) var(--fig-t-corpo) / var(--fig-altura-corpo) var(--fig-fonte-corpo);
    margin: 0;
    max-width: 586px;
  }

  /* ─── Blog ────────────────────────────────────────────────
     Texto à esquerda, fileira de cards verticais à direita escorrendo para
     fora da borda (node 1:352). Como o trilho vaza para a direita, a seção
     abre o padding só à esquerda. */
  .blog {
    align-items: center;
    display: flex;
    gap: var(--fig-e-2xl);
    padding: var(--fig-secao-y) 0 var(--fig-secao-y) var(--fig-margem-lateral);
  }
  .blog__texto {
    display: flex;
    flex: none;
    flex-direction: column;
    gap: var(--fig-e-lg);
    width: 415px;
  }
  /* Faberge 50px no design, e "Mercado" em caramelo — o <em> carrega a cor,
     não itálico. */
  .blog__titulo {
    font: var(--fig-peso-normal) 50px / 1.214 var(--fig-fonte-display);
    margin: 0;
  }
  .blog__titulo em { color: #8d7252; font-style: normal; }
  .blog__apoio {
    color: var(--fig-cinza-900);
    font: var(--fig-peso-medio) var(--fig-t-corpo) / 1.214 var(--fig-fonte-corpo);
    margin: 0;
  }
  .blog__acesso { align-self: start; margin-top: var(--fig-e-md); }

  .blog__trilho {
    display: flex;
    gap: 50px;
    list-style: none;
    margin: 0;
    min-width: 0;
    overflow-x: auto;
    padding: var(--fig-e-md) var(--fig-margem-interna) var(--fig-e-md) 0;
    scroll-snap-type: x proximate;
    scrollbar-width: none;
  }
  .blog__trilho::-webkit-scrollbar { display: none; }
  .blog__item { flex: none; scroll-snap-align: start; }

  /* ─── Aparição ao rolar ───────────────────────────────────
     A ficha `reveal-entrada` mede spring bounce 0.2 / 0.8s, com filhos
     escalonados em 0.2/0.4/0.6s. Aqui vai a versão de seção. */

  @media (max-width: 1199.98px) {
    .heroi { min-height: 640px; }
    .sobre { flex-direction: column; align-items: stretch; }
    .sobre__foto { max-width: 100%; }
    /* Cabeçalho do acordeão empilha: o botão não cabe ao lado de um título
       de 70px em telas médias. */
    .servicos__cabeca { align-items: flex-start; flex-direction: column; gap: var(--fig-e-lg); }
    .cta__interno { flex-direction: column; align-items: center; gap: var(--fig-e-3xl); }
    .cta__form { width: min(533px, 100%); }
    .cta__texto { max-width: 533px; }
    .blog { flex-direction: column; align-items: stretch; padding-inline: var(--fig-margem-interna) 0; }
    .blog__texto { width: auto; }
    .blog__titulo { font-size: 38px; }
  }
  @media (max-width: 809.98px) {
    .heroi { min-height: 560px; padding-inline: var(--fig-e-md); }
    .heroi__caixa { padding: var(--fig-e-xl) var(--fig-e-md); min-height: 0; }
    .heroi__acoes { flex-direction: column; }
    .numeros__item { flex-direction: column; gap: var(--fig-e-xs); }
    .blog__titulo { font-size: 30px; }
    .servicos { padding-block: var(--fig-e-3xl) var(--fig-e-4xl); }
  }
</style>
